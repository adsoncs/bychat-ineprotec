  updatedAt     DateTime  @updatedAt

  @@unique([integrationId, formId])
  @@index([formId])
  @@index([defaultTeamId])
  @@map("bychat_meta_forms")
}

model MetaLeadLog {
  id           Int       @id @default(autoincrement())
  metaLeadId   String    @db.VarChar(100) // Meta lead ID
  metaFormId   String    @db.VarChar(100) // Meta form ID
  metaPageId   String    @db.VarChar(100) // Meta page ID
  leadId       Int? // Lead criado no sistema (null se falhou)
  status       String    @default("received") @db.VarChar(20) // received, processed, failed, duplicate
  rawData      Json?     @db.Json // Dados brutos recebidos do Meta
  campaignData Json?     @db.Json // Dados da campanha/ad
  errorMessage String?   @db.Text
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([metaLeadId])
  @@index([metaFormId])
  @@index([status])
  @@index([createdAt])
  @@map("bychat_meta_lead_logs")
}

// ─── Beyond Tracking (Analytics interno) ─────────────────

model TrackingVisitor {
  id              Int      @id @default(autoincrement())
  visitorId       String   @unique @db.VarChar(64) // ID gerado no browser (cookie bt_vid)
  fingerprint     String?  @db.VarChar(64) // Canvas+WebGL+Audio fingerprint hash
  leadId          Int? // Vinculado quando identificado
  identifiedEmail String?  @db.VarChar(191)
  identifiedPhone String?  @db.VarChar(30)
  identifiedName  String?  @db.VarChar(191)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  totalSessions   Int      @default(0)
  totalPageviews  Int      @default(0)
  totalEvents     Int      @default(0)
  metadata        Json?    @db.Json // Device info, browser, OS, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions TrackingSession[]
  events   TrackingEvent[]

  @@index([fingerprint])
  @@index([leadId])
  @@index([identifiedEmail])
  @@index([identifiedPhone])
  @@index([lastSeenAt])
  @@map("bychat_tracking_visitors")
}

model TrackingSession {
  id           Int             @id @default(autoincrement())
  sessionId    String          @unique @db.VarChar(64) // ID gerado no browser (sessionStorage)
  visitorId    Int
  visitor      TrackingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  duration     Int             @default(0) // Segundos
  pageviews    Int             @default(0)
  events       Int             @default(0)
  entryUrl     String?         @db.Text
  exitUrl      String?         @db.Text
  referrer     String?         @db.VarChar(500)
  utmSource    String?         @db.VarChar(100)
  utmMedium    String?         @db.VarChar(100)
  utmCampaign  String?         @db.VarChar(191)
  utmContent   String?         @db.VarChar(191)
  utmTerm      String?         @db.VarChar(191)
  ip           String?         @db.VarChar(45)
  userAgent    String?         @db.Text
  language     String?         @db.VarChar(20)
  screenWidth  Int?
  screenHeight Int?
  deviceType   String?         @db.VarChar(20) // desktop, mobile, tablet
  browser      String?         @db.VarChar(50)
  os           String?         @db.VarChar(50)
  country      String?         @db.VarChar(5)
  createdAt    DateTime        @default(now())

  trackingEvents TrackingEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([ip])
  @@index([startedAt, deviceType])
  @@map("bychat_tracking_sessions")
}

model TrackingEvent {
  id        Int              @id @default(autoincrement())
  visitorId Int
  visitor   TrackingVisitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId Int?
  session   TrackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type      String           @db.VarChar(30) // pageview, click, scroll, form_start, form_submit, custom, identify
  url       String?          @db.Text
  title     String?          @db.VarChar(500)
  referrer  String?          @db.Text
  data      Json?            @db.Json // Dados extras: scroll_depth, click coords, element selector, custom props
  timestamp DateTime         @default(now())

  @@index([visitorId, timestamp])
  @@index([sessionId])
  @@index([type])
  @@index([timestamp])
  @@index([type, timestamp])
  @@map("bychat_tracking_events")
}

// ─── Landing Pages & Forms ───────────────────────────────

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPage {
  id    Int    @id @default(autoincrement())
  slug  String @unique @db.VarChar(191)
  title String @db.VarChar(191)

  metaTitle       String? @db.VarChar(191)
  metaDescription String? @db.Text
  ogImage         String? @db.Text
  favicon         String? @db.Text

  sections     Json    @db.Json // Array de section configs
  globalStyles Json?   @db.Json // Cores, fontes, spacing overrides
  customCss    String? @db.LongText
  customHead   String? @db.Text // Extra <head> (analytics, etc)

  status     PageStatus @default(DRAFT)
  templateId String?    @db.VarChar(50)
  formId     Int? // Form principal vinculado

  trackingEnabled Boolean @default(true)
  conversionEvent String? @db.VarChar(100)

  views       Int @default(0)
  submissions Int @default(0)

  publishedAt DateTime?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enrollmentPortal EnrollmentPortal?

  @@index([status])
  @@index([slug])
  @@index([createdAt])
  @@map("bychat_landing_pages")
}

model Form {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(191)
  slug String? @unique @db.VarChar(120) // URL amigável da página hospedada (/f/:slug)

  fields   Json  @db.Json // Array de field definitions
  settings Json  @db.Json // submitText, successMessage, redirectUrl, etc.
  styling  Json? @db.Json // Cores, border-radius, font

  funnelId      Int? // Auto-assign ao funil
  stageKey      String? @db.VarChar(50)
  notifyEmails  String? @db.Text
  webhookUrl    String? @db.Text
  defaultTeamId Int? // Setor padrão para leads vindos deste form
  defaultTeam   Team?   @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)

  active      Boolean @default(true)
  submissions Int     @default(0)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formSubmissions FormSubmission[]
  chatbots        Chatbot[]

  @@index([active])
  @@index([defaultTeamId])
  @@map("bychat_forms")
}

model FormSubmission {
  id     Int  @id @default(autoincrement())
  formId Int
  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  leadId Int?

  data Json @db.Json // {fieldKey: value}

  pageSlug    String? @db.VarChar(191)
  visitorId   String? @db.VarChar(64)
  ip          String? @db.VarChar(45)
  userAgent   String? @db.Text
  referrer    String? @db.Text
  utmSource   String? @db.VarChar(100)
  utmMedium   String? @db.VarChar(100)
  utmCampaign String? @db.VarChar(191)

  createdAt DateTime @default(now())

  @@index([formId, createdAt])
  @@index([leadId])
  @@index([pageSlug])
  @@index([createdAt])
  @@map("bychat_form_submissions")
}

// ─── Tags ────────────────────────────────────────

model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(191)
  color       String   @db.VarChar(20)
  description String?  @db.Text
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads LeadTag[]

  @@index([active, position])
  @@map("bychat_tags")
}

model LeadTag {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([leadId, tagId])
  @@index([leadId])
  @@index([tagId])
  @@map("bychat_lead_tags")
}

// ─── Campos Personalizados ───────────────────────

model CustomField {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(100) // Chave unica (slug): ex. "cargo", "cnpj"
  label        String   @db.VarChar(191) // Nome visivel: "Cargo", "CNPJ"
  type         String   @db.VarChar(30) // text, number, email, phone, url, date, select, multiselect, checkbox, textarea, currency
  description  String?  @db.Text // Descricao para o operador
  placeholder  String?  @db.VarChar(191)
  options      Json?    @db.Json // Para select/multiselect: [{label, value}]
  defaultValue String?  @db.VarChar(500) // Valor padrao
  required     Boolean  @default(false)
  showInList   Boolean  @default(false) // Mostrar na tabela de leads
  showInKanban Boolean  @default(false) // Mostrar no card do kanban
  showInForm   Boolean  @default(true) // Disponivel nos formularios
  group        String?  @db.VarChar(50) // Agrupamento: "empresa", "contato", "financeiro", "custom"
  position     Int      @default(0) // Ordem de exibicao
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, position])
  @@index([key])
  @@map("bychat_custom_fields")
}

// ─── Dashboards Personalizados por Usuário ────────────

model UserDashboard {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(191)
  type      String   @default("dashboard") @db.VarChar(20) // dashboard ou analytics
  widgets   Json     @db.Json // Array de widget configs
  isDefault Boolean  @default(false)
  isSystem  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@map("bychat_user_dashboards")
}

// ── CAMPAIGN COSTS (ROI Dashboard) ───────────

// Rastreamento persistente de envios outbound (WhatsApp, Email, SMS, Webhook).
// BullMQ remove jobs concluídos rapidamente; este modelo guarda histórico
// duradouro com latência, retentativas e erros — alimenta o módulo Filas & Monitor.
//
// Lifecycle: queued → processing → sent → delivered → read | failed (cada step
// preenche o respectivo *At). Idempotência via jobId+queueName quando possível.
model OutboundSend {
  id         Int   @id @default(autoincrement())
  channel    String @db.VarChar(20) // whatsapp | email | sms | webhook
  queueName  String @db.VarChar(40) // wf-whatsapp etc

  leadId     Int?
  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  recipient  String @db.VarChar(191) // número, email, URL do webhook
  subject    String? @db.VarChar(191) // p/ email
  bodyPreview String? @db.Text // primeiros 500 chars

  jobId      String? @db.VarChar(64)
  externalId String? @db.VarChar(191) // ID do provider (WhatsApp messageId, SMS sid, webhook responseId)

  status     String  @default("queued") @db.VarChar(20)
  // queued | processing | sent | delivered | read | failed | bounced

  attempts    Int     @default(0)
  maxAttempts Int?

  latencyMs  Int? // tempo entre queued→sent (ms)
  error      String? @db.Text
  metadata   Json? @db.Json // payload extra (provider response, etc)

  // Origem do envio (workflow, cadência, atendimento manual, sistema)
  source     String? @db.VarChar(40) // workflow | cadence | manual | system
  sourceId   Int?    // workflowExecutionId, cadenceEnrollmentId, etc

  createdAt    DateTime @default(now())
  processingAt DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  updatedAt    DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([channel, status, createdAt])
  @@index([status, createdAt])
  @@index([jobId])
  @@index([source, sourceId])
  @@map("bychat_outbound_sends")
}

model CampaignCost {
  id           Int      @id @default(autoincrement())
  // Chave única gerada por código (suporta custos campaign/adset/ad sem ambiguidade
  // de NULL em UNIQUE composto do MySQL):
  //   "campaign:CID:YYYY-MM-DD"
  //   "adset:CID:ASID:YYYY-MM-DD"
  //   "ad:CID:ASID:ADID:YYYY-MM-DD"
  costKey      String   @unique @db.VarChar(255)
  level        String   @default("campaign") @db.VarChar(10) // campaign | adset | ad
  campaignId   String   @db.VarChar(191)
  campaignName String   @db.VarChar(191)
  adsetId      String?  @db.VarChar(191)
  adsetName    String?  @db.VarChar(191)
  adId         String?  @db.VarChar(191)
  adName       String?  @db.VarChar(191)
  date         DateTime @db.Date
  spend        Decimal  @db.Decimal(12, 2)
  impressions  Int?
  clicks       Int?
  // Cliques no link/CTA (subset de `clicks` que não inclui likes/comentários/profile views).
  // Meta UI usa essa métrica como "Cliques no link" e calcula "CTR" como
  // inlineLinkClicks/impressions. Capturado pra paridade com o painel da Meta.
  inlineLinkClicks    Int?
  inlineLinkClickCtr  Decimal? @db.Decimal(8, 4)
  reach        Int?
  cpc          Decimal? @db.Decimal(10, 4)
  cpm          Decimal? @db.Decimal(10, 4)
  ctr          Decimal? @db.Decimal(8, 4)
  frequency    Decimal? @db.Decimal(8, 4)
  actions      Json?    @db.Json // {leads, link_clicks, post_engagement, etc}
  source       String   @default("manual") @db.VarChar(30) // manual, meta_api
  notes        String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId, date])
  @@index([adsetId, date])
  @@index([adId, date])
  @@index([level])
  @@index([date])
  @@map("bychat_campaign_costs")
}

// ── RASTREAMENTO INTELIGENTE (Fase 7) ────────

model TrackableLink {
  id                Int      @id @default(autoincrement())
  slug              String   @unique @db.VarChar(191)
  name              String   @db.VarChar(191)
  description       String?  @db.Text
  whatsappPhone     String   @db.VarChar(30)
  prefilledMessage  String?  @db.Text
  utmSource         String?  @db.VarChar(100)
  utmMedium         String?  @db.VarChar(100)
  utmCampaign       String?  @db.VarChar(191)
  utmContent        String?  @db.VarChar(191)
  utmTerm           String?  @db.VarChar(191)
  campaignId        String?  @db.VarChar(191)
  campaignName      String?  @db.VarChar(191)
  active            Boolean  @default(true)
  totalClicks       Int      @default(0)
  uniqueClicks      Int      @default(0)
  leadsGenerated    Int      @default(0)
  totalSales        Int      @default(0) // Contador de vendas atribuídas ao link
  totalRevenue      Decimal  @default(0) @db.Decimal(12, 2)
  // Pixels disparados na página intermediária /l/:slug
  fbPixelId         String?  @db.VarChar(64) // Meta Pixel ID
  fbCapiAccessToken String?  @db.Text // Meta Conversions API access token
  ga4MeasurementId  String?  @db.VarChar(64) // GA4 Measurement ID (G-XXXXXXX)
  redirectDelayMs   Int      @default(3000) // delay antes do redirect (page /l/)
  createdBy         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clicks TrackableLinkClick[]

  @@index([slug])
  @@index([active])
  @@index([createdAt])
  @@map("bychat_trackable_links")
}

model TrackableLinkClick {
  id          Int           @id @default(autoincrement())
  linkId      Int
  link        TrackableLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ip          String?       @db.VarChar(45)
  userAgent   String?       @db.Text
  referer     String?       @db.Text
  deviceType  String?       @db.VarChar(20)
  browser     String?       @db.VarChar(50)
  os          String?       @db.VarChar(50)
  visitorId   String?       @db.VarChar(64)
  // IDs de atribuição capturados da query string (fbclid/gclid/ctwaClid do Meta/Google)
  fbclid      String?       @db.VarChar(255)
  gclid       String?       @db.VarChar(255)
  ctwaClid    String?       @db.VarChar(255)
  tintimFbid  String?       @db.VarChar(255) // compat: {{ad.id}}_{{site_source_name}}_{{placement}}
  sessionId   String?       @db.VarChar(64) // Pixel JS visitor/session ID — cruza anônimo→lead
  capiEventId String?       @db.VarChar(64) // event_id para dedup Meta CAPI ↔ browser pixel
  capiSent    Boolean       @default(false) // disparo do Lead event via Conversions API
  // Snapshot de UTMs recebidos na query (podem diferir do link.utm* se modificados)
  utmSource   String?       @db.VarChar(100)
  utmMedium   String?       @db.VarChar(100)
  utmCampaign String?       @db.VarChar(191)
  utmContent  String?       @db.VarChar(191)
  utmTerm     String?       @db.VarChar(191)
  queryParams Json?         @db.Json // query string completa bruta
  createdAt   DateTime      @default(now())

  @@index([linkId, createdAt])
  @@index([ip])
  @@index([createdAt])
  @@index([fbclid])
  @@index([gclid])
  @@index([ctwaClid])
  @@index([sessionId])
  @@map("bychat_trackable_link_clicks")
}

// ───── Pixel JS (bychat-pixel) — visitante anônimo ─────
model PixelVisitor {
  id               Int       @id @default(autoincrement())
  visitorId        String    @unique @db.VarChar(64)
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  totalPageviews   Int       @default(0)
  totalEvents      Int       @default(0)
  // Primeira atribuição (sticky, não é sobrescrita)
  firstUrl         String?   @db.Text
  firstReferer     String?   @db.Text
  firstUtmSource   String?   @db.VarChar(100)
  firstUtmMedium   String?   @db.VarChar(100)
  firstUtmCampaign String?   @db.VarChar(191)
  firstUtmContent  String?   @db.VarChar(191)
  firstUtmTerm     String?   @db.VarChar(191)
  firstFbclid      String?   @db.VarChar(255)
  firstGclid       String?   @db.VarChar(255)
  firstCtwaClid    String?   @db.VarChar(255)
  firstTintimFbid  String?   @db.VarChar(255)
  // Última atribuição
  lastUrl          String?   @db.Text
  lastUtmSource    String?   @db.VarChar(100)
  lastUtmCampaign  String?   @db.VarChar(191)
