}

// ─── Campos Personalizados ───────────────────────

model CustomField {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(100) // Chave unica (slug): ex. "cargo", "cnpj"
  label        String   @db.VarChar(191) // Nome visivel: "Cargo", "CNPJ"
  type         String   @db.VarChar(30) // text, number, email, phone, url, date, select, multiselect, checkbox, textarea, currency
