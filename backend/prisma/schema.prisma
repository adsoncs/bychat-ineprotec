}

model DbConnectorRun {
  id                 Int       @id @default(autoincrement())
  connectorId        Int
  connector          DbConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  status             String    @default("running") @db.VarChar(20)
  rowsRead           Int       @default(0)
  leadsCreated       Int       @default(0)
  leadsSkipped       Int       @default(0)
  errorCount         Int       @default(0)
  cursorBefore       String?   @db.VarChar(255)
  cursorAfter        String?   @db.VarChar(255)
  error              String?   @db.Text
  triggeredBy        String    @default("cron") @db.VarChar(20)
  triggeredByUserId  Int?

  @@index([connectorId, startedAt(sort: Desc)])
  @@map("bychat_db_connector_runs")
}

// ── Google Integration ──────────────────────────────────

model GoogleConnection {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  accessToken    String    @db.Text
  refreshToken   String    @db.Text
  tokenExpiresAt DateTime?
  scopes         String    @db.VarChar(500)
  active         Boolean   @default(true)
  // Híbrido B: COMPANY = conta da empresa (Drive/Sheets centralizado + fallback);
  // OPERATOR = conta pessoal de um operador (Calendar/Tasks/Gmail próprios)
  kind           String    @default("OPERATOR") @db.VarChar(16)
  userId         Int?      @unique
  createdBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sheetIntegrations    GoogleSheetIntegration[]
  calendarIntegrations GoogleCalendarIntegration[]
  driveConfigs         GoogleDriveConfig[]
  tasksConfigs         GoogleTasksConfig[]
  gmailConfigs         GmailConfig[]

  @@index([active])
  @@index([kind, active])
  @@map("bychat_google_connections")
}

model GoogleSheetIntegration {
  id               Int              @id @default(autoincrement())
  name             String           @db.VarChar(191)
  connectionId     Int
  connection       GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  spreadsheetId    String           @db.VarChar(191)
  spreadsheetName  String           @db.VarChar(191)
  sheetName        String           @default("Sheet1") @db.VarChar(191)
  events           Json             @db.Json
  fieldMapping     Json             @db.Json
  includeTimestamp Boolean          @default(true)
  active           Boolean          @default(true)
  totalSent        Int              @default(0)
  totalFailed      Int              @default(0)
  lastSentAt       DateTime?
  lastError        String?          @db.Text
  createdBy        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  logs GoogleSheetLog[]

  @@index([active])
  @@index([connectionId])
  @@map("bychat_google_sheet_integrations")
}

model GoogleSheetLog {
  id            Int                    @id @default(autoincrement())
  integrationId Int
  integration   GoogleSheetIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event         String                 @db.VarChar(50)
  rowData       Json?                  @db.Json
  success       Boolean                @default(false)
  error         String?                @db.Text
  duration      Int?
  createdAt     DateTime               @default(now())

  @@index([integrationId, createdAt])
  @@index([createdAt])
  @@map("bychat_google_sheet_logs")
}

// ── Google Calendar Integration ─────────────────────────

model GoogleCalendarIntegration {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(191)
  connectionId   Int
  connection     GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendarId     String           @default("primary") @db.VarChar(191)
  syncActivities Boolean          @default(true)
  activityTypes  Json             @db.Json // ["meeting","call"] etc
  autoMeetLink   Boolean          @default(true)
  notifyLead     Boolean          @default(false)
  active         Boolean          @default(true)
  totalSynced    Int              @default(0)
  totalFailed    Int              @default(0)
  lastSyncAt     DateTime?
  lastError      String?          @db.Text
  createdBy      Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([active])
  @@index([connectionId])
  @@map("bychat_google_calendar_integrations")
}

model CalendarSyncLog {
  id              Int      @id @default(autoincrement())
  integrationId   Int
  activityId      Int?
  calendarEventId String?  @db.VarChar(191)
  action          String   @db.VarChar(30) // created, updated, deleted
  success         Boolean  @default(false)
  error           String?  @db.Text
  duration        Int?
  createdAt       DateTime @default(now())

  @@index([integrationId, createdAt])
  @@index([createdAt])
  @@map("bychat_calendar_sync_logs")
}

// ── Google Drive Integration ────────────────────────────

model GoogleDriveConfig {
  id             Int      @id @default(autoincrement())
  connectionId   Int
  connection     GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rootFolderId   String?  @db.VarChar(191) // pasta raiz "ByChat CRM" no Drive
  rootFolderLink String?  @db.Text
  autoUploadChat Boolean  @default(false) // upload automático de mídia do chat
  active         Boolean  @default(true)
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([connectionId])
  @@map("bychat_google_drive_configs")
}

// ── Google Tasks Integration ────────────────────────────

model GoogleTasksConfig {
  id            Int      @id @default(autoincrement())
  connectionId  Int
  connection    GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  taskListId    String   @db.VarChar(191)
  taskListTitle String   @db.VarChar(191)
  activityTypes Json     @db.Json // ["task","followup","meeting","call"]
  active        Boolean  @default(true)
  totalSynced   Int      @default(0)
  totalFailed   Int      @default(0)
  createdBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([connectionId])
  @@map("bychat_google_tasks_configs")
}

// ── Gmail Integration ───────────────────────────────────

model GmailConfig {
  id           Int      @id @default(autoincrement())
  connectionId Int
  connection   GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderName   String?  @db.VarChar(191) // nome que aparece no "De:"
  signature    String?  @db.Text // assinatura HTML
  active       Boolean  @default(true)
  totalSent    Int      @default(0)
  totalFailed  Int      @default(0)
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([connectionId])
  @@map("bychat_gmail_configs")
}

// ── Google Analytics 4 ──────────────────────────────────

model GA4Config {
  id            Int       @id @default(autoincrement())
  measurementId String    @db.VarChar(50) // G-XXXXXXXXXX
  apiSecret     String    @db.VarChar(191) // Measurement Protocol API secret
  events        Json      @db.Json // quais eventos do CRM enviar
  active        Boolean   @default(true)
  totalSent     Int       @default(0)
  totalFailed   Int       @default(0)
  lastSentAt    DateTime?
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("bychat_ga4_configs")
}

// ── Google Ads Integration ──────────────────────────────

model GoogleAdsConfig {
  id                  Int       @id @default(autoincrement())
  connectionId        Int
  customerId          String    @db.VarChar(30) // Google Ads customer ID (xxx-xxx-xxxx)
  developerToken      String    @db.VarChar(191) // Google Ads API developer token
  conversionAction    String?   @db.VarChar(191) // [DEPRECATED] mantido p/ compat; usar conversionMap
  autoSendConversions Boolean   @default(false)
  active              Boolean   @default(true)
  totalSent           Int       @default(0)
  totalFailed         Int       @default(0)
  lastSentAt          DateTime?
  createdBy           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  conversionMap GoogleAdsConversionMap[]

  @@index([connectionId])
  @@map("bychat_google_ads_configs")
}

// Mapping trigger interno → Conversion Action no Google Ads (Fase 28 — multi-evento).
// Cada GoogleAdsConfig pode ter até 1 row por trigger (lead.won, lead_qualified, etc).
model GoogleAdsConversionMap {
  id               Int      @id @default(autoincrement())
  configId         Int
  trigger          String   @db.VarChar(60)  // 'lead.won' | 'lead_qualified' | 'enrollment.payment_confirmed' | 'diagnosis.completed' | ...
  conversionAction String   @db.VarChar(191) // ID puro da Conversion Action no Google Ads
  valueSource      String   @default("zero") @db.VarChar(20) // 'zero' | 'sale_value' | 'fixed'
  fixedValue       Float?
  isPrimary        Boolean  @default(false)  // marcação informativa — Google Ads tem seu próprio conceito de Primary
  enabled          Boolean  @default(true)
  totalSent        Int      @default(0)
  totalFailed      Int      @default(0)
  lastSentAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  config GoogleAdsConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, trigger])
  @@index([configId])
  @@map("bychat_google_ads_conversion_map")
}

// Custos / métricas por dia × nível (campaign | ad_group | ad) sincronizados via
// GAQL da API Google Ads. Espelha `CampaignCost` (Meta) — colunas equivalentes.
model GoogleAdsCampaignCost {
  id               Int      @id @default(autoincrement())
  // Chave determinística:
  //   "campaign:CID:CAMP:YYYY-MM-DD"
  //   "ad_group:CID:CAMP:AG:YYYY-MM-DD"
  //   "ad:CID:CAMP:AG:AD:YYYY-MM-DD"
  costKey          String   @unique @db.VarChar(255)
  level            String   @default("campaign") @db.VarChar(10) // campaign | ad_group | ad
  customerId       String   @db.VarChar(30)  // Google Ads customer ID (xxx-xxx-xxxx ou só dígitos)
  campaignId       String   @db.VarChar(191)
  campaignName     String   @db.VarChar(191)
  adGroupId        String?  @db.VarChar(191)
  adGroupName      String?  @db.VarChar(191)
  adId             String?  @db.VarChar(191)
  adName           String?  @db.VarChar(191)
  date             DateTime @db.Date
  spend            Decimal  @db.Decimal(12, 2)
  impressions      Int?
  clicks           Int?
  conversions      Decimal? @db.Decimal(12, 4)
  conversionValue  Decimal? @db.Decimal(12, 2)
  cpc              Decimal? @db.Decimal(10, 4)
  cpm              Decimal? @db.Decimal(10, 4)
  ctr              Decimal? @db.Decimal(8, 4)
  avgPosition      Decimal? @db.Decimal(8, 4)
  source           String   @default("google_ads_api") @db.VarChar(30)
  raw              Json?    @db.Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId, date])
  @@index([campaignId, date])
  @@index([adGroupId, date])
  @@index([adId, date])
  @@index([level])
  @@index([date])
  @@map("bychat_google_ads_campaign_costs")
}

// ═══════════════════════════════════════════════════════════════
// MÓDULO EDUCACIONAL — ativado via setting `educational.enabled`
// Inspirado na modelagem da Rubeus (docs.rubeus.com.br) + MEC
// ═══════════════════════════════════════════════════════════════

model EducationalLevel {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  codigo    String?  @unique @db.VarChar(50)
  descricao String?  @db.Text
  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses            Course[]
  offerings          CourseOffering[]
  selectionProcesses SelectionProcess[]

  @@map("bychat_edu_levels")
}

model Modality {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  codigo    String?  @unique @db.VarChar(50)
  descricao String?  @db.Text
  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]

  @@map("bychat_edu_modalities")
}

// Unidade = agrupamento organizacional (marca/filial/regional)
// Uma instituição pode ter várias unidades (ex: "Norte", "Sul", "EAD")
model EducationalUnit {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(191)
  codigo    String?  @unique @db.VarChar(50)
  descricao String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses           Campus[]
  courses            Course[]
  offerings          CourseOffering[]
  selectionProcesses SelectionProcess[]
  enrollmentPortals  EnrollmentPortal[]

  @@map("bychat_edu_units")
}

// Campus = local físico/virtual de oferta (pertence a uma Unidade)
model Campus {
  id        Int             @id @default(autoincrement())
  unitId    Int
  unit      EducationalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  nome      String          @db.VarChar(191)
  codigo    String?         @db.VarChar(50)
  descricao String?         @db.Text
  telefone  String?         @db.VarChar(30)
  email     String?         @db.VarChar(191)
  endereco  String?         @db.VarChar(255)
  numero    String?         @db.VarChar(20)
  bairro    String?         @db.VarChar(100)
  cep       String?         @db.VarChar(10)
  cidade    String?         @db.VarChar(100)
  estado    String?         @db.VarChar(2)
  latitude  Float?
  longitude Float?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  offerings CourseOfferingCampus[]

  @@index([unitId])
  @@index([cidade, estado])
  @@map("bychat_edu_campuses")
}

// Curso = catálogo mestre (nome + descrição, sem modalidade/nível)
model Course {
  id           Int               @id @default(autoincrement())
  unitId       Int
  unit         EducationalUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  levelId      Int?
  level        EducationalLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  nome         String            @db.VarChar(191)
  codigo       String?           @db.VarChar(50)
  descricao    String?           @db.Text
  duracaoMeses Int?
  cargaHoraria Int?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  offerings CourseOffering[]

  @@index([unitId])
  @@index([levelId])
  @@map("bychat_edu_courses")
}

// Oferta de Curso = instância concreta: Curso × Modalidade × Nível × Unidade × Período
// Ela que recebe vagas, valores, datas, processo seletivo e conecta aos campus
model CourseOffering {
  id                 Int               @id @default(autoincrement())
  courseId           Int
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitId             Int
  unit               EducationalUnit   @relation(fields: [unitId], references: [id])
  modalityId         Int
  modality           Modality          @relation(fields: [modalityId], references: [id])
  levelId            Int?
  level              EducationalLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  selectionProcessId Int?
  selectionProcess   SelectionProcess? @relation(fields: [selectionProcessId], references: [id], onDelete: SetNull)

  nome        String  @db.VarChar(191)
  complemento String? @db.VarChar(255) // ex: "Noturno — 2026/1"
  codigo      String? @db.VarChar(50)
  turno       String? @db.VarChar(20) // Matutino, Vespertino, Noturno, Integral

  valorMensalidade Decimal? @db.Decimal(12, 2)
  valorMatricula   Decimal? @db.Decimal(12, 2)
  vagasMinimas     Int?
  vagasMaximas     Int?

  // Nota de corte específica desta oferta (ex: Medicina 700, Pedagogia 450).
  // Override opcional de SelectionProcess.notaCorte — se null, usa a do processo.
  // Lido pelo enemClassification.ts na ordem: offering.notaCorte > selectionProcess.notaCorte.
  notaCorte Float?

  // Cutoffs específicos por oferta — override de SelectionProcess.essayCutoff/presencialCutoff.
  essayCutoff      Float?
  presencialCutoff Float?

  inicioInscricao  DateTime?
  terminoInscricao DateTime?
  inicioMatricula  DateTime?
  terminoMatricula DateTime?
  inicioCurso      DateTime?
  terminoCurso     DateTime?

  status    String   @default("active") @db.VarChar(20) // active, draft, closed
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses      CourseOfferingCampus[]
  registrations ProcessRegistration[]

  @@index([courseId])
  @@index([unitId])
  @@index([modalityId])
  @@index([selectionProcessId])
  @@index([status])
  @@map("bychat_edu_offerings")
}

// N:M Oferta × Campus (uma oferta pode ser ministrada em vários campus)
model CourseOfferingCampus {
  id         Int            @id @default(autoincrement())
  offeringId Int
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  campusId   Int
  campus     Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([offeringId, campusId])
  @@index([offeringId])
  @@index([campusId])
  @@map("bychat_edu_offering_campuses")
}

// Processo Seletivo = um "vestibular" (ENEM/vestibular/agendado/análise/transferência)
// — como cada forma de ingresso é um processo distinto, NÃO há campo tipo fixo:
// o admin cria um processo "Vestibular Tradicional 2026/1", outro "ENEM 2026/1", etc.
// Modo de ingresso (Vestibular online/presencial, ENEM, Transferência, Segunda Graduação,
// Pós-Graduação, Extensão, Bolsa). Define como o candidato é avaliado, quais documentos
// são exigidos e qual workflow de aprovação é aplicado.
// Seed fixo — registros criados pelo service educational.ts (idempotente).
model EntryMode {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(40) // vestibular_online, enem, transferencia, etc.
  name        String  @db.VarChar(100)
  description String? @db.Text
  icon        String? @db.VarChar(10) // emoji para UI

  // Tipo de avaliação determina o evaluator plugável.
  // none = aprovação automática | docs = análise documental | enem = upload + parser IA
  // exam_online = prova digital (F6 futura) | exam_presencial = prova em local físico (F5 futura)
  evaluationType String @default("docs") @db.VarChar(30)

  requiresClassification Boolean @default(false) // calcula nota/posição?

  // Campos extras que aparecem no form do portal quando esse modo é selecionado.
  // Formato: [{ name, label, type, required, ... }]
  defaultFormExtras Json?

  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionProcesses   SelectionProcess[]
  documentRequirements EntryModeDocumentRequirement[]

  @@index([code])
  @@index([active, ordem])
  @@map("bychat_edu_entry_modes")
}

// Catálogo master de tipos de documento (RG, CPF, Histórico Escolar, Boletim ENEM, Diploma,
// Comprovante de Renda, etc). Substitui o campo free-form EnrollmentDocument.type.
model DocumentType {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(40) // rg, cpf, historico, boletim_enem, diploma
  name        String  @db.VarChar(100)
  description String? @db.Text
  category    String  @default("other") @db.VarChar(30) // identity|academic|enem|financial|other

  // Template de análise IA — chave que aponta para o prompt no worker de review.
  // null = sem análise automatizada por IA (review puramente humano).
  aiAnalysisTemplate String? @db.VarChar(50)

  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements   EntryModeDocumentRequirement[]
  spRequirements SelectionProcessDocumentRequirement[]
  documents      EnrollmentDocument[]

  @@index([category, ordem])
  @@map("bychat_edu_document_types")
}

// Junção N×N: quais documentos cada modo de ingresso exige.
// Ex: EntryMode("transferencia") × DocumentType("historico") com required=true.
model EntryModeDocumentRequirement {
  id             Int          @id @default(autoincrement())
  entryModeId    Int
  entryMode      EntryMode    @relation(fields: [entryModeId], references: [id], onDelete: Cascade)
  documentTypeId Int
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  required Boolean @default(true)
  ordem    Int     @default(0)
  helpText String? @db.Text

  createdAt DateTime @default(now())

  @@unique([entryModeId, documentTypeId])
  @@index([entryModeId, ordem])
  @@map("bychat_edu_entry_mode_doc_requirements")
}

// Override por SelectionProcess. Quando o SP tem `useCustomDocuments = true`,
// o candidato vê os requirements desta tabela em vez do default do EntryMode.
// Quando false (default), herda 100% do EntryMode.
model SelectionProcessDocumentRequirement {
  id                 Int              @id @default(autoincrement())
  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)
  documentTypeId     Int
  documentType       DocumentType     @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  required Boolean @default(true)
  ordem    Int     @default(0)
  helpText String? @db.Text

  createdAt DateTime @default(now())

  @@unique([selectionProcessId, documentTypeId])
  @@index([selectionProcessId, ordem])
  @@map("bychat_edu_sp_doc_requirements")
}

model SelectionProcess {
  id          Int               @id @default(autoincrement())
  unitId      Int
  unit        EducationalUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  levelId     Int?
  level       EducationalLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  // Modo de ingresso define avaliação, documentos e workflow do processo.
  // Nullable só durante migração inicial — novos processos exigem.
  entryModeId Int?
  entryMode   EntryMode?        @relation(fields: [entryModeId], references: [id], onDelete: SetNull)

  nome          String   @db.VarChar(191)
  codigo        String?  @db.VarChar(50)
  // Código único (slug) usado como identificador público do processo — ex.: "vestibular-20262".
  // Referenciado no portal de matrículas para gerar inscrições com rastreabilidade.
  slug          String?  @unique @db.VarChar(100)
  descricao     String?  @db.Text
  editalUrl     String?  @db.Text
  taxaInscricao Decimal? @db.Decimal(12, 2)
  periodoLetivo String?  @db.VarChar(20) // 2026/1, 2026/2

  inicioInscricao  DateTime?
  terminoInscricao DateTime?
  inicioMatricula  DateTime?
  terminoMatricula DateTime?

  // Nota de corte aplicada ao modo ENEM (e exames futuros).
  // Usado pelo evaluator para classificar aprovação/reprovação automática.
  notaCorte Float?

  status    String   @default("active") @db.VarChar(20) // active, draft, closed
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quando true, painel do candidato usa documentRequirements desta SP em vez
  // do default do EntryMode. Quando false (padrão), herda do modo.
  useCustomDocuments Boolean @default(false)

  // ── Configuração da Redação Online (modo vestibular_online) ──
  // Tema, prazo, tentativas, anti-fraude, critérios IA. Aplicado por SP — cada
  // edição do vestibular pode ter um tema/critérios diferentes.
  essayPrompt          String? @db.Text
  essayDurationMinutes Int? // null = sem prazo cronometrado
  essayMaxAttempts     Int     @default(1)
  essayMinWords        Int? // mínimo de palavras (validação client+server)
  essayMaxWords        Int? // máximo de palavras
  essayPasteBlocked    Boolean @default(true)
  essayAiEnabled       Boolean @default(true)
  // Quando true, a IA aprova/reprova direto (compara aiScore com essayCutoff)
  // sem passar por revisão humana. Default false = sempre needs_human após IA.
  essayAiAutoApprove   Boolean @default(false)
  essayCutoff          Float? // nota mínima default (override por oferta)
  // [{key, label, weight, description}] — ex: coesão 20%, gramática 15%, etc.
  essayAiCriteria      Json?

  // Cutoff default da prova presencial (override por oferta).
  presencialCutoff Float?

  offerings            CourseOffering[]
  registrations        ProcessRegistration[]
  documentRequirements SelectionProcessDocumentRequirement[]
  essayTopics          EssayTopic[]

  @@index([unitId])
  @@index([levelId])
  @@index([entryModeId])
  @@index([status])
  @@index([periodoLetivo])
  @@map("bychat_edu_selection_processes")
}

// Tema da redação online — 1:N por SelectionProcess. O backend sorteia um
// tema ativo a cada nova tentativa do candidato e snapshota em
// EssaySubmission.prompt (não volta a sortear quando o draft é retomado).
// Quando a SP não tem nenhum EssayTopic, o legado SelectionProcess.essayPrompt
// é usado como fallback.
model EssayTopic {
  id                 Int              @id @default(autoincrement())
  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)

  title        String?  @db.VarChar(150) // rótulo curto opcional ("Tema 1", "Inclusão digital")
  prompt       String   @db.Text // enunciado completo da proposta
  supportTexts String?  @db.Text // textos motivadores (opcional)
  active       Boolean  @default(true)
  ordem        Int      @default(0)

  // Origem do tema — exibe badge na UI (ai | enem | manual). Default 'manual'
  // pra não quebrar registros existentes; backfill aplicado na migração.
  source       String   @default("manual") @db.VarChar(20)
  // Metadados opcionais — ENEM: ano da prova; AI: modelo/contexto usados.
  sourceMeta   Json?    @db.Json

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([selectionProcessId])
  @@index([active])
  @@map("bychat_edu_essay_topics")
}

// Registro de Processo = inscrição/matrícula do Lead numa Oferta via Processo Seletivo
// (ponte Contato × Oferta × Processo Seletivo, com ciclo de vida do candidato)
model ProcessRegistration {
  id                 Int              @id @default(autoincrement())
  leadId             Int
  lead               Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offeringId         Int
  offering           CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)

  codigo String? @db.VarChar(50)
  // Ciclo: inscrito → pago_taxa → classificado → convocado → matriculado
  //                                                        ↘ desistente / reprovado
  status String  @default("inscrito") @db.VarChar(30)

  inscritoEm     DateTime  @default(now())
  pagoTaxaEm     DateTime?
  classificadoEm DateTime?
  convocadoEm    DateTime?
  matriculadoEm  DateTime?
  desistenteEm   DateTime?

  notaClassificacao    Float?
  posicaoClassificacao Int?
  valorPago            Decimal? @db.Decimal(12, 2)
  observacao           String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusLogs             ProcessRegistrationStatusLog[]
  enrollmentRegistration EnrollmentRegistration?

  @@unique([leadId, offeringId])
  @@index([leadId])
  @@index([offeringId])
  @@index([selectionProcessId])
  @@index([status])
  @@map("bychat_edu_process_registrations")
}

// Histórico de mudanças de status de uma inscrição.
// Cada PUT que altera ProcessRegistration.status escreve uma linha aqui.
model ProcessRegistrationStatusLog {
  id             Int                 @id @default(autoincrement())
  registrationId Int
  registration   ProcessRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus     String?             @db.VarChar(30)
  toStatus       String              @db.VarChar(30)
  actorId        Int?
  actorName      String?             @db.VarChar(191)
  observacao     String?             @db.Text
  createdAt      DateTime            @default(now())

  @@index([registrationId, createdAt])
  @@map("bychat_edu_process_registration_status_logs")
}

// ═══════════════════════════════════════════════════════════════════
// PORTAL DE MATRÍCULAS (Fase A - MVP)
// ═══════════════════════════════════════════════════════════════════

// Portal de matrículas — página pública configurável vinculada a um ou mais
// processos seletivos. Reaproveita LandingPage para o design.
model EnrollmentPortal {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(100)
  nome String @db.VarChar(191)

  unitId Int
  unit   EducationalUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // IDs dos processos seletivos atendidos por este portal (JSON array of Int).
  selectionProcessIds Json @db.Json

  // Design reaproveita LandingPage; relação 1-1 opcional.
  landingPageId Int?         @unique
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  // Estrutura do formulário multi-step (persistida como JSON).
  // { steps: [{ id, name, fields: [{ type, name, label, required, options, rules }] }], ... }
  formConfig Json @db.Json

  // Modo do portal:
  //   'full'     — formulário completo de matrícula (padrão, comportamento legado)
  //   'interest' — captura leve no topo de funil (4 campos + LGPD); gera Lead
  //                em status INTERESSADO e dispara magic link para o candidato
  //                completar a inscrição em um portal 'full' depois.
  formMode String @default("full") @db.VarChar(20)

  // Quando formMode='interest', aponta para o portal 'full' onde o lead vai
  // continuar a matrícula via magic link. Self-relation opcional.
  continuationPortalId  Int?
  continuationPortal    EnrollmentPortal?  @relation("PortalContinuation", fields: [continuationPortalId], references: [id], onDelete: SetNull)
  interestSourcePortals EnrollmentPortal[] @relation("PortalContinuation")

  // TTL do magic link de continuação, em dias. 30 é razoável para nurturing.
  magicLinkTtlDays Int @default(30)

  // Comportamento
  alwaysCreateNew Boolean @default(false) // ignora dedup e sempre cria registro novo
  ctaBehavior     String  @default("message") @db.VarChar(20) // message | redirect
  ctaTarget       String? @db.VarChar(500)
  ctaMessage      String? @db.Text

  captchaType    String? @db.VarChar(20) // recaptcha | hcaptcha | none
  captchaSiteKey String? @db.VarChar(100)
  captchaSecret  String? @db.VarChar(255) // criptografado em produção

  // Permissões / filtros hierárquicos (JSON array of Int, null = todos)
  allowedLevelIds    Json? @db.Json
  allowedCourseIds   Json? @db.Json
  allowedCampusIds   Json? @db.Json
  allowedModalityIds Json? @db.Json

  // Pagamento (Fase B)
  // O VALOR da taxa NÃO mora aqui — é lido de SelectionProcess.taxaInscricao
  // (cada inscrição já carrega o selectionProcessId, então o valor segue o
  // vestibular específico, não o portal que pode hospedar vários).
  paymentProvider      String? @db.VarChar(30) // asaas | pagarme
  paymentConfig        Json?   @db.Json
  requirePayment       Boolean @default(false)
  paymentDeadlineHours Int     @default(48)
  // 'link'       = redireciona pra paymentlinks hospedado (Pagar.me) / invoiceUrl (Asaas)
  // 'transparent' = checkout PIX/boleto/cartão renderiza dentro do portal de inscrição
  paymentMode          String  @default("link") @db.VarChar(20)

  // Domínio próprio + SEO
  customDomain    String? @db.VarChar(191)
  sslStatus       String? @db.VarChar(20)
  metaTitle       String? @db.VarChar(191)
  metaDescription String? @db.VarChar(500)
  ogImageUrl      String? @db.Text

  // Branding visual (aba 🎨 Visual no admin) — compartilhado por
  // /portal/:slug (vestibular) e /candidato/:code (candidato).
  brandLogoUrl            String? @db.VarChar(500)
  brandLogoLink           String? @db.VarChar(500)
  brandFaviconUrl         String? @db.VarChar(500)
  brandPrimaryColor       String? @db.VarChar(20) // hex (#1a73e8)
  brandHeroEnabled        Boolean @default(true)
  brandHeroUrl            String? @db.VarChar(500)
  brandHeroTitle          String? @db.VarChar(191)
  brandHeroSubtitle       String? @db.VarChar(500)
  brandHeroOverlayOpacity Int? // 0-80
  brandFooterText         String? @db.Text
  brandFontFamily         String? @db.VarChar(40) // inter | roboto | poppins | system
  brandRadiusScale        String? @db.VarChar(20) // sharp | medium | rounded

  // Advanced
  customCss    String? @db.LongText
  customHeadJs String? @db.LongText
  customBodyJs String? @db.LongText

  // Analytics (pixels)
  pixelConfig Json? @db.Json

  // CRM
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Funil destino para leads criados via portal
  funnelId Int?
  funnel   Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  stageKey String? @db.VarChar(50)

  // Etapa do funil para onde o lead vai automaticamente quando TODOS os docs
  // obrigatórios da inscrição forem aprovados. Vazio = não move.
  docsCompleteStageKey String? @db.VarChar(50)

  // Etapa para auto-avanço quando docs OK + avaliação do modo de ingresso OK
  // (redação aprovada / ENEM passou / presencial aprovado). Vazio = não move.
  finalApprovalStageKey String? @db.VarChar(50)

  // Conexão de gateway de pagamento (preferir a `paymentProvider` + `paymentConfig` legados).
  // Referencia PaymentProviderConnection — 1 conexão serve N portais.
  paymentConnectionId Int?
  paymentConnection   PaymentProviderConnection? @relation(fields: [paymentConnectionId], references: [id], onDelete: SetNull)

  // Sequência de candidateCode (usado no generator)
  codePrefix   String @default("MAT") @db.VarChar(10)
  codeSequence Int    @default(0)

  // Estado
  active      Boolean   @default(true)
  publishedAt DateTime?

  // Counters (updated via app logic)
  views       Int @default(0)
  submissions Int @default(0)
  conversions Int @default(0)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EnrollmentRegistration[]
  drafts        EnrollmentDraft[]

  @@index([unitId])
  @@index([active])
  @@index([teamId])
  @@index([funnelId])
  @@index([paymentConnectionId])
  @@index([customDomain])
  @@map("bychat_enrollment_portals")
}

// Gateway de pagamento como integração reutilizável (1 conexão → N portais)
model PaymentProviderConnection {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(191)
  provider    String @db.VarChar(30) // asaas | stripe | mercadopago
  environment String @default("sandbox") @db.VarChar(20) // sandbox | production

  apiKey             String  @db.Text // criptografada via encryptToken
  // Public key (Pagar.me: pk_…) — usada pela tokenizecard.js no frontend para
  // tokenizar cartão sem PCI no servidor (SAQ A). Asaas usa fluxo /creditCard/tokenize.
  // Criptografada via encryptToken. Opcional: sem ela, aba cartão fica desabilitada.
  publicKey          String? @db.Text
  defaultBillingType String? @db.VarChar(20) // UNDEFINED | PIX | BOLETO | CREDIT_CARD

  webhookToken  String  @unique @db.VarChar(64)
  webhookSecret String? @db.VarChar(191)

  // Metadados de conta
  companyDocument String? @db.VarChar(20)
  pixKey          String? @db.VarChar(191)
  accountHolder   String? @db.VarChar(191)

  active Boolean @default(true)

  // Teste de conexão
  lastTestedAt    DateTime?
  lastTestStatus  String?   @db.VarChar(30) // ok | error
  lastTestMessage String?   @db.Text

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portals     EnrollmentPortal[]
  webhookHits PaymentWebhookHit[]

  @@index([provider])
  @@index([active])
  @@map("bychat_payment_provider_connections")
}

// Módulo VoIP — registro de chamada (CDR) da integração FaleMaisVoip.
// Duas origens: `click_to_call` (operador clica "Ligar" → v1/dial da Sigma REST)
// e `bulk_sync` (importado do histórico /ligacoes da API de Gravações).
// `leadId`/`userId`/`activityId` são scalars (sem relation Prisma) de propósito —
// `bulk_sync` pode não casar com um lead e não queremos back-relations em User/Lead.
model VoipCall {
  id Int @id @default(autoincrement())

  leadId     Int? // lead casado (por telefone) — null se não encontrado
  activityId Int? // Activity tipo "call" criada para aparecer na timeline do lead
  userId     Int? // operador que originou (click_to_call)
  userName   String? @db.VarChar(191)

  extension String? @db.VarChar(20) // ramal de origem
  phone     String  @db.VarChar(30) // número discado (destino)
  callerId  String? @db.VarChar(30) // bina usada (dialcallerid)
  direction String  @default("outbound") @db.VarChar(10) // outbound | inbound

  provider       String  @default("falemais") @db.VarChar(30)
  providerCallId String? @db.VarChar(64) // id retornado pelo v1/dial (32 hex) — chave do polling de áudio
  uniqueid       String? @db.VarChar(64) // uniqueid do CDR da API de Gravações

  // dialing | answered | no_answer | busy | failed | completed
  status     String    @default("dialing") @db.VarChar(20)
  startedAt  DateTime  @default(now())
  answeredAt DateTime?
  durationSec Int?

  recordingUrl      String?   @db.Text // URL pública servida via /uploads/voip-recordings/
  recordingPath     String?   @db.VarChar(255) // caminho relativo dentro de uploads/
  recordingSyncedAt DateTime?

  source String @default("click_to_call") @db.VarChar(20) // click_to_call | bulk_sync
  raw    Json?  @db.Json // payload bruto do provedor (audio/info ou /ligacoes) p/ debug

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([providerCallId])
  @@index([uniqueid])
  @@index([startedAt])
  @@map("bychat_voip_calls")
}

// Auditoria de cada webhook recebido (Pagar.me/Asaas). Persistido ANTES do
// processamento — se o handler falhar, ainda temos o payload pra debug.
model PaymentWebhookHit {
  id           Int                        @id @default(autoincrement())
  connectionId Int?                       // null se token inválido
  connection   PaymentProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  provider     String  @db.VarChar(20)   // pagarme | asaas
  eventType    String  @db.VarChar(100)  // charge.paid | order.payment_failed | ...
  externalId   String? @db.VarChar(191)  // ch_... / payment id — extraído do payload

  // Resultado do processamento
  // received    = chegou mas ainda não processado (fallback)
  // processed   = OK
  // ignored     = evento não reconhecido (200 OK ao provider)
  // notFound    = enrollment não encontrado (200 OK pra parar retentativas)
  // error       = falhou
  status         String  @default("received") @db.VarChar(20)
  registrationId Int?
  errorMessage   String? @db.Text
  payload        Json    @db.Json
  signatureValid Boolean @default(true)   // sempre true por ora (não validamos assinatura ainda)

  remoteIp   String? @db.VarChar(45)
  userAgent  String? @db.Text
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt(sort: Desc)])
  @@index([connectionId, receivedAt(sort: Desc)])
  @@index([externalId])
  @@index([status])
  @@map("bychat_payment_webhook_hits")
}

// Cupom de desconto — cadastro admin. Ainda NÃO é aplicado no checkout
// (integração futura). A estrutura permite percentual ou valor fixo, escopo
// por portal, validade, limite de usos.
model Coupon {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  // 'percent' = value em % (1-100); 'fixed' = value em R$
  type  String  @db.VarChar(10)
  value Decimal @db.Decimal(12, 2)

  // Limites
  minAmount     Decimal? @db.Decimal(12, 2)   // só vale acima desse valor
  maxDiscount   Decimal? @db.Decimal(12, 2)   // teto p/ tipo percent
  usageLimit    Int?                           // null = ilimitado
  usageCount    Int      @default(0)
  perUserLimit  Int      @default(1)           // limite por CPF

  // Escopo (JSON array de portalIds; null = todos os portais)
  portalIds Json? @db.Json

  // Validade
  validFrom  DateTime?
  validUntil DateTime?
  active     Boolean   @default(true)

  redemptions CouponRedemption[]

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([active])
  @@map("bychat_coupons")
}

// Cada vez que um cupom é aplicado a uma inscrição (snapshot do desconto).
model CouponRedemption {
  id             Int     @id @default(autoincrement())
  couponId       Int
  coupon         Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  registrationId Int                                       // FK lógica (sem cascade — histórico imutável)

  amountBefore   Decimal @db.Decimal(12, 2)
  discountValue  Decimal @db.Decimal(12, 2)
  amountAfter    Decimal @db.Decimal(12, 2)

  // Snapshot da config do cupom no momento do uso (proteção contra mudança posterior)
  couponSnapshot Json @db.Json

  redeemedAt DateTime @default(now())

  @@index([couponId])
  @@index([registrationId])
  @@map("bychat_coupon_redemptions")
}

// Rascunho de inscrição: salva formData intermediário por sessão.
// Permite ao candidato recuperar progresso se fechar o browser.
model EnrollmentDraft {
  id       Int              @id @default(autoincrement())
  portalId Int
  portal   EnrollmentPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  sessionId   String @unique @db.VarChar(64)
  formData    Json   @db.Json
  currentStep Int    @default(0)

  // Contatos opcionais para resume por email/whatsapp
  email     String? @db.VarChar(191)
  whatsapp  String? @db.VarChar(30)
  ipAddress String? @db.VarChar(45)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portalId])
  @@index([expiresAt])
  @@index([email])
  @@index([whatsapp])
  @@map("bychat_enrollment_drafts")
}

// Registro de uma inscrição submetida via portal. Complementa ProcessRegistration
// com dados específicos do portal (pagamento, documentos, candidateCode).
model EnrollmentRegistration {
  id       Int              @id @default(autoincrement())
  portalId Int
  portal   EnrollmentPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  processRegistrationId Int?                 @unique
  processRegistration   ProcessRegistration? @relation(fields: [processRegistrationId], references: [id], onDelete: SetNull)

  candidateCode String @unique @db.VarChar(30)

  status String @default("pending") @db.VarChar(30)
  // pending | paid | docs_uploaded | docs_reviewing | docs_approved | docs_rejected
  // approved | rejected | enrolled | cancelled | expired

  formData Json @db.Json

  // Pagamento
  paymentId        String?   @db.VarChar(191)
  paymentStatus    String?   @db.VarChar(20)
  paymentUrl       String?   @db.Text
  paymentAmount    Decimal?  @db.Decimal(12, 2)
  paymentMethod    String?   @db.VarChar(30)
  paymentPaidAt    DateTime?
  paymentExpiresAt DateTime?

  documents        EnrollmentDocument[]
  enemScoreImports EnemScoreImport[]
  presencialExams  PresencialExam[]
  essaySubmissions EssaySubmission[]
  paymentMethods   EnrollmentPaymentMethod[]

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  ipAddress   String? @db.VarChar(45)
  userAgent   String? @db.Text
  utmSource   String? @db.VarChar(100)
  utmMedium   String? @db.VarChar(100)
  utmCampaign String? @db.VarChar(191)
  fbclid      String? @db.VarChar(191)
  gclid       String? @db.VarChar(191)
  referrer    String? @db.Text

  // Login do candidato no portal (SHA256 do segredo)
  accessHash String? @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portalId])
  @@index([status])
  @@index([paymentStatus])
  @@index([leadId])
  @@index([createdAt])
  @@map("bychat_enrollment_registrations")
}

// Checkout transparente: 1 linha por método ativo na inscrição (PIX/Boleto/Cartão).
// Permite o candidato trocar de método (cada um tem dados/timestamps próprios) e
// guardar dados sensíveis-mas-públicos (QR code, linha digitável) sem inflar
// EnrollmentRegistration. Status reflete o último estado conhecido do provedor.
model EnrollmentPaymentMethod {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  method   String @db.VarChar(20) // pix | boleto | credit_card
  provider String @db.VarChar(20) // asaas | pagarme

  externalId String? @db.VarChar(191) // id no provedor (order/charge/payment)
  status     String  @default("pending") @db.VarChar(20) // pending | paid | expired | failed | refunded
  amount     Decimal @db.Decimal(12, 2)
  expiresAt  DateTime?

  // PIX
  qrCode    String? @db.Text     // string copy-paste
  qrCodeUrl String? @db.Text     // URL da imagem PNG

  // Boleto
  boletoLine    String? @db.VarChar(60)  // linha digitável
  boletoBarcode String? @db.VarChar(60)
  boletoPdfUrl  String? @db.Text
  boletoDueAt   DateTime?

  // Cartão (só metadados, NUNCA o PAN — tokenização via JS do provider)
  cardLastDigits String? @db.VarChar(4)
  cardBrand      String? @db.VarChar(20)
  cardHolderName String? @db.VarChar(191)

  // Último erro do provedor (recusa, antifraude, etc) — exibido na UI
  lastErrorMessage String? @db.Text

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([registrationId])
  @@index([externalId])
  @@index([status])
  @@map("bychat_enrollment_payment_methods")
}

// F3 — Registro de importação/extração de boletim ENEM por inscrição.
// Criado automaticamente pelo worker de análise documental quando um doc
// do tipo `boletim_enem` é processado com sucesso. Mantém histórico
// completo para recursos/fiscalização.
model EnemScoreImport {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  documentId     Int?                   @unique
  document       EnrollmentDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // Dados extraídos do boletim
  nome      String? @db.VarChar(191)
  inscricao String? @db.VarChar(30)
  ano       Int?
  treineiro Boolean @default(false)

  // 5 notas ENEM
  cienciasHumanas  Float?
  cienciasNatureza Float?
  linguagens       Float?
  matematica       Float?
  redacao          Float?

  // Agregados calculados
  mediaSimples   Float? // (CH+CN+LG+MT+RD)/5
  mediaPonderada Float? // reservado para fórmulas customizadas por oferta

  // Validação cruzada com o que o candidato informou no form
  nomeBateComForm      Boolean?
  inscricaoBateComForm Boolean?
  anoBateComForm       Boolean?

  // Resultado da classificação automática (F3.3)
  cutoffScore Float? // snapshot da nota de corte aplicada no momento
  passed      Boolean? // null = ainda não classificado

  // Auditoria
  source       String @default("ai") @db.VarChar(20) // ai | manual
  aiConfidence Float?
  rawAnalysis  Json? // snapshot do aiAnalysis que gerou este registro

  // Revisão humana (override opcional)
  validatedBy    Int?
  validatedAt    DateTime?
  validationNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([inscricao])
  @@index([ano])
  @@index([passed])
  @@map("bychat_edu_enem_score_imports")
}

model EnrollmentDocument {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // FK opcional para DocumentType. Nullable por compatibilidade com docs pré-F2
  // que só tinham o campo `type` string-livre. Novos uploads devem ligar typeId.
  typeId Int?
  type   DocumentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  // Campo legado: string livre do tipo. Mantido para compatibilidade com documentos
  // antigos. Novos uploads usam typeId + lookup no DocumentType.
  typeCode String @db.VarChar(30)

  label     String @db.VarChar(100)
  fileUrl   String @db.Text
  fileName  String @db.VarChar(191)
  mimeType  String @db.VarChar(50)
  sizeBytes Int

  // Status final da review (decisão humana, final).
  // pending | approved | rejected
  status     String    @default("pending") @db.VarChar(20)
  reviewNote String?   @db.Text
  reviewedBy Int?
  reviewedAt DateTime?

  // ═══ F2: Análise IA (Claude Sonnet 4.6 com visão) ═══
  // Status do processamento IA: pending (enfileirado) | processing | done | failed | skipped
  // skipped = DocumentType sem aiAnalysisTemplate, ou IA desligada para essa conta
  aiStatus String @default("pending") @db.VarChar(20)

  // Sugestão da IA ao operador humano: approve | review | reject
  // Humano tem palavra final em `status`; aiSuggestion só orienta.
  aiSuggestion String? @db.VarChar(20)

  // Confiança da sugestão [0.0–1.0]. Abaixo do threshold cai automaticamente em review.
  aiConfidence Float?

  // Output estruturado do modelo: dados extraídos + flags + raciocínio resumido.
  // Schema depende do aiAnalysisTemplate do tipo (ex: rg_cpf → { nome, cpf, rgNumero... }).
  aiAnalysis Json?

  // Tokens/custo gastos (auditoria + telemetria).
  aiCostUsd Float?

  aiProcessedAt DateTime?

  uploadedAt DateTime @default(now())

  enemScoreImport EnemScoreImport?

  @@index([registrationId])
  @@index([status])
  @@index([typeId])
  @@index([aiStatus])
  @@map("bychat_enrollment_documents")
}

// ─── Vestibular Presencial (modo exam_presencial) ──────────────
// Agendamento + lançamento de nota + veredito do time comercial.
// Cada inscrição pode ter no máximo 1 exam (ou histórico se reagendar — TBD).
model PresencialExam {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Agendamento
  scheduledAt DateTime?
  location    String?   @db.VarChar(255)
  room        String?   @db.VarChar(50)
  seatNumber  String?   @db.VarChar(20)

  // Presença na prova: scheduled | present | absent
  attendanceStatus String @default("scheduled") @db.VarChar(20)

  // Correção
  score    Float?
  maxScore Float?
  examNote String? @db.Text

  // Veredito do time comercial / coordenação
  verdict       String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  verdictBy     Int? // userId
  verdictAt     DateTime?
  verdictReason String?   @db.Text

  // Classificação
  passed        Boolean?
  cutoffApplied Float? // snapshot do cutoff usado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([scheduledAt])
  @@index([verdict])
  @@map("bychat_edu_presencial_exams")
}

// ─── Redação Online (modo vestibular_online) ───────────────────
// 1 submissão por tentativa. Tentativas máximas vêm do SelectionProcess.essayMaxAttempts.
// Cronometrado: startedAt + expiresAt; submissão após expiresAt = inválida no servidor.
model EssaySubmission {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Snapshot do tema no momento que a tentativa iniciou (mesmo se SP for editada depois)
  prompt String? @db.Text

  attemptNumber Int @default(1)

  essayText String? @db.LongText
  wordCount Int     @default(0)

  // Estado: draft | submitted | ai_reviewing | needs_human | approved | rejected | expired
  status String @default("draft") @db.VarChar(20)

  // Tempo
  startedAt   DateTime?
  expiresAt   DateTime?
  submittedAt DateTime?

  // IA
  aiScore       Float?
  aiAnalysis    Json? // { criteria: [{key,label,score,comment}], overall, suggestions }
  aiConfidence  Float?
  aiProcessedAt DateTime?
  aiCostUsd     Float?

  // Revisão humana
  humanScore Float?
  humanNote  String?   @db.Text
  reviewedBy Int?
  reviewedAt DateTime?

  // Resolução final
  finalScore    Float?
  passed        Boolean?
  cutoffApplied Float?

  // Anti-fraude (auditoria — incrementado pelo client via beacon)
  pasteAttempts     Int @default(0)
  visibilityChanges Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([status])
  @@index([submittedAt])
  @@map("bychat_edu_essay_submissions")
}

// ─── Sales Engagement ────────────────────────────────────────
// Cadências outbound estilo Outreach/Salesloft. Motor próprio (cadenceScheduler)
// que reusa apenas dispatchAction do workflowActions para envios. Detalhes:
// docs/sales_engagement_core.md e memória project_bychatbeyond_sales_engagement.

model SalesCadence {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(191)
  description String? @db.Text

  // Owner (criador) e equipe responsável (governança/permissões/queries)
  ownerId Int?
  owner   User? @relation("CadenceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId  Int?
  team    Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  status      String @default("draft") @db.VarChar(20) // draft | active | paused | archived
  triggerMode String @default("manual") @db.VarChar(20) // manual | filter
  filterJson  Json?  @db.Json // se triggerMode=filter, query do filtro de leads

  pauseOnReply     Boolean @default(true) // resposta do lead pausa cadência
  exitOnConversion Boolean @default(true) // venda/agendamento removem da cadência
  exitOnStatuses   Json?   @db.Json       // lista de Lead.status que removem da cadência (ex: ["GANHO","PERDIDO"])

  // Fase 23.1: auto-enroll quando lead for marcado como Perdido com uma destas objeções.
  // Ex: [1, 3] = inscreve automaticamente leads perdidos por "Sem orçamento" ou "Decidiu não comprar".
  // Lista vazia ou null = sem auto-enroll (modo manual/filter padrão).
  entryOnLossReasonIds Json? @db.Json

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([teamId])
  @@index([ownerId])
  @@map("bychat_sales_cadences")
}

model CadenceStep {
  id        Int          @id @default(autoincrement())
  cadenceId Int
  cadence   SalesCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  order      Int // ordem do step na cadência (0, 1, 2…)
  dayOffset  Int @default(0) // dias após o step anterior (ou após enrollment, se primeiro)
  hourOffset Int @default(0) // horas adicionais ao dayOffset

  channel    String           @db.VarChar(20) // whatsapp | email | sms | call | manual | linkedin
  templateId Int?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  isManual      Boolean @default(false) // true → cria Activity em vez de envio automático
  isBreakUp     Boolean @default(false) // step de "break-up message" (último automático)
  conditionJson Json?   @db.Json // ex: { "tag": "hot" } — só executa se condição satisfeita

  // Builder visual (Fase 26): posição no canvas e branching opcional. Quando
  // nextStepId/altStepId são null o cadenceScheduler segue o modelo linear
  // legado (ordem por `order`).
  positionX  Int  @default(0)
  positionY  Int  @default(0)
  nextStepId Int?
  altStepId  Int?

  executions CadenceStepExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cadenceId, order])
  @@index([cadenceId])
  @@index([templateId])
  @@map("bychat_cadence_steps")
}

model CadenceEnrollment {
  id        Int          @id @default(autoincrement())
  cadenceId Int
  cadence   SalesCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  leadId    Int
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  enrolledAt   DateTime  @default(now())
  currentStep  Int       @default(0) // próximo step a executar (índice em CadenceStep.order)
  nextActionAt DateTime? // quando o cadenceScheduler deve processar este enrollment
  status       String    @default("active") @db.VarChar(20) // active | paused | completed | exited

  exitReason     String?   @db.VarChar(50) // replied | converted | opted_out | max_attempts | canceled | fora_fit
  pauseReason    String?   @db.VarChar(50) // reply_received | manual | governance_blocked
  lastReplyClass String?   @db.VarChar(30) // resultado do cadenceReplyClassifier (positiva|objecao|...)
  lastActionAt   DateTime?

  executions CadenceStepExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cadenceId, leadId])
  @@index([status, nextActionAt])
  @@index([leadId])
  @@map("bychat_cadence_enrollments")
}

// E4: cada execução de step gera uma linha aqui — permite drill-down completo
// no dashboard (por canal, por operador, por status). Cobre tanto envios
// automáticos (status='sent') quanto activities manuais (status='created_activity'
// + activityId) e bloqueios de governança (status='skipped_*').
model CadenceStepExecution {
  id           Int               @id @default(autoincrement())
  enrollmentId Int
  enrollment   CadenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       Int
  step         CadenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  leadId       Int
  cadenceId    Int

  channel String @db.VarChar(20) // whatsapp | email | sms | call | manual | linkedin
  // sent | created_activity | skipped_opt_out | skipped_blacklist | skipped_silence_window
  // | skipped_frequency_cap | skipped_template_missing | skipped_empty_body | failed
  status  String @db.VarChar(40)

  // Pra step manual: id da Activity criada + operador que completou (preenchido
  // depois quando o operador marca a Activity como completed).
  activityId     Int?
  operatorUserId Int?
  operator       User? @relation("CadenceStepExecutionOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  completedAt    DateTime?

  errorMessage String? @db.Text
  jobId        String? @db.VarChar(100) // BullMQ job id pra rastreabilidade

  executedAt DateTime @default(now())

  @@index([cadenceId, executedAt])
  @@index([enrollmentId])
  @@index([leadId])
  @@index([channel, executedAt])
  @@index([operatorUserId])
  @@index([activityId])
  @@map("bychat_cadence_step_executions")
}

// Governança de canal POR EQUIPE. Lida pelo messageGovernance.canSendNow:
// silence window, frequency cap diário e blacklist específicos do time.
// teamId NULL = config "global" (fallback quando lead não tem teamId).
// Por equipe → permite times com SLAs/políticas distintas (ex: vendas mais agressiva,
// pós-venda mais restrita).
model ChannelGovernance {
  id     Int  @id @default(autoincrement())
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // { "whatsapp": 2, "email": 1, "sms": 1 }  — chaves ausentes = sem limite.
  maxPerChannelPerDay Json @db.Json
  // { "start": "22:00", "end": "08:00", "weekends": true }
  silenceWindow       Json @db.Json
  // { "phones": ["55119...","55…"], "emails": ["x@y.com"] }
  blacklist           Json @db.Json

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId])
  @@map("bychat_channel_governance")
}

// ═════════════════════════════════════════════
// FERRAMENTAS — UTM Builder (catálogo de URLs taggeadas)
// ═════════════════════════════════════════════
//
// Biblioteca de URLs com UTMs reaproveitáveis. Operadores constroem uma URL
// taggeada, salvam com label interno, e podem reusar/exportar. Independente
// do `TrackableLink` (link encurtado /t/:slug) — mas integrável depois.
model UtmLink {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(191)   // label interno: "Black Friday WhatsApp post"
  baseUrl     String   @db.VarChar(2048)  // URL antes dos UTMs
  utmSource   String   @db.VarChar(100)
  utmMedium   String   @db.VarChar(100)
  utmCampaign String   @db.VarChar(191)
  utmTerm     String?  @db.VarChar(191)
  utmContent  String?  @db.VarChar(191)
  utmId       String?  @db.VarChar(191)   // Meta usa pra atribuição cross-device
  fullUrl     String   @db.Text           // URL final montada (cache pra busca/cópia)
  notes       String?  @db.Text
  tags        Json?    @db.Json           // ["lançamento", "Q4"]
  active      Boolean  @default(true)
  archived    Boolean  @default(false)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([utmCampaign])
  @@index([utmSource, utmMedium])
  @@index([active, archived])
  @@map("bychat_utm_links")
}

// Persona / ICP — perfil estruturado do cliente ideal. Vira contexto pro
// chatbot, Sales AI e cadências (system prompt + tom de voz consistente).
model Persona {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(191)        // "Coordenadora pedagógica de escola média"
  description  String?  @db.Text                // narrativa 2-3 parágrafos
  ageRange     String?  @db.VarChar(60)         // "30-45"
  genderHint   String?  @db.VarChar(40)         // "majoritariamente feminino"
  location     String?  @db.VarChar(191)        // "interior SP/MG"
  occupation   String?  @db.VarChar(191)
  income       String?  @db.VarChar(60)         // "R$ 5k-15k"
  painPoints   Json?    @db.Json                // string[]
  objections   Json?    @db.Json                // string[]
  triggers     Json?    @db.Json                // string[] — eventos/sinais que disparam compra
  channels     Json?    @db.Json                // string[] — WhatsApp/Email/Instagram/...
  voiceTone    String?  @db.Text                // "Profissional mas próximo, evitar gírias, usar exemplos pedagógicos"
  examplePhrases Json?  @db.Json                // string[] — frases que o cliente usaria
  goals        Json?    @db.Json                // string[] — objetivos do cliente
  active       Boolean  @default(true)          // false = arquivada
  isDefault    Boolean  @default(false)         // a persona "ativa" usada como contexto IA padrão
  createdById  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, isDefault])
  @@map("bychat_personas")
}

// Auditoria automática de conversas por IA. Roda async em background — analisa
// as mensagens trocadas no lead, devolve score 0-100, tom predominante,
// tempos de resposta e oportunidades perdidas. Usada para ranking de operadores
// e alertas de qualidade.
model ConversationAudit {
  id                Int      @id @default(autoincrement())
  leadId            Int
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Operador "principal" do lead no momento da auditoria (snapshot).
  // Fica null para leads sem operador atribuído — agregação por operador filtra null.
  operatorId        Int?
  operatorName      String?  @db.VarChar(100)
  // Período auditado (geralmente janela das últimas N mensagens).
  periodFrom        DateTime?
  periodTo          DateTime?
  messageCount      Int      @default(0)
  // Score 0-100 calculado pela IA combinando tom, atendimento, follow-up, etc.
  score             Int?     @db.SmallInt
  // Categorização do tom: cordial | neutro | frio | agressivo | inconsistente
  tone              String?  @db.VarChar(20)
  // Métricas mensuráveis sem IA — calculadas a partir das mensagens.
  responseTimeAvgSec Int?
  responseTimeP95Sec Int?
  // O que a IA observou — listas curtas de bullet points.
  strengths         Json?    @db.Json // string[]
  weaknesses        Json?    @db.Json // string[]
  missedOpportunities Json?  @db.Json // string[]
  // Aderência a script/roteiro (0-100 ou null se não aplicável).
  scriptAdherence   Int?     @db.SmallInt
  summary           String?  @db.Text
  modelUsed         String?  @db.VarChar(50)
  status            String   @default("done") @db.VarChar(20) // pending | running | done | failed
  errorMessage      String?  @db.Text
  triggeredBy       String?  @db.VarChar(20) // manual | cron | event
  triggeredById     Int?
  createdAt         DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([operatorId, createdAt])
  @@index([score])
  @@map("bychat_conversation_audits")
}

// Sugestão de movimentação de etapa gerada pela IA — Fase 9 "Jornada Automática".
// Quando o funil tem `aiStageEnabled`, um worker analisa o lead, identifica
// a próxima etapa apropriada e cria uma LeadStageSuggestion. Se a confidence
// ≥ funnel.aiStageThreshold E funnel.aiStageAutoApply=true, aplica automaticamente
// (move o lead). Senão fica como sugestão pendente pra revisão humana.
model LeadStageSuggestion {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  funnelId        Int
  funnel          Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  fromStageKey    String?  @db.VarChar(50)
  suggestedStageKey String @db.VarChar(50)
  confidence      Int      @db.SmallInt  // 0-100
  reasoning       String?  @db.Text
  modelUsed       String?  @db.VarChar(50)
  // pending | applied | rejected | superseded
  status          String   @default("pending") @db.VarChar(20)
  appliedAt       DateTime?
  decidedById     Int?     // operador que aprovou/rejeitou manualmente
  decidedAt       DateTime?
  decisionNote    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([leadId, status])
  @@index([funnelId, status, createdAt])
  @@index([status])
  @@map("bychat_lead_stage_suggestions")
}

// Módulo de importação de leads via planilha (CSV/Excel).
// Cada upload cria 1 row com status=preview + parsedRows JSON (até 5k linhas).
// Quando admin confirma, status vira running → done. errors JSON acumula falhas individuais.
model LeadImport {
  id                Int       @id @default(autoincrement())
  importedByUserId  Int?
  importedBy        User?     @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  fileName          String    @db.VarChar(255)
  fileSize          Int?
  status            String    @default("preview") @db.VarChar(15)
  totals            Json?     @db.Json
  mapping           Json      @db.Json
  parsedRows        String?   @db.MediumText
  errors            Json?     @db.Json
  previewExpiresAt  DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([importedByUserId])
  @@map("bychat_lead_imports")
}

// ─────────────────────────────────────────────────────────────
// Módulo de Agendamento de Reuniões (scheduling) — migration 0074
// FKs escalares (sem relação Prisma) p/ não tocar Lead/User/Funnel.
// ─────────────────────────────────────────────────────────────

model MeetingType {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(191)
  description String? @db.Text
  color       String? @db.VarChar(20)
  active      Boolean @default(true)

  // Regras de reserva
  durationMin        Int    @default(30)
  bufferBeforeMin    Int    @default(0)
  bufferAfterMin     Int    @default(0)
  slotIncrementMin   Int    @default(30)
  minNoticeMin       Int    @default(240) // antecedência mínima (min)
  bookingWindowDays  Int    @default(60) // janela de reserva (dias à frente)
  maxPerDay          Int? // teto de reservas por dia
  visibleSlotsPerDay Int? // limite de slots exibidos por dia
  timezone           String @default("America/Sao_Paulo") @db.VarChar(60)

  // Local
  locationType   String  @default("google_meet") @db.VarChar(30) // google_meet|phone|whatsapp|in_person|custom
  locationDetail String? @db.VarChar(255)

  // Atribuição
  assignmentMode String @default("fixed") @db.VarChar(20) // fixed|round_robin
  ownerUserId    Int?
  teamId         Int?

  // Integração CRM
  funnelId      Int?
  stageKey      String? @db.VarChar(60) // etapa ao agendar
  defaultTeamId Int?
  landingPageId Int?

  // Config (JSON): perguntas extras, mensagens de confirmação, pixel
  intakeFields       Json? @db.Json
  confirmationConfig Json? @db.Json
  pixelConfig        Json? @db.Json

  totalBookings Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([ownerUserId])
  @@map("bychat_meeting_types")
}

model AvailabilitySchedule {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(120)
  ownerUserId   Int? // agenda de um operador
  meetingTypeId Int? // ou específica de um tipo
  timezone      String   @default("America/Sao_Paulo") @db.VarChar(60)
  // [{ weekday: 1, start: "09:00", end: "12:00" }, ...] (0=domingo)
  rules         Json     @db.Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerUserId])
  @@index([meetingTypeId])
  @@map("bychat_availability_schedules")
}

model AvailabilityException {
  id          Int      @id @default(autoincrement())
  scheduleId  Int
  date        DateTime @db.Date
  unavailable Boolean  @default(true) // true=bloqueado; false=horário custom
  startTime   String?  @db.VarChar(5) // "09:00"
  endTime     String?  @db.VarChar(5)
  note        String?  @db.VarChar(191)
  createdAt   DateTime @default(now())

  @@index([scheduleId, date])
  @@map("bychat_availability_exceptions")
}

model Booking {
  id             Int    @id @default(autoincrement())
  token          String @unique @db.VarChar(64) // links públicos remarcar/cancelar
  meetingTypeId  Int
  leadId         Int?
  operatorUserId Int?

  startAt  DateTime
  endAt    DateTime
  timezone String   @db.VarChar(60)
  status   String   @default("scheduled") @db.VarChar(20) // scheduled|confirmed|completed|cancelled|no_show|rescheduled

  inviteeName  String? @db.VarChar(191)
  inviteeEmail String? @db.VarChar(191)
  inviteePhone String? @db.VarChar(30)
  answers      Json?   @db.Json

  locationType  String? @db.VarChar(30)
  meetLink      String? @db.Text
  googleEventId String? @db.VarChar(255)
  activityId    Int?

  cancelReason      String? @db.VarChar(255)
  rescheduledFromId Int?
  // Confirmação do lead (status scheduled→confirmed). confirmRequestedAt marca quando
  // enviamos o pedido de confirmação (HSM) — escopo do auto-cancelamento 3h antes.
  confirmRequestedAt DateTime?
  confirmedAt        DateTime?
  source            String  @default("scheduling") @db.VarChar(30)
  visitorId         String? @db.VarChar(64)
  utmSource         String? @db.VarChar(191)
  utmMedium         String? @db.VarChar(191)
  utmCampaign       String? @db.VarChar(191)
  utmContent        String? @db.VarChar(191)
  utmTerm           String? @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingTypeId, startAt])
  @@index([operatorUserId, startAt])
  @@index([leadId])
  @@index([status])
  @@map("bychat_bookings")
}

// Compromissos/bloqueios manuais na agenda de um operador. Aparecem no calendário e,
// quando ocupam tempo (busy/event), reduzem a disponibilidade pública (slots).
model CalendarBlock {
  id             Int      @id @default(autoincrement())
  operatorUserId Int?
  title          String   @default("")
  kind           String   @default("busy") // 'busy' (bloqueio) | 'event' (compromisso manual)
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean  @default(false)
  color          String?  @db.VarChar(20)
  note           String?  @db.Text
  createdByUserId Int?
  source         String   @default("manual")
  googleEventId    String? @db.VarChar(191) // evento espelhado no Google Calendar do operador
  googleCalendarId String? @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([operatorUserId, startAt])
  @@index([startAt])
  @@map("bychat_calendar_blocks")
}

// ─────────────────────────────────────────────────────────────
// Integração Kommo CRM — importador (migration 0081)
// ─────────────────────────────────────────────────────────────
// Mapeia IDs externos da Kommo → entidades locais do bychat, sem poluir os
// models core com colunas externalId. Liga lead/contact/pipeline/status/tag/
// note/task/custom_field/user da Kommo aos registros do bychat. Garante
// idempotência do importador: re-sync faz upsert (não duplica).
// `kommoId` é String (VarChar) pra evitar overflow de Int e a dor de BigInt
// no JSON. `meta` guarda dados auxiliares do vínculo (ex: pipelineId do status,
// updatedAt da Kommo p/ sync incremental, contactId principal de um lead, etc).
model KommoMapping {
  id         Int      @id @default(autoincrement())
  entityType String   @db.VarChar(30) // lead | contact | pipeline | status | tag | note | task | custom_field | user
  kommoId    String   @db.VarChar(40)
  localId    Int
  meta       Json?    @db.Json
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, kommoId])
  @@index([entityType, localId])
  @@map("bychat_kommo_mappings")
}
