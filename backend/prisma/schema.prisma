  updatedAt       DateTime  @updatedAt

  forms MetaForm[]

  @@index([active])
  @@map("bychat_meta_integrations")
}

model MetaForm {
  id            Int             @id @default(autoincrement())
  integrationId Int
  integration   MetaIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  formId        String          @db.VarChar(100) // Meta leadgen form ID
  formName      String          @db.VarChar(191) // Nome do formulario
  status        String          @default("active") @db.VarChar(20) // active, paused, archived

  // Mapeamento para o sistema
  funnelId      Int? // Funil destino
  stageKey      String? @db.VarChar(50) // Etapa destino (default: NOVO)
  fieldMapping  Json?   @db.Json // Mapeamento: {meta_field: lead_field}
  autoComplete  Boolean @default(false) // Marcar lead como completo ao receber
