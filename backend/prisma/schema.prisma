model FormSubmission {
  id     Int  @id @default(autoincrement())
  formId Int
  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  leadId Int?

  data Json @db.Json // {fieldKey: value}

  pageSlug    String? @db.VarChar(191)
  visitorId   String? @db.VarChar(64)
  ip          String? @db.VarChar(45)
  userAgent   String? @db.Text
  referrer    String? @db.Text
  utmSource   String? @db.VarChar(100)
  utmMedium   String? @db.VarChar(100)
  utmCampaign String? @db.VarChar(191)

  createdAt DateTime @default(now())

  @@index([formId, createdAt])
  @@index([leadId])
  @@index([pageSlug])
  @@index([createdAt])
  @@map("bychat_form_submissions")
}

// ─── Tags ────────────────────────────────────────

model Tag {
