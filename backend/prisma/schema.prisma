  @@index([matriculaId])
  @@map("bychat_aca_ead_notas")
}
model AcaEadAcesso {
  id          Int      @id @default(autoincrement())
  matriculaId Int
  recurso     String   @db.VarChar(191)
  acessadoEm  DateTime @default(now())
  @@index([matriculaId])
  @@map("bychat_aca_ead_acessos")
}

// ── F16 — Controle de Acesso Físico (módulo aca_acesso) ──
// A catraca/leitor físico é o ponto de integração: chama registrarAcesso com o
// token do QR + ponto; a decisão (credencial válida + bloqueio + log) é nativa.
model AcaPontoAcesso {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  local     String?  @db.VarChar(191)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@map("bychat_aca_pontos_acesso")
}
model AcaCredencial {
  id        Int      @id @default(autoincrement())
  alunoId   Int      @unique
  token     String   @unique @db.VarChar(64) // conteúdo do QR
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("bychat_aca_credenciais")
}
model AcaAcessoLog {
  id         Int      @id @default(autoincrement())
  alunoId    Int?
  pontoId    Int?
  tipo       String   @db.VarChar(8) @default("ENTRADA") // ENTRADA | SAIDA
  autorizado Boolean  @default(true)
  motivo     String?  @db.VarChar(191)
  createdAt  DateTime @default(now())
  @@index([alunoId])
  @@index([createdAt])
  @@map("bychat_aca_acesso_logs")
}

// ── F17 — Diploma Digital MEC (módulo aca_diploma) ──
// Estrutura do diploma digital + ponto de integração de assinatura ICP-Brasil.
enum AcaDiplomaStatus {
  RASCUNHO
  XML_GERADO
  ASSINADO
  REGISTRADO
  ANULADO
}
model AcaDiploma {
  id              Int      @id @default(autoincrement())
  matriculaId     Int      @unique
  alunoId         Int
  numero          String?  @db.VarChar(40)
  livro           String?  @db.VarChar(20)
  folha           String?  @db.VarChar(20)
  status          AcaDiplomaStatus @default(RASCUNHO)
  dataColacao     DateTime?
  dataEmissao     DateTime?
  cargaHoraria    Int      @default(0)
  xmlDiplomado    String?  @db.LongText // XML do diploma (padrão MEC)
  assinaturaInfo  String?  @db.Text     // ponto de integração: dados da assinatura ICP-Brasil
  codigoValidacao String?  @unique @db.VarChar(40)
  motivoAnulacao  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([alunoId])
  @@map("bychat_aca_diplomas")
}
model AcaDiplomaConfig {
  id                Int     @id @default(autoincrement())
  iesEmissora       String? @db.VarChar(191)
  cnpjEmissora      String? @db.VarChar(20)
  codigoMecEmissora String? @db.VarChar(20)
  iesRegistradora   String? @db.VarChar(191)
  codigoMecRegistradora String? @db.VarChar(20)
  reitor            String? @db.VarChar(191)
  secretario        String? @db.VarChar(191)
  // ponto de integração da assinatura: provedor/certificado (sem segredo aqui)
  provedorAssinatura String? @db.VarChar(60) // ex.: A1-local | A3-token | provedor-externo
  ativo             Boolean @default(false)
  updatedAt         DateTime @updatedAt @default(now())
  @@map("bychat_aca_diploma_config")
}

// ── F22 — TCC (estende aca_secretaria) ──
model AcaTcc {
  id               Int      @id @default(autoincrement())
  matriculaId      Int
  alunoId          Int
  titulo           String   @db.VarChar(255)
  orientador       String?  @db.VarChar(191)
  orientadorUserId Int?
  resumo           String?  @db.Text
  status           String   @db.VarChar(16) @default("REGISTRADO") // REGISTRADO | EM_ANDAMENTO | ENTREGUE | APROVADO | REPROVADO
  nota             Float?
  dataDefesa       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([alunoId])
  @@map("bychat_aca_tccs")
}

model AcaPlanoPagamento {
  id                    Int      @id @default(autoincrement())
  courseOfferingId      Int
  nome                  String   @db.VarChar(191)
  numParcelas           Int
  valorParcelaCentavos  Int
  taxaMatriculaCentavos Int      @default(0)
  diaVencimento         Int      @default(10)
  ativo                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([courseOfferingId])
