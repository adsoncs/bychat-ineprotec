model MetaForm {
  id            Int             @id @default(autoincrement())
  integrationId Int
  integration   MetaIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  formId        String          @db.VarChar(100) // Meta leadgen form ID
