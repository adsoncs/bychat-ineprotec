// prisma/schema.prisma
// Respeita todas as constraints MySQL 8 + Prisma documentadas no histórico BeyondHub:
// - @db.VarChar(191) em campos indexados
// - @db.Json em campos Json
// - Sem createMany com skipDuplicates
// - Sem arrays — campos Json para coleções

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(191)
  name          String    @db.VarChar(191)
  passwordHash  String    @db.VarChar(255)
  role          UserRole  @default(VIEWER)
  active        Boolean   @default(true)
  lockedAt      DateTime?
  lockReason    String?   @db.VarChar(255)
  loginAttempts Int       @default(0)
  lastLoginAt   DateTime?
  lastSeenAt    DateTime?
  /// Segundo fator (TOTP). O segredo só vale depois de o usuário provar que
  /// conseguiu ler o QR — por isso `twoFactorEnabled` é separado do segredo.
  twoFactorSecret       String?   @db.VarChar(64)
  twoFactorEnabled      Boolean   @default(false)
  twoFactorConfirmedAt  DateTime?
  /// Hashes SHA-256 dos códigos de recuperação, em JSON. Uso único cada.
  twoFactorBackupCodes  String?   @db.Text
  // Preferências da conta que precisam seguir a pessoa entre navegadores e
  // máquinas — hoje só as de notificação (som e aviso na área de trabalho).
  // JSON solto de propósito: preferência nova não deve pedir migration.
  preferences         Json?
  // Status de trabalho do operador. Usado pelo round-robin (exclui não-disponíveis)
  // e pela presença em listagens. Valores: available | away | busy | offline.
  workStatus           String    @default("offline") @db.VarChar(20)
  workStatusUpdatedAt  DateTime?
  // Capacidade máxima de leads ativos simultâneos (para roteamento least_loaded)
  capacity             Int       @default(5)
  // DEPRECATED (2026-05-21): Substituído por UserRole.AGENT na reforma de roles.
  // Coluna mantida temporariamente até F1.4 refatorar todos os usos no código.
  // Próxima migration vai dropar.
  isAgent              Boolean   @default(false)
  // Reforma F1.6: assinatura personalizada anexada ao fim das mensagens
  // outbound do operador. Markdown simples (negrito/itálico).
  signature            String?   @db.VarChar(255)
  // Nome que o CONTATO vê quando a identificação do operador está ligada
  // (Conversas). Separado de `name` de propósito: o cadastro costuma ter o
  // nome completo, e ninguém quer se apresentar como "Rafael Augusto Menezes
  // da Silva" a cada mensagem — nem expor o sobrenome a qualquer contato.
  // Vazio = usa o primeiro nome de `name`.
  displayName         String?   @db.VarChar(80)
  // Módulo VoIP: ramal (extension) do operador no PABX FaleMaisVoip. Usado pelo
  // click-to-call (v1/dial) — a chamada toca neste ramal e depois disca o destino.
  voipExtension        String?   @db.VarChar(20)
  // Número de WhatsApp para receber avisos internos (ex.: novo lead). Opcional;
  // sem ele, o aviso por WhatsApp cai no número geral de notificação.
  notifyWhatsapp       String?   @db.VarChar(30)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  audits        UserAudit[]    @relation("AuditTarget")
  auditActions  UserAudit[]    @relation("AuditActor")
  teams         TeamMember[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  refreshTokens RefreshToken[]
  ownedCadences SalesCadence[] @relation("CadenceOwner")
  cadenceStepExecutions CadenceStepExecution[] @relation("CadenceStepExecutionOperator")
  movedLeadStages LeadStageMovement[] @relation("LeadStageMovementBy")
  assignedActivities       Activity[]             @relation("ActivityAssignee")
  activityTemplates        ActivityTemplate[]     @relation("ActivityTemplateAssignee")
  leadStatusChanges        LeadStatusHistory[]    @relation("LeadStatusChangedBy")
  agentProfile  AgentProfile?
  workingHours  AgentWorkingHour[]
  ownedInstances WhatsAppInstance[] @relation("WhatsAppInstanceOwner")
  ownedCloudApiConnections CloudApiConnection[] @relation("CloudApiConnectionOwner")
  skills        AgentSkill[]
  transferRequestsSent     LeadTransferRequest[] @relation("TransferFromUser")
  transferRequestsReceived LeadTransferRequest[] @relation("TransferToUser")
  leadImports              LeadImport[]
  savedFilters             SavedFilter[]
  appliedFilters           UserAppliedFilter[]

  goals                    Goal[]
  commissionRules          CommissionRuleUser[]
  @@index([email])
  @@index([role])
  @@index([isAgent])
  scheduledMessagesCreated  ScheduledMessage[] @relation("ScheduledMessageCreator")
  scheduledMessagesCanceled ScheduledMessage[] @relation("ScheduledMessageCanceler")
  chatImportJobs            ChatImportJob[]    @relation("ChatImportCreator")

  conversationPins ConversationPin[]

  @@map("bychat_users")
  /// Números reservados que este usuário pode acompanhar (ver `visibility`).
  instanceViews      WhatsAppInstanceViewer[]   @relation("WhatsAppInstanceViewerUser")
  cloudViews         CloudApiConnectionViewer[] @relation("CloudApiConnectionViewerUser")
}

// Filtros nomeados que o usuário salva e pode reaplicar depois (públicos
// para todo o tenant ou privados só pra ele). `scope` permite reutilizar o
// modelo em outras telas no futuro (atualmente 'leads' cobre Leads+Kanban).
model SavedFilter {
  id          Int      @id @default(autoincrement())
  scope       String   @db.VarChar(30)   // 'leads' (compartilhado entre /app/leads e /app/kanban)
  name        String   @db.VarChar(120)
  filters     Json     @db.Json
  visibility  String   @default("private") @db.VarChar(10) // 'public' | 'private'
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, visibility])
  @@index([createdById, scope])
  @@map("bychat_saved_filters")
}

// Filtro CORRENTE que cada operador deixou aplicado num scope. Persiste
// entre logins — a tela só limpa quando o operador clica em "Resetar" ou
// muda explicitamente. Ao trocar filtros, o front faz upsert nesta tabela.
model UserAppliedFilter {
  userId    Int
  scope     String   @db.VarChar(30)
  filters   Json     @db.Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
  @@map("bychat_user_applied_filters")
}

// Reforma F3 (2026-05-21): pedido de transferência consensual de lead entre agentes.
// No modelo agente-isolado, não-admin não pode roubar lead via /claim?force=1.
// Em vez disso, A pede pra B aceitar a transferência. ADMIN/SUPERADMIN continuam
// usando /assign direto.
//
// Status: pending → (accepted | rejected | cancelled | expired)
// Lead.assignedUserId só muda quando status=accepted.
model LeadTransferRequest {
  id                Int       @id @default(autoincrement())
  leadId            Int
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId        Int
  fromUser          User      @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId          Int
  toUser            User      @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  status            String    @default("pending") @db.VarChar(15)
  reason            String?   @db.VarChar(255)
  response          String?   @db.VarChar(255)
  requestedAt       DateTime  @default(now())
  respondedAt       DateTime?
  respondedByUserId Int?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([leadId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([status, expiresAt])
  @@map("bychat_lead_transfer_requests")
}

// Habilidades do agente — usadas pelo skill-based matching (F5).
// skill é VARCHAR(64) livre. level 1-5 é informacional na F5; F8+ pode usar para scoring.
model AgentSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String   @db.VarChar(64)
  level     Int      @default(1) @db.TinyInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skill])
  @@index([skill])
  @@map("bychat_agent_skills")
}

// Horário de trabalho do agente. 0=domingo .. 6=sábado. Sem linha em um dia
// significa que o agente NÃO está disponível naquele dia (ex: folga).
// startTime/endTime em formato "HH:MM" 24h. timezone IANA (default São Paulo).
model AgentWorkingHour {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int      @db.TinyInt
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekday])
  @@index([userId])
  @@map("bychat_agent_working_hours")
}

// Perfil estendido do agente. Campos populados em fases posteriores
// (skills, workingHours em F2/F5). Aqui ficam apenas atributos base do
// roteamento: peso, teto diário, ausência temporária.
model AgentProfile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active        Boolean   @default(true)
  // Peso para round-robin ponderado (1 = padrão). Quanto maior, mais leads recebe.
  weight        Int       @default(1)
  // Limite diário opcional de leads recebidos por roteamento automático.
  maxDailyLeads Int?
  // Quando preenchido e no futuro, agente é pulado pelo picker.
  vacationUntil DateTime?
  notes         String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("bychat_agent_profiles")
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @db.VarChar(64)
  family       String    @db.VarChar(36)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("bychat_refresh_tokens")
}

model UserAudit {
  id        Int      @id @default(autoincrement())
  // Usuário-ALVO da ação. Nullable: ações de sistema (mudar config, excluir
  // conexão Cloud API, etc.) não têm usuário-alvo — só ator + targetType/Label.
  // onDelete: SetNull (NÃO Cascade) — auditoria é IMUTÁVEL: excluir o usuário-alvo
  // NÃO apaga o histórico; userId vira null mas targetLabel preserva quem era.
  userId    Int?
  user      User?    @relation("AuditTarget", fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(40)
  actorId   Int?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?  @db.VarChar(191)
  // Alvo genérico p/ ações que não são sobre um usuário (config, cloud_api,
  // api_key, module_permission, lead, chatbot, form, portal, routing_rule…).
  targetType  String? @db.VarChar(40)
  targetLabel String? @db.VarChar(191)
  changes   Json?    @db.Json
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@map("bychat_user_audits")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(191)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("bychat_password_resets")
}

model Funnel {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(191)
  description String?  @db.Text
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Jornada Automática por IA (Fase 9). Quando ativa, a IA analisa o lead
  // periodicamente e sugere/move pra próxima etapa. `aiStageThreshold` 0-100:
  // confidence mínima da IA para aplicar move automaticamente (abaixo vira sugestão).
  // `aiStagePrompt` é o prompt customizado por funil — explica os critérios
  // de cada etapa em linguagem natural. Quando vazio, usa prompt default
  // derivado dos `Stage.name`.
  aiStageEnabled     Boolean @default(false)
  aiStageAutoApply   Boolean @default(false)
  aiStageThreshold   Int     @default(80) @db.SmallInt
  aiStagePrompt      String? @db.Text

  stages            Stage[]
  chatbots          Chatbot[]
  leads             Lead[]
  enrollmentPortals EnrollmentPortal[]
  stageSuggestions  LeadStageSuggestion[]
  dbConnectors      DbConnector[]
  cloudApiConnections CloudApiConnection[]
  whatsappInstances WhatsAppInstance[]

  statusSummaries     StatusSummary[]

  goals               Goal[]
  @@map("bychat_funnels")
}

model Stage {
  id           Int      @id @default(autoincrement())
  funnelId     Int
  funnel       Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  key          String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  color        String   @db.VarChar(20)
  position     Int      @default(0)
  active       Boolean  @default(true)
  // Quando true, leads nesta etapa ocupam uma vaga da CourseOffering (módulo
  // Educacional). Inscrição em si NÃO consome — só o avanço para etapas como
  // Pagou Taxa, Classificado, Convocado, Matriculado.
  consumesSlot Boolean  @default(false)
  // Fase 23: marca etapa como terminal de outcome. Quando admin classifica
  // lead como Ganho/Perdido, se houver Stage com terminalKind correspondente
  // no funil do lead, move automaticamente para essa etapa.
  // Valores: null | 'won' | 'lost'.
  terminalKind String?  @db.VarChar(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Módulo Resumo: quanto tempo um lead PODE ficar na etapa e a temperatura
  // esperada. null = etapa de transição indefinida.
  slaHours    Int?
  temperature String? @db.VarChar(10) // quente | morno | frio

  @@unique([funnelId, key])
  @@index([funnelId, position])
  @@map("bychat_stages")
}

model KanbanPermission {
  id         Int      @id @default(autoincrement())
  role       UserRole @unique
  canAdvance Boolean  @default(true)
  canRetreat Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bychat_kanban_permissions")
}

model ModulePermission {
  id        Int      @id @default(autoincrement())
  moduleId  String   @db.VarChar(50)
  role      UserRole
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  // Reforma de roles (2026-05-21): scope define a granularidade do "ver/editar".
  //   'own'  → só recursos cujo dono é o próprio user (lead.assignedUserId)
  //   'team' → recursos do(s) setor(es) do user (lead.teamId)
  //   'all'  → tudo (qualquer recurso do tenant)
  // Default 'team' (segurança razoável quando admin não configurou).
  scope     String   @default("team") @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, role])
  @@index([role])
  @@index([moduleId])
  @@map("bychat_module_permissions")
}

// Reforma de permissões (2026-05-21): catálogo de módulos no DB.
// Antes: lista vivia só em backend/src/lib/moduleRegistry.ts (TS-side).
// Agora: linha em bychat_modules permite admin desabilitar globalmente
// (active=false). Quando desativado, módulo some do retorno de /admin/my-permissions
// para TODOS (inclusive SUPERADMIN — recupera via /admin/modules/list-all).
// isCore=true protege contra desabilitação acidental (dashboard, settings, users, ...).
model Module {
  id              String    @id @db.VarChar(50)
  name            String    @db.VarChar(100)
  category        String    @db.VarChar(30)
  active          Boolean   @default(true)
  isCore          Boolean   @default(false)
  disabledAt      DateTime?
  disabledByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
  @@map("bychat_modules")
}

model UserModuleOverride {
  id        Int      @id @default(autoincrement())
  userId    Int
  moduleId  String   @db.VarChar(50)
  canView   Boolean?
  canCreate Boolean?
  canEdit   Boolean?
  canDelete Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@map("bychat_user_module_overrides")
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  color       String   @default("#6B7280") @db.VarChar(20)
  icon        String?  @db.VarChar(30)
  active      Boolean  @default(true)
  position    Int      @default(0)
  // Modo de roteamento de leads recebidos por este setor.
  // manual = só atribui setor, deixa pra fila (operador faz claim)
  // round_robin = distribui em rodízio para o membro com lastAssignedAt mais antigo
  // least_loaded = distribui para o membro com menor número de leads ativos
  // random = sorteio entre membros disponíveis
  routingMode String   @default("manual") @db.VarChar(20)
  // Lead Routing F2: habilita filtro de horário do setor.
  // Quando true, o setor só recebe leads dentro do horário configurado em TeamWorkingHour.
  // Fora do horário, picker retorna null e caller pode redirecionar para Setting routing.out_of_hours_team_id.
  workingHoursEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            TeamMember[]
  leads              Lead[]
  chatbots           Chatbot[]
  whatsappInstances  WhatsAppInstance[]
  cloudApiConnections CloudApiConnection[] @relation("CloudApiDefaultTeam")
  // Números (Evolution e Cloud) que este setor divide com outros setores.
  ownedInstances      WhatsAppInstanceTeam[]
  ownedCloudApi       CloudApiConnectionTeam[]
  enrollmentPortals  EnrollmentPortal[]
  salesCadences      SalesCadence[]
  channelGovernances ChannelGovernance[]
  forms              Form[]
  metaForms          MetaForm[]
  workingHours       TeamWorkingHour[]
  dbConnectors       DbConnector[]

  @@index([active, position])
  assignedActivities  Activity[]
  activityTemplates   ActivityTemplate[]

  @@map("bychat_teams")
}

// Regras condicionais de roteamento. Avaliadas em cascata por order ASC.
// Primeira regra cujas conditions todas casam (AND) define o destino do lead.
// Quando nenhuma casa OU motor V2 desativado, sistema usa cascata legada
// (chatbot.defaultTeamId → instance.defaultTeamId → setting global).
model RoutingRule {
  id              Int       @id @default(autoincrement())
  order           Int       @default(0)
  name            String    @db.VarChar(120)
  enabled         Boolean   @default(true)
  // [{field, op, value}, ...]. Campos: source, utmSource, utmMedium, utmCampaign,
  // utmContent, utmTerm, formId, chatbotId, instanceName, tag.
  conditions      Json      @db.Json
  // {type: 'team'|'user', teamId?: number, userId?: number}
  action          Json      @db.Json
  description     String?   @db.VarChar(255)
  matchedCount    Int       @default(0)
  lastMatchedAt   DateTime?
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, order])
  @@map("bychat_routing_rules")
}

// Horário de funcionamento do setor (análogo a AgentWorkingHour). Só consultado
// quando Team.workingHoursEnabled = true.
model TeamWorkingHour {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weekday   Int      @db.TinyInt
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, weekday])
  @@index([teamId])
  @@map("bychat_team_working_hours")
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("bychat_team_members")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(191)
  value     Json     @db.Json
  label     String   @db.VarChar(191)
  grp       String   @db.VarChar(50)
  fieldType String   @default("text") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grp])
  @@map("bychat_settings")
}

// Registro de consentimento (LGPD) — banner de cookies / preferências do titular
model ConsentLog {
  id            Int      @id @default(autoincrement())
  visitorId     String?  @db.VarChar(64)
  leadId        Int?
  categories    Json     @db.Json
  policyVersion String   @default("1.0") @db.VarChar(20)
  action        String   @db.VarChar(20)
  source        String?  @db.VarChar(60)
  url           String?  @db.Text
  ip            String?  @db.VarChar(64)
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([visitorId])
  @@index([leadId])
  @@index([createdAt])
  @@map("bychat_consent_logs")
}

// Requisição de direitos do titular (LGPD art. 18) — portal /meus-dados.
// type: access | correction | deletion | portability | revocation
// status: pending | in_progress | done | rejected
// dueAt = createdAt + 15 dias (prazo legal de atendimento).
model DataSubjectRequest {
  id        Int       @id @default(autoincrement())
  leadId    Int?
  email     String?   @db.VarChar(191)
  whatsapp  String?   @db.VarChar(30)
  name      String?   @db.VarChar(191)
  type      String    @db.VarChar(20)
  status    String    @default("pending") @db.VarChar(16)
  details   Json?     @db.Json
  response  String?   @db.Text
  source    String?   @db.VarChar(30)
  ip        String?   @db.VarChar(64)
  dueAt     DateTime
  handledAt DateTime?
  handledBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([dueAt])
  @@map("bychat_data_subject_requests")
}

// Templates de email do sistema — editáveis pelo painel
// Configurações > Emails do Sistema (superadmin only).
// Code referencia por `key`; se o template estiver disabled ou ausente,
// usa fallback hardcoded em código.
model SystemEmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(80)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  subject     String   @db.VarChar(255)
  htmlBody    String   @db.MediumText
  enabled     Boolean  @default(true)
  /// Lista informativa de variáveis disponíveis no template (não é validador, só doc):
  /// `[{ "name": "lead.nome", "description": "Nome do lead" }, …]`
  variables   Json?    @db.Json
  category    String   @default("system") @db.VarChar(40)
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bychat_system_email_templates")
}

model Chatbot {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(191)
  channel           String   @db.VarChar(30)
  // Modo do motor: 'ai' (LLM + scoring) | 'scripted' (jornada determinística do form)
  mode              String   @default("ai") @db.VarChar(20)
  // Form vinculado quando mode='scripted' — o runner lê fields/qualificação dele.
  formId            Int?
  form              Form?    @relation(fields: [formId], references: [id], onDelete: SetNull)
  // Mensagens interativas editáveis do runner scripted (sobrescreve os defaults
  // de código por chave: noSlots, slotPrompt, bookingConfirmed, etc.).
  scriptedMessages  Json?    @db.Json
  // F3: coletar dados via WhatsApp Flow (formulário nativo em tela única) em vez de
  // pergunta-a-pergunta. Requer Cloud API + um CloudApiFlow publicado do form.
  useFlow           Boolean  @default(false)
  // Atendimento por IA após o roteiro encerrar: quando o lead já concluiu/foi
  // desqualificado e volta a mandar mensagem, a IA responde com contexto do desfecho.
  postChatAi        Boolean  @default(false)
  postChatPrompt    String?  @db.Text // instruções da IA pós-atendimento (vazio = usa systemPrompt)
  // Interpretação por IA das respostas no chatbot scripted: quando ligado e a
  // resposta a um select NÃO casa de forma determinística, a IA mapeia o texto
  // livre para a opção mais próxima (ou 'unclear' → reask). A IA só INTERPRETA;
  // o roteamento de etapa continua determinístico (resolveQualification).
  aiInterpret       Boolean  @default(false)
  interpretPrompt   String?  @db.Text // instrução extra p/ o classificador (vazio = prompt padrão)
// mode='ai_journey': prompt-mestre da jornada 100% IA (a IA conduz a conversa e chama
  // ferramentas determinísticas: salvar dados, qualificar, listar horários, agendar…).
  // Vazio = usa o prompt padrão. Os dados a coletar vêm dos fields do form vinculado.
  aiJourneyPrompt   String?  @db.Text
  // Ativação do chatbot: 'always' (qualquer mensagem inicia o fluxo — padrão atual) |
  // 'keyword' (só inicia quando a 1ª mensagem do lead CONTÉM uma das triggerKeywords;
  // fora disso vai para atendimento humano). Lead já em fluxo continua sempre.
  triggerMode       String   @default("always") @db.VarChar(20)
  triggerKeywords   Json?    @db.Json // string[] de palavras/frases que ativam o fluxo
  // Mensagem de boas-vindas ao INICIAR o agendamento (após qualificar). Tema do negócio,
  // objetiva e profissional. Variáveis: {{nome}} {{reuniao}}. Vazio = sem intro dedicada.
  schedulingIntro   String?  @db.Text
  funnelId          Int?
  funnel            Funnel?  @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  systemPrompt      String   @db.LongText
  extractionPrompt  String   @db.LongText
  analysisPrompt    String   @db.LongText
  greetingMessage   String   @db.Text
  completionMessage String   @db.Text
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Configuração genérica de scoring e análise
  scoringConfig   Json?   @db.Json // { pillars: [{key, name, weight, rules: [{field, value, points}]}], thresholds: [{max, label, color}], solutions: [...] }
  sentimentPrompt String? @db.LongText // Prompt customizado para análise de sentimento (usa template padrão se vazio)
  autoAnalysis    Boolean @default(true) // Gerar análise de sentimento/probabilidade automaticamente ao completar

  // Configurações de inatividade por chatbot
  inactivityEnabled          Boolean @default(false)
  inactivityAction           String  @default("notify") @db.VarChar(30) // notify | close | notify_then_close
  inactivityTimeoutMin       Int     @default(60)
  inactivityMessage          String? @db.Text
  inactivityCheckIntervalMin Int     @default(5)
  inactivityMaxRetries       Int     @default(2)
  inactivityCloseAfterMin    Int     @default(1440)

  // Roteamento padrão para setor (atendimento humano)
  defaultTeamId Int?
  defaultTeam   Team? @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)

  // Portal de matrícula vinculado — ao completar conversa, envia link pré-preenchido.
  enrollmentPortalId Int?

  questions ChatQuestion[]

  @@index([channel])
  @@index([active])
  @@index([funnelId])
  @@index([formId])
  @@index([defaultTeamId])
  @@index([enrollmentPortalId])
  @@map("bychat_chatbots")
}

model ChatQuestion {
  id        Int      @id @default(autoincrement())
  chatbotId Int
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  stage     Int      @default(0)
  position  Int      @default(0)
  fieldKey  String   @db.VarChar(100)
  text      String   @db.Text
  type      String   @default("text") @db.VarChar(30)
  options   Json?    @db.Json
  required  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatbotId])
  @@index([stage, position])
  @@map("bychat_chat_questions")
}

model WhatsAppInstance {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(191)
  instanceName  String   @unique @db.VarChar(100)
  phone         String?  @db.VarChar(30)
  chatbotId     Int?
  defaultTeamId Int?
  defaultTeam   Team?    @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)
  // Reforma F2 (2026-05-21): instância dedicada a um agente.
  // Quando preenchido, lead que chega por esta instância é atribuído direto
  // ao agente (bypass da cascata via setor). Coexiste com defaultTeamId;
  // convenção: ownerUserId ganha prioridade no roteamento.
  ownerUserId   Int?
  owner         User?    @relation("WhatsAppInstanceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  /// Quem enxerga as conversas deste número: `all` (qualquer um que já veja o
  /// lead) ou `restricted` (só os `viewers`, mais o superadmin e o agente dono).
  /// Existe para a linha PESSOAL que alguém conecta ao painel: sem isto, todo o
  /// histórico dela cai na visão de quem tem o setor.
  visibility    String   @default("all") @db.VarChar(12)
  viewers       WhatsAppInstanceViewer[]
  // Vários setores podem ser donos do mesmo número (recepção atendida por
  // Comercial + Suporte, por exemplo). `defaultTeamId` acima segue sendo o setor
  // ÚNICO — fica preenchido quando há exatamente um setor dono e nulo quando há
  // vários, o que faz o lead entrar sem setor e esperar a decisão do chatbot.
  teams         WhatsAppInstanceTeam[]
  // Funil dos leads do chatbot desta instância (só faz sentido com chatbotId).
  // Quando setado, leads do chatbot são promovidos a este funil/etapa, respeitando
  // as regras do form (qualificação/agendamento). Vazio = comportamento atual.
  funnelId      Int?
  funnel        Funnel?  @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  stageKey      String?  @db.VarChar(80)
  // Receber mensagens de GRUPOS de WhatsApp nesta conexão. OFF (default) = o
  // webhook descarta toda msg de grupo, como sempre fez. Ligar traz os grupos
  // do número para as Conversas; o chatbot NUNCA responde em grupo (seria spam
  // para todos os participantes). Só Evolution — a Cloud API oficial não expõe
  // os grupos reais do número.
  receiveGroups Boolean  @default(false)
  /// Cor de identificação do canal na operação. Paleta fechada (ver
  /// CANAL_CORES no front): cor livre gera tom que some no tema claro ou
  /// se confunde com a borda, e aí a identificação visual não cumpre o papel.
  color                String?  @db.VarChar(9)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([instanceName])
  @@index([active])
  @@index([defaultTeamId])
  @@index([ownerUserId])
  @@index([funnelId])
  @@map("bychat_whatsapp_instances")
}

/// Setores donos de um número Evolution. Existe porque um número de recepção é
/// atendido por mais de um setor, e o campo único `defaultTeamId` obrigava a
/// escolher um só — os demais setores ficavam sem poder responder por ele.
model WhatsAppInstanceTeam {
  id         Int              @id @default(autoincrement())
  instanceId Int
  teamId     Int
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([instanceId, teamId])
  @@index([teamId])
  @@map("bychat_whatsapp_instance_teams")
}

/// Setores donos de uma conexão Cloud API — paridade com WhatsAppInstanceTeam.
model CloudApiConnectionTeam {
  id           Int                @id @default(autoincrement())
  connectionId Int
  teamId       Int
  connection   CloudApiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([connectionId, teamId])
  @@index([teamId])
  @@map("bychat_cloud_api_connection_teams")
}

model Lead {
  id  Int     @id @default(autoincrement())
  uid String? @unique @db.VarChar(50) // Código único público (ex: LD-A3X9K2)

  empresa      String  @db.VarChar(191)
  nome         String  @db.VarChar(191)
  whatsapp     String  @db.VarChar(30)
  // Chave canônica do telefone (lib/phone.ts phoneKey): "55"+DDD+9+8 dígitos.
  // Colapsa todas as variações (com/sem 55, com/sem 9º dígito) numa só chave —
  // é a base do match EXATO de identidade do contato. null quando não há telefone
  // válido (ex.: contato só por LID). Indexada (não-única: o resolvedor central
  // de inbound dedupa na escrita; LID/vazios podem repetir).
  phoneKey     String? @db.VarChar(20)
  email        String  @db.VarChar(191)
  segmento     String? @db.VarChar(100)
  cidade       String? @db.VarChar(100)
  customFields Json?   @db.Json // {fieldKey: value, ...}

  formData    Json  @db.Json
  scores      Json  @db.Json
  analysis    Json? @db.Json
  aiSentiment Json? @db.Json

  solucaoNome String? @db.VarChar(100)
  maturidade  String? @db.VarChar(50)

  lastStep  Int     @default(0)
  completed Boolean @default(false)

  status    String  @default("NOVO") @db.VarChar(50)
  funnelId  Int?
  funnel    Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  chatbotId Int?

  // Atendimento humano: atribuição a operador e setor
  assignedUserId Int?
  assignedUser   User?     @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  teamId         Int?
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  // Lead Routing F10: marca a primeira ação efetiva do assignedUser após assignedAt
  // (hoje: Activity completed). Usado para calcular SLA de primeira resposta.
  firstResponseAt DateTime?

  unreadMessages Int       @default(0)
  lastMessageAt  DateTime?

  lastActivityAt     DateTime?
  inactiveNotifiedAt DateTime?

  // Tracking de origem / campanha
  source            String? @db.VarChar(50) // meta_lead_ads, whatsapp, web_form, web_chat, api, manual
  sourceId          String? @db.VarChar(191) // ID externo (meta lead id, etc)
  campaignId        String? @db.VarChar(191) // Meta campaign_id
  campaignName      String? @db.VarChar(191) // Nome da campanha
  adsetId           String? @db.VarChar(191) // Meta adset_id
  adsetName         String? @db.VarChar(191)
  adId              String? @db.VarChar(191) // Meta ad_id
  adName            String? @db.VarChar(191)
  metaFormId        String? @db.VarChar(191) // Meta form_id
  metaPageId        String? @db.VarChar(191) // Meta page_id
  utmSource         String? @db.VarChar(100)
  utmMedium         String? @db.VarChar(100)
  utmCampaign       String? @db.VarChar(191)
  utmContent        String? @db.VarChar(191)
  utmTerm           String? @db.VarChar(191)
  utmId             String? @db.VarChar(191) // utm_id da campanha (ID Meta/Google p/ cruzar com a API)
  trackingVisitorId String? @db.VarChar(64) // Vincula com visitor de tracking

  // Google Ads — atribuição por lead (ValueTrack na URL + enriquecimento por gclid via click_view).
  // Espelha o padrão Meta (campaignId/adsetId/adId), mas em colunas próprias p/ não
  // colidir com a semântica Meta dos campos acima. IDs vêm do ValueTrack; os NOMES
  // (Name) e a keyword vêm do enriquecimento server-side (googleAdsClickEnrich).
  googleCampaignId   String?   @db.VarChar(191)
  googleCampaignName String?   @db.VarChar(191)
  googleAdGroupId    String?   @db.VarChar(191) // ≈ adset da Meta (grupo de anúncios)
  googleAdGroupName  String?   @db.VarChar(191)
  googleAdId         String?   @db.VarChar(191) // {creative}
  googleKeyword      String?   @db.VarChar(255) // palavra-chave que acionou o anúncio ({keyword} / click_view)
  googleMatchType    String?   @db.VarChar(30)  // exact | phrase | broad
  googleNetwork      String?   @db.VarChar(30)  // search | display | youtube | ...
  googleDevice       String?   @db.VarChar(30)  // mobile | desktop | tablet
  googleEnrichedAt   DateTime? // quando o enriquecimento por gclid resolveu os nomes/keyword

  // Rastreamento inteligente (Fase 7)
  originType       String?   @db.VarChar(50) // trackable_link, meta_ctwa, google_ads, meta_lead_ads, organic, web_form, manual
  gclid            String?   @db.VarChar(191) // Google Click ID
  fbclid           String?   @db.VarChar(255) // Meta Click ID (fbclid) — landing/site
  ctwaClid         String?   @db.VarChar(191) // Meta Click-to-WhatsApp Click ID
  trackableLinkId  Int? // Link rastreável de origem
  saleDetected     Boolean   @default(false) // Flag de venda detectada
  saleValue        Decimal?  @db.Decimal(12, 2) // Valor da última venda detectada
  saleDetectedAt   DateTime? // Quando a venda foi detectada
  lastSaleAnalysis DateTime? // Última análise de venda por IA

  profilePicUrl String? @db.Text // URL da foto de perfil do WhatsApp
  annotation    String? @db.Text // Anotação interna dos operadores (visível a todos)

  // JID @lid observado quando WhatsApp entrega LID (Linked ID) em vez do número real.
  // Permite associar mensagens recebidas ao lead certo mesmo sem conseguir resolver pro phone.
  waLid String? @db.VarChar(100)

  // ── Identidade do contato: de onde veio o nome ──
  // `nome` é o que o sistema mostra em todo lugar. Antes ele nascia do
  // `pushName` — o nome que o CONTATO escolheu no WhatsApp dele —, então a
  // empresa via "Zé da Obra 🔨" no lugar do nome que ela mesma cadastrou.
  // Agora o pushName fica guardado à parte (referência, nunca identidade), o
  // nome que a empresa salvou na agenda do aparelho conectado vem do sync da
  // Evolution, e `nomeOrigem` diz quem venceu — é ele que impede um sync de
  // passar por cima do que um humano digitou.
  /// Nome que a EMPRESA salvou na agenda do celular conectado via QR Code.
  nomeWhatsappAgenda String? @db.VarChar(191)
  /// Nome que o CONTATO escolheu no WhatsApp dele (só referência).
  pushName           String? @db.VarChar(191)
  /// manual | formulario | import | agenda | pushname | telefone | grupo
  nomeOrigem         String? @db.VarChar(20)

  // ── Conversa de GRUPO de WhatsApp (só Evolution) ──
  // Grupo NÃO é pessoa: fica fora do chatbot, do enriquecimento e do score de IA,
  // e não entra no resolvedor de identidade por telefone/nome (contactIdentity).
  // Só existe quando a conexão está com `receiveGroups` ligado.
  isGroup  Boolean @default(false)
  // JID do grupo ("<id>@g.us"): identidade do grupo (não há telefone) e destino
  // de envio. É a chave de dedup do inbound de grupo.
  groupJid String? @db.VarChar(64)

  // Enriquecimento / LGPD
  lgpdConsent       Boolean   @default(false) // autoriza enriquecimento de dados públicos
  lgpdConsentAt     DateTime? // quando o consentimento foi registrado
  lgpdConsentSource String?   @db.VarChar(30) // titular | operator_override | legacy (null = desconhecido)
  lgpdConsentBy     Int? // userId do operador, quando origem foi operator_override
  enrichmentStatus  String?   @db.VarChar(20) // pending, running, partial, done, failed
  enrichmentScore   Int? // 0-100, confiança do dossiê consolidado
  enrichedAt        DateTime? // última execução do enriquecimento

  // Qualificação: separa "lead real" (contato com intenção comercial — form, portal,
  // ads, manual, fim de chatbot/diagnóstico) de "apenas conversa" (mensagem WhatsApp
  // ad-hoc sem origem qualificada). null = só conversa; preenchido = lead pra valer.
  // Conversas mostram tudo; relatórios/funil/kanban filtram por qualifiedAt != null.
  qualifiedAt         DateTime? // quando virou lead qualificado
  qualificationSource String?   @db.VarChar(40) // form, enrollment_portal, meta_lead_ads, make, api, manual, chatbot_completed, web_chat_completed

  // Conversation = atendimento ativo no módulo Conversas. Ticket só existe quando
  // operador (ou regra) abre conscientemente. Mensagens recebidas SEM conversa
  // aberta ficam na "Caixa de entrada bruta" do módulo Conversas, sem virar ticket
  // (evita banco/amigo/spam virarem atendimento). Receber mensagem em conversa
  // fechada (closedAt > openedAt) reabre o ticket.
  conversationOpenedAt DateTime?
  conversationClosedAt DateTime?

  // Snooze (adiar atendimento). NULL = ativo; data futura = oculto da inbox/raw
  // até passar a hora. Aparece na bucket "Aguardando" e mostra banner no chat.
  snoozedUntil DateTime?

  // Opt-out / Central de Preferências (Sales Engagement A2).
  // optOutChannels: lista de canais bloqueados, ex: ["email","sms"]. NULL = nada bloqueado.
  // optOutToken: token único do lead pra acessar /preferencias/:token (público sem auth).
  optOutChannels Json?   @db.Json
  optOutToken    String? @unique @db.VarChar(64)

  // Priority score (Sales Engagement C1) — 0-100. Composto: fit + intent + urgency.
  // Recalculado por cron 5min (C2) ou on-event. Operador vê fila ranqueada por este campo.
  priorityScore   Float?
  priorityScoreAt DateTime?

  // Lead Score preditivo por IA (0-100): probabilidade de fechar negócio.
  // Calculado na entrada (provisório, evento lead.created) e refinado quando
  // o enriquecimento termina (definitivo, evento enrichment.completed),
  // usando canal de origem + dados + dossiê de enriquecimento + Contexto do
  // Negócio (Setting grp 'business'). aiScoreReason guarda rationale/sinais.
  aiScore       Int?
  aiScoreLabel  String?  @db.VarChar(10)   // 'hot' | 'warm' | 'cold'
  aiScoreReason Json?
  aiScoredAt    DateTime?

  // Jornada Automática por IA: quando o lead foi classificado pela última vez.
  // Gravado SEMPRE que a análise roda até o fim — inclusive quando o veredito é
  // "já está na etapa certa" e nenhuma sugestão nasce. É o que sustenta o
  // cooldown (não reanalisar em rajada) e o "só reanalisa se houve mensagem
  // nova": basta comparar com `lastMessageAt`.
  aiStageAnalyzedAt DateTime?

  // Outcome (Fase 23): classificação manual do lead pelo operador.
  // null = em andamento; 'won' = convertido (Ganho); 'lost' = sem fit / disse não (Perdido).
  // Marca explicita pra parar cadências/activities e fechar o ciclo de vida comercial.
  outcome       String?  @db.VarChar(10)
  outcomeAt     DateTime?
  outcomeBy     Int?     // userId que classificou
  outcomeNote   String?  @db.Text
  lostReasonId  Int?
  lostReason    LossReason? @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  // ── Resumo (módulo status_summary) ──
  // Classificação da SITUAÇÃO do atendimento (ex.: AT-200 SOLICITOU MATRICULA).
  // O operador escolhe o resumo e o motor deriva etapa, atividades, prazos e
  // outcome. Ver services/statusSummaryEngine.ts.
  statusSummaryId Int?
  statusSummary   StatusSummary? @relation(fields: [statusSummaryId], references: [id], onDelete: SetNull)
  statusSummaryAt DateTime?

  // Dedup (Fase 24, Categoria A): cada submissão de Form/Meta/EnrollmentPortal/API/Make
  // cria um Lead novo. Quando há match com lead existente (por whatsapp ou email),
  // marca este lead como pending_review apontando pro candidato master. Decisão de
  // mesclar (mergeLeads) ou manter separado é do operador na tela /app/leads/duplicates.
  // Categoria B (WhatsApp/Telegram/Instagram) continua com upsert por identidade
  // pra não quebrar inbox/conversação contínua.
  possibleDuplicateOfId Int?
  possibleDuplicateOf   Lead?   @relation("DuplicateOf", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  duplicatesOfThis      Lead[]  @relation("DuplicateOf")
  // 'none' (default), 'pending_review', 'merged', 'kept_separate'
  duplicateStatus       String  @default("none") @db.VarChar(20)
  // 'whatsapp' | 'email' — qual chave casou com o master
  duplicateMatchedBy    String? @db.VarChar(20)
  duplicateFlaggedAt    DateTime?
  duplicateResolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages                 Message[]
  events                   LeadEvent[]
  activities               Activity[]
  attachments              LeadAttachment[]
  notes                    LeadNote[]
  tags                     LeadTag[]
  detectedSales            DetectedSale[]
  enrichments              LeadEnrichment[]
  educationalRegistrations ProcessRegistration[]
  enrollmentRegistrations  EnrollmentRegistration[]
  cadenceEnrollments       CadenceEnrollment[]
  outboundSends            OutboundSend[]
  stageMovements           LeadStageMovement[]
  statusHistory            LeadStatusHistory[]
  conversationAudits       ConversationAudit[]
  stageSuggestions         LeadStageSuggestion[]
  transferRequests         LeadTransferRequest[]
  aluno                    Aluno?                // Módulo Acadêmico (1:1) — Pessoa = Contato

  bookings       Booking[]

  // Busca por telefone é o caminho quente do produto (todo webhook de WhatsApp
  // resolve o lead por aqui) e fazia full scan.
  @@index([whatsapp])
  @@index([status])
  @@index([createdAt])
  @@index([segmento])
  @@index([email])
  @@index([funnelId])
  @@index([completed, lastActivityAt])
  @@index([lastMessageAt])
  @@index([snoozedUntil])
  @@index([source])
  @@index([sourceId])
  @@index([metaFormId])
  @@index([originType])
  @@index([saleDetected])
  @@index([trackableLinkId])
  @@index([enrichmentStatus])
  @@index([assignedUserId])
  @@index([teamId])
  @@index([waLid])
  @@index([phoneKey])
  @@index([groupJid])
  @@index([isGroup])
  @@index([qualifiedAt])
  @@index([firstResponseAt])
  @@index([conversationOpenedAt, conversationClosedAt])
  @@index([outcome])
  @@index([outcome, outcomeAt])
  @@index([outcome, lostReasonId, outcomeAt])
  @@index([duplicateStatus])
  @@index([possibleDuplicateOfId])
  @@index([aiScore])
  @@index([googleCampaignId])
  @@index([statusSummaryId])
  @@index([statusSummaryId, statusSummaryAt])
  scheduledMessages ScheduledMessage[]
  chatImportJobs    ChatImportJob[]

  conversationPins ConversationPin[]

  @@map("bychat_leads")
}

// Catálogo configurável de motivos de perda (Fase 23).
model LossReason {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(20)   // hex ou nome semântico
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([active, position])
  @@map("bychat_loss_reasons")
}

// Histórico de transições de stage/funil do lead.
// Alimenta o Relatório de Funil (volume por etapa, taxa de conversão por
// período, custo por etapa, drill-down). É append-only: cada chamada do
// helper recordLeadStageMovement insere um registro novo.
//
// Idempotência: helper faz no-op quando from === to (mesmo funnelId+stageKey).
// Movimento inicial (criação do lead já em uma stage) registra com
// fromFunnelId=null, fromStageKey=null.
model LeadStageMovement {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromFunnelId Int?
  toFunnelId   Int?
  fromStageKey String? @db.VarChar(50)
  toStageKey   String? @db.VarChar(50)

  movedAt       DateTime @default(now())
  movedByUserId Int?
  movedByUser   User?    @relation("LeadStageMovementBy", fields: [movedByUserId], references: [id], onDelete: SetNull)

  // 'panel' | 'webhook' | 'workflow' | 'chatbot' | 'manual' | 'make' |
  // 'evaluation' | 'doc_review' | 'outcome' | 'meta_lead_ads' | 'bulk' | 'api'
  source   String? @db.VarChar(30)
  reason   String? @db.VarChar(255)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([leadId, movedAt])
  @@index([toStageKey, movedAt])
  @@index([toFunnelId, movedAt])
  @@index([movedAt])
  @@map("bychat_lead_stage_movements")
}

// ═══════════════════════════════════════════════════════════════
// MÓDULO RESUMO (status_summary)
//
// Inverte o kanban: em vez de arrastar o card, o operador classifica a
// SITUAÇÃO do atendimento escolhendo um Resumo (ex.: "AT-200 SOLICITOU
// MATRICULA"). O motor deriva o resto — move de etapa/funil, gera as
// atividades certas com prazo e responsável, marca ganho/perdido e exige a
// objeção. Isso elimina a subjetividade do registro: dois consultores na
// mesma situação produzem o mesmo estado no CRM.
//
// Motor: services/statusSummaryEngine.ts (ponto de entrada único).
// ═══════════════════════════════════════════════════════════════

model StatusSummary {
  id       Int     @id @default(autoincrement())
  // Código estável e visível ao operador (é como o time fala: "põe o AT-200").
  // Único por funil — funis diferentes podem reusar o mesmo código.
  code     String  @db.VarChar(20)
  name     String  @db.VarChar(191)
  helpText String? @db.Text // quando usar este resumo (vira tooltip no painel)

  // Catálogo é POR FUNIL. `funnelId` null = resumo global, disponível em todos
  // os funis que não tenham catálogo próprio. Resolução: específico > global.
  funnelId Int?
  funnel   Funnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  // Setor dono do resumo — é o prefixo do código no vocabulário do cliente
  // (AT = atendimento, DC = documentação/conversão, SE = secretaria).
  sector   String? @db.VarChar(10)
  color    String? @db.VarChar(20)
  position Int     @default(0)
  active   Boolean @default(true)

  // ── EFEITOS ──
  // Etapa/funil de destino. Ambos null = resumo que só marca situação sem mover
  // (ex.: AT-003 AGUARDANDO RESPOSTA, que mantém o lead em Follow Up).
  targetFunnelId Int?
  targetStageKey String? @db.VarChar(50)

  // 'won' | 'lost' — delega pra services/leadOutcome.ts (que já cancela
  // atividades e cadências abertas). null = não mexe no outcome.
  setOutcome          String? @db.VarChar(10)
  requireLossReason   Boolean @default(false) // painel obriga escolher objeção
  defaultLossReasonId Int?

  temperature String? @db.VarChar(10) // quente | morno | frio

  // Conclui as atividades pendentes do lead antes de gerar as novas. É o
  // "conclui a atividade em aberto e altera o resumo" que o manual repete.
  closeOpenActivities Boolean @default(false)

  // Em vez de gerar atividade avulsa, inscreve o lead numa cadência existente.
  // Reusa SalesCadence — não reimplementamos escada de follow-up.
  enrollCadenceId Int?

  // ── ESCADA AUTOMÁTICA ──
  // Próximo resumo da escada (AT-020 → AT-021 → AT-022 → AT-023). Quando
  // `autoAdvanceOnDue` é true, o cron aplica `nextSummaryCode` sozinho assim que
  // a atividade gerada vence sem o lead ter interagido. No Rubeus isso é manual:
  // é onde passamos a régua deles.
  nextSummaryCode  String? @db.VarChar(20)
  autoAdvanceOnDue Boolean @default(false)

  // ── GOVERNANÇA ──
  // ["follow_up","sem_resposta"] = só pode ser aplicado a partir destas etapas.
  // null/vazio = sem restrição. Evita o consultor pular degraus da escada.
  allowedFromStages Json?
  // ["forma_pagamento","qtd_parcelas"] — chaves de CustomField que precisam
  // estar preenchidas antes de aplicar. É o que impede o AT-200 sem dados.
  requiredFields    Json?

  activities StatusSummaryActivity[]
  leads      Lead[]
  history    LeadStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funnelId, code])
  @@index([active, position])
  @@index([funnelId, active])
  @@index([code])
  @@map("bychat_status_summaries")
}

// Catálogo de atividades padronizadas (AT-WP-06, SE-IL-02...). Sem ele o título
// da atividade é texto livre e não existe KPI por tipo de atividade.
model ActivityTemplate {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20) // "AT-WP-06"
  name     String  @db.VarChar(191) // "COBRANCA DE TAXA DE MATRICULA/CONTRATO"
  // Descrição padrão da atividade (o "resumo da atividade" do Rubeus).
  defaultDescription String? @db.Text

  // Mapeia direto em Activity.type — o sufixo do código já diz o canal
  // (-WP- whatsapp, -EM- email, -LI- call, -ST-/-IL- task).
  type String @db.VarChar(30)

  messageTemplateId Int?
  messageTemplate   MessageTemplate? @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)

  // ── PRAZO ──
  // immediate      → agora
  // hours / days   → dueValue corridos
  // business_days  → dueValue em dias úteis (usa services/businessHours.ts)
  // lead_defined   → o operador informa a data (lead pediu "me chama dia 20")
  dueMode  String @default("immediate") @db.VarChar(20)
  dueValue Int    @default(0)

  // ── RESPONSÁVEL ──
  // lead_owner  → assignedUserId do lead
  // team        → fila do setor (assigneeTeamId), sem dono
  // user        → pessoa fixa (assigneeUserId)
  // round_robin → rodízio entre membros do assigneeTeamId
  // creator     → quem aplicou o resumo
  assigneeMode   String @default("lead_owner") @db.VarChar(20)
  assigneeTeamId Int?
  assigneeTeam   Team?  @relation(fields: [assigneeTeamId], references: [id], onDelete: SetNull)
  assigneeUserId Int?
  assigneeUser   User?  @relation("ActivityTemplateAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  summaries StatusSummaryActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([type])
  @@map("bychat_activity_templates")
}

// Quais atividades cada resumo dispara. O prazo do template pode ser
// sobrescrito aqui: o mesmo AT-WP-06 vence em 24h no DC-003 e em 7 dias no
// AT-035 — é a mesma atividade, cobrada em ritmo diferente.
model StatusSummaryActivity {
  summaryId          Int
  summary            StatusSummary    @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  activityTemplateId Int
  activityTemplate   ActivityTemplate @relation(fields: [activityTemplateId], references: [id], onDelete: Cascade)

  dueOverrideMode  String? @db.VarChar(20)
  dueOverrideValue Int?
  // Sobrescreve o "resumo da atividade" (ex.: "Cobrança – Tentativa 02").
  titleOverride    String? @db.VarChar(191)
  order            Int     @default(0)

  @@id([summaryId, activityTemplateId])
  @@index([activityTemplateId])
  @@map("bychat_status_summary_activities")
}

// Append-only, mesmo padrão de LeadStageMovement. É o que permite medir
// conversão POR RESUMO (ex.: quantos AT-030 viram AT-200 vs AT-033) e o tempo
// médio em cada degrau da escada.
model LeadStatusHistory {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromSummaryId Int?
  toSummaryId   Int
  toSummary     StatusSummary @relation(fields: [toSummaryId], references: [id], onDelete: Cascade)

  // Snapshot dos códigos: o catálogo pode ser editado/renomeado depois, e o
  // histórico precisa continuar legível.
  fromCode String? @db.VarChar(20)
  toCode   String  @db.VarChar(20)

  changedAt       DateTime @default(now())
  changedByUserId Int?
  changedByUser   User?    @relation("LeadStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  // panel | workflow | chatbot | api | auto_advance | import | seed
  source String? @db.VarChar(30)
  note   String? @db.Text
  // O que o motor de fato fez: etapa movida, atividades criadas, outcome.
  effects Json?

  @@index([leadId, changedAt])
  @@index([toSummaryId, changedAt])
  @@index([changedAt])
  @@map("bychat_lead_status_history")
}

model LeadEnrichment {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  source     String @db.VarChar(50) // gravatar, brasilapi, viacep, phone, google, hunter, github, instagram, facebook, linkedin
  field      String @db.VarChar(80) // email, phone, photo_url, linkedin_url, instagram_url, company_name, cnpj, address, position, etc.
  value      String @db.Text // valor coletado (string, URL, JSON stringified)
  confidence Float  @default(0.5) // 0.0 - 1.0
  rawData    Json?  @db.Json // payload bruto do provider (debug/auditoria)
  status     String @default("active") @db.VarChar(20) // active, merged, rejected, stale

  fetchedAt DateTime  @default(now())
  expiresAt DateTime? // cache TTL por registro

  @@index([leadId])
  @@index([source])
  @@index([field])
  @@index([leadId, field])
  @@map("bychat_lead_enrichment")
}

model Message {
  id          Int      @id @default(autoincrement())
  leadId      Int
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromMe      Boolean  @default(false)
  body        String   @db.LongText
  mediaType   String   @default("text") @db.VarChar(30)
  mediaUrl    String?  @db.Text
  mediaName   String?  @db.VarChar(191)
  /// Quando o WhatsApp deixou de entregar o arquivo desta mensagem. O CDN
  /// expira a mídia (a URL traz `oe=<validade>`) e a partir daí nenhuma
  /// tentativa funciona — insistir só gasta segundos contra a Evolution.
  mediaUnavailableAt DateTime?
  ack         Int      @default(0)
  isDeleted   Boolean  @default(false)
  isInternal  Boolean  @default(false)

  // ── Editar / apagar / encaminhar / reagir (paridade com o WhatsApp) ──
  /// Quando a mensagem foi editada pela última vez. O WhatsApp só aceita
  /// edição até 15 minutos depois do envio, e só de mensagem nossa.
  editedAt      DateTime?
  /// Texto anterior à primeira edição. O WhatsApp não guarda isso; aqui guarda
  /// porque conversa de atendimento vira prova em reclamação e em auditoria.
  originalBody  String?  @db.LongText
  /// Apagada para todos (revoke). Diferente de `isDeleted`: aqui a mensagem
  /// sumiu também no aparelho do contato, e a bolha vira "mensagem apagada".
  deletedForAll Boolean  @default(false)
  deletedAt     DateTime?
  /// Quem apagou pelo painel. Null quando foi o contato quem apagou.
  deletedByUserId Int?
  /// Chegou aqui por encaminhamento feito no painel.
  isForwarded   Boolean  @default(false)
  /// Reações no formato [{ emoji, fromMe, senderName, at }]. Guardadas na
  /// própria mensagem: reação não é mensagem, é estado dela.
  reactions     Json?    @db.Json

  provider    String   @default("evolution") @db.VarChar(20) // evolution | cloud_api
  // Origem real da mensagem (qual número/canal) — distingue conversas de
  // números diferentes no módulo Conversas. Preenchido nos webhooks/envio.
  evolutionInstance    String?  @db.VarChar(100) // instanceName quando provider='evolution'
  cloudApiConnectionId Int? // FK quando provider='cloud_api'
  cloudApiConnection   CloudApiConnection? @relation(fields: [cloudApiConnectionId], references: [id], onDelete: SetNull)
  senderName  String?  @db.VarChar(100)
  /// JID de quem enviou, quando a conversa é de GRUPO. O WhatsApp exige esse
  /// `participant` para agir sobre a mensagem de outra pessoa (reagir, apagar):
  /// sem ele, só o id não identifica a mensagem dentro do grupo.
  senderJid   String?  @db.VarChar(100)
  externalId  String?  @db.VarChar(191)
  quotedMsgId Int?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId, timestamp])
  @@index([externalId])
  @@index([cloudApiConnectionId])
  @@map("bychat_messages")
}

// Histórico de anotações internas do lead. Substitui o campo Lead.annotation
// (single-value) por uma lista append-only com autor + timestamp — operadores
// veem tudo que foi registrado ao longo do tempo.
/// Conversa fixada no topo da lista.
///
/// É POR OPERADOR, não do lead: cada pessoa fixa o que está acompanhando hoje,
/// e fixar para todo mundo bagunçaria a fila dos colegas. Mesma lógica do
/// WhatsApp, onde a fixação vale para a conta que fixou.
model ConversationPin {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, leadId])
  @@index([userId, createdAt])
  @@map("bychat_conversation_pins")
}

model LeadNote {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId   Int? // operador que escreveu (null = legacy/sistema)
  userName String? @db.VarChar(100) // snapshot do nome no momento — sobrevive a delete/rename
  content  String  @db.Text

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("bychat_lead_notes")
}

model LeadEvent {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type     String  @db.VarChar(50) // ex: lead_created, status_changed, message_sent, etc.
  category String  @db.VarChar(30) // lifecycle, communication, operator, system, integration
  channel  String? @db.VarChar(30) // whatsapp, web_chat, web_form, api, system, manual
  source   String? @db.VarChar(50) // ex: webhook, panel, chatbot, inactivity_service

  userId    Int? // operador que executou (null = sistema/lead)
  userName  String? @db.VarChar(100) // nome/email do operador
  actorType String  @default("system") @db.VarChar(20) // lead, operator, system, ai, integration

  title       String  @db.VarChar(191) // título curto do evento
  description String? @db.Text // descrição detalhada
  oldValue    String? @db.Text // valor anterior (para mudanças)
  newValue    String? @db.Text // novo valor (para mudanças)
  metadata    Json?   @db.Json // dados extras estruturados

  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([leadId, type])
  @@index([leadId, category])
  @@index([type])
  @@index([createdAt])
  @@map("bychat_lead_events")
}

model Activity {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId   Int? // quem criou
  userName String? @db.VarChar(100) // nome/email de quem criou

  // ── Responsável pela EXECUÇÃO (módulo Resumo) ──
  // `userId` acima é quem CRIOU. Quando o motor gera a atividade para outro
  // setor (handoff Comercial → Secretaria), quem executa vai aqui.
  assignedUserId Int?
  assignedUser   User? @relation("ActivityAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeamId Int?
  assignedTeam   Team? @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)

  // Código do ActivityTemplate que originou a atividade (ex.: "AT-WP-06").
  templateCode String? @db.VarChar(20)

  type        String  @db.VarChar(30) // whatsapp, email, sms, call, meeting, task, note, follow_up
  title       String  @db.VarChar(191)
  description String? @db.Text
  status      String  @default("pending") @db.VarChar(20) // pending, completed, cancelled, overdue, sent, failed

  scheduledAt DateTime // quando executar/lembrar
  completedAt DateTime? // quando foi concluida
  reminderAt  DateTime? // lembrete antes do agendamento

  // Dados para envio automatico
  recipientPhone String? @db.VarChar(30) // numero destino (whatsapp/sms)
  recipientEmail String? @db.VarChar(191) // email destino
  messageBody    String? @db.LongText // corpo da mensagem (texto ou HTML)
  messageSubject String? @db.VarChar(191) // assunto (email)
  templateId     Int? // template usado (referencia)

  // Anexos
  attachmentUrl  String? @db.Text // URL do arquivo anexo (PDF, imagem, etc)
  attachmentName String? @db.VarChar(191) // nome original do arquivo
  attachmentType String? @db.VarChar(50) // mime type (application/pdf, image/png, etc)

  metadata Json?   @db.Json // dados extras
  result   String? @db.Text // resultado da execucao

  // E-mail (Gmail): direção e correlação de thread, para registrar a conversa
  // de e-mail (enviados + respostas) como Atividades. direction null = legado/saída.
  direction      String? @db.VarChar(10)  // 'inbound' | 'outbound'
  gmailThreadId  String? @db.VarChar(255) // threadId do Gmail (correlaciona resposta ao enviado)
  gmailMessageId String? @db.VarChar(255) // id da mensagem no Gmail (dedup)

  // Anexos múltiplos por atividade (prints, documentos etc.) — modelo LeadAttachment.
  // Diferente dos campos legados acima (attachmentUrl/Name/Type) que comportam só
  // 1 arquivo via URL externa.
  attachments LeadAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, status])
  @@index([leadId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([userId])
  @@index([type])
  @@index([scheduledAt])
  @@index([gmailThreadId])
  @@index([gmailMessageId])
  @@index([assignedUserId, status])
  @@index([assignedTeamId, status])
  @@index([templateCode, status])
  @@map("bychat_activities")
}

// Anexos de uma atividade (prints de WhatsApp físico, documentos enviados etc.).
// SEMPRE vinculados a uma Activity (FK obrigatória) — não existem anexos soltos.
// `leadId` é denormalização para queries por lead direto, sem JOIN. Quando a
// Activity é excluída, os anexos caem junto (cascade).
model LeadAttachment {
  id         Int      @id @default(autoincrement())
  leadId     Int
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  fileName    String @db.VarChar(255) // nome original do arquivo
  fileSize    Int                     // bytes
  mimeType    String @db.VarChar(120)
  storagePath String @db.VarChar(255) // caminho relativo a /uploads (ex: lead-attachments/123-xxxx.png)

  uploadedById   Int?
  uploadedByName String? @db.VarChar(100)
  description    String? @db.Text

  createdAt DateTime @default(now())

  @@index([activityId])
  @@index([leadId, createdAt])
  @@index([uploadedById])
  @@map("bychat_lead_attachments")
}

model MessageTemplate {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(191) // nome de exibição (editável livremente pelo usuário)
  // Chave ESTÁVEL para referência por código (ex.: agendamento_confirmado_wa). Não
  // muda quando o usuário renomeia o `name`. Null para templates criados à mão.
  key            String?  @db.VarChar(80)
  // Atalho do Conversas: digitar "/" + shortcut no compositor sugere/insere este
  // template (ex.: shortcut "doc" → "/doc"). Sem "/". Opcional e único por uso.
  shortcut       String?  @db.VarChar(40)
  channel        String   @db.VarChar(30) // whatsapp, email, sms
  category       String   @default("general") @db.VarChar(50) // general, proposal, follow_up, onboarding, report, reminder
  subject        String?  @db.VarChar(191) // assunto (email)
  body           String   @db.LongText // corpo com variaveis {{nome}}, {{empresa}}, etc
  bodyHtml       String?  @db.LongText // versao HTML (email)
  attachmentUrl  String?  @db.Text // anexo padrao (URL)
  attachmentName String?  @db.VarChar(191)
  // Tipo do anexo, definido no upload. Antes o Conversas adivinhava pela
  // extensão do nome na hora de enviar — arquivo sem extensão ou com uma
  // incomum (.jfif) virava documento e chegava errado ao contato.
  attachmentType String?  @db.VarChar(20) // image | video | audio | document
  // Composição da mensagem (canal não-oficial). Botão de verdade só existe na
  // Cloud API — a Evolution lança erro em mensagem interativa —, então aqui as
  // opções viram lista numerada no fim do texto, que é como o chatbot já as
  // entrega quando o canal não é oficial.
  header         String?  @db.VarChar(120) // linha de destaque antes do corpo
  footer         String?  @db.VarChar(120) // assinatura/observação no fim
  options        Json?  @db.Json         // string[] — vira "1) …" no envio
  variables      Json?    @db.Json // lista de variaveis usadas [{key, label, default}]
  active         Boolean  @default(true)
  usageCount     Int      @default(0) // quantas vezes foi usado
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cadenceSteps CadenceStep[]

  @@index([channel])
  @@index([category])
  @@index([active])
  @@index([key])
  @@index([shortcut])
  activityTemplates ActivityTemplate[]
  scheduledMessages ScheduledMessage[]

  @@map("bychat_message_templates")
}

// ─── WhatsApp Cloud API (Oficial Meta) ───────────────────

/// Quem pode ver as conversas de uma instância reservada (`visibility` =
/// `restricted`). Superadmin e o agente dono não precisam de linha aqui.
model WhatsAppInstanceViewer {
  id         Int              @id @default(autoincrement())
  instanceId Int
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId     Int
  user       User             @relation("WhatsAppInstanceViewerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([instanceId, userId])
  @@index([userId])
  @@map("bychat_whatsapp_instance_viewers")
}

/// Mesmo papel do anterior, para um número da API Oficial.
model CloudApiConnectionViewer {
  id           Int                @id @default(autoincrement())
  connectionId Int
  connection   CloudApiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       Int
  user         User               @relation("CloudApiConnectionViewerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([connectionId, userId])
  @@index([userId])
  @@map("bychat_cloud_api_connection_viewers")
}

model CloudApiConnection {
  id              Int       @id @default(autoincrement())
  wabaId          String    @unique @db.VarChar(100) // WhatsApp Business Account ID
  phoneNumberId   String    @unique @db.VarChar(100) // Phone Number ID (Meta)
  displayPhone    String?   @db.VarChar(30) // Numero formatado para exibicao
  businessId      String?   @db.VarChar(100) // Meta Business Portfolio ID
  systemUserToken String    @db.Text // Token criptografado AES-256-GCM
  tokenExpiresAt  DateTime? // null = nunca expira (System User Token)
  verifyToken     String    @db.VarChar(191) // Token de verificacao do webhook
  chatbotId       Int? // Chatbot auto-assign para mensagens recebidas
  // Paridade com WhatsAppInstance: roteamento por setor/agente da conexão.
  defaultTeamId   Int? // Setor padrão dos leads que chegam por esta conexão
  defaultTeam     Team?     @relation("CloudApiDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  // Reforma F2: conexão dedicada a um agente — lead é atribuído direto a ele
  // (bypass da cascata por setor). ownerUserId tem prioridade no roteamento.
  ownerUserId     Int?
  owner           User?     @relation("CloudApiConnectionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  /// Quem enxerga as conversas deste número — ver WhatsAppInstance.visibility.
  visibility         String               @default("all") @db.VarChar(12)
  viewers            CloudApiConnectionViewer[]
  // Vários setores donos do mesmo número — ver WhatsAppInstance.teams.
  teams              CloudApiConnectionTeam[]
  // Funil dos leads do chatbot desta conexão (só faz sentido com chatbotId).
  // Quando setado, leads do chatbot são promovidos a este funil/etapa, respeitando
  // as regras do form (qualificação/agendamento). Vazio = comportamento atual.
  funnelId        Int?
  funnel          Funnel?   @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  stageKey        String?   @db.VarChar(80)
  displayName     String?   @db.VarChar(191) // Nome do WABA
  qualityRating   String?   @db.VarChar(20) // GREEN, YELLOW, RED
  messagingLimit  String?   @db.VarChar(50) // Tier: 1K, 10K, 100K, UNLIMITED
  /// Cor de identificação do canal na operação. Paleta fechada (ver
  /// CANAL_CORES no front): cor livre gera tom que some no tema claro ou
  /// se confunde com a borda, e aí a identificação visual não cumpre o papel.
  color                String?  @db.VarChar(9)
  active          Boolean   @default(true)
  metadata        Json?     @db.Json
  messages        Message[]
  messageLogs     CloudApiMessageLog[]
  broadcastCampaigns BroadcastCampaign[]
  flows           CloudApiFlow[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
  @@index([phoneNumberId])
  @@index([defaultTeamId])
  @@index([ownerUserId])
  @@index([funnelId])
  @@map("bychat_cloud_api_connections")
}

// Permissão de chamada de voz (opt-in) por consumidor — WhatsApp Business Calling API.
// Chamadas business-initiated exigem que o usuário tenha concedido permissão.
// Atualizada pelo webhook (call_permission_update) e consultada antes de ligar (saída).
model WaCallPermission {
  id            Int       @id @default(autoincrement())
  phone         String    @db.VarChar(30) // wa_id / telefone E.164 sem +
  phoneNumberId String    @db.VarChar(100) // número business (Cloud API)
  status        String    @db.VarChar(30) // no_permission | temporary | permanent
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([phone, phoneNumberId])
  @@index([phone])
  @@map("bychat_wa_call_permissions")
}

// F3 — WhatsApp Flows estáticos: formulário nativo do WhatsApp (tela única) gerado
// a partir de um Form. flowJson é o Flow JSON publicado na Meta; metaFlowId é o id
// retornado pela Meta após publicar. Sem endpoint/criptografia (respostas voltam de
// uma vez no nfm_reply).
model CloudApiFlow {
  id           Int                @id @default(autoincrement())
  connectionId Int
  connection   CloudApiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  formId       Int? // form de origem (referência solta, sem FK)
  metaFlowId   String?            @db.VarChar(100) // id do Flow na Meta (após publicar)
  name         String             @db.VarChar(191)
  status       String             @default("draft") @db.VarChar(30) // draft | published | error
  flowJson     Json               @db.Json
  screenId     String             @default("INTAKE") @db.VarChar(60)
  // Config editável pelo editor visual (desacoplada do form). Vazio = defaults.
  cta          String?            @db.VarChar(40) // texto do botão (flow_cta)
  bodyText     String?            @db.Text // mensagem que acompanha o Flow
  screenTitle  String?            @db.VarChar(60) // título da tela do formulário
  fieldConfig  Json?              @db.Json // [{ key, label, include, required }]
  lastError    String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([connectionId])
  @@index([formId])
  @@map("bychat_cloud_api_flows")
}

model CloudApiTemplate {
  id             Int      @id @default(autoincrement())
  wabaId         String   @db.VarChar(100)
  metaTemplateId String   @db.VarChar(100) // ID do template no Meta
  name           String   @db.VarChar(191)
  language       String   @db.VarChar(10) // pt_BR, en_US, etc.
  category       String   @db.VarChar(30) // MARKETING, UTILITY, AUTHENTICATION
  status         String   @db.VarChar(30) // APPROVED, PENDING, REJECTED, PAUSED, DISABLED, IN_APPEAL, PENDING_DELETION, FLAGGED, LIMIT_EXCEEDED
  // Motivo do status atual (rejected_reason quando REJECTED; reason de pausa/desativação
  // quando PAUSED/DISABLED). Preenchido pelo webhook message_template_status_update e pela
  // reconciliação periódica (REST). NONE/null = sem motivo.
  statusReason    String?  @db.VarChar(255)
  qualityScore    String?  @db.VarChar(20) // GREEN, YELLOW, RED, UNKNOWN
  statusUpdatedAt DateTime? // quando o status mudou pela última vez (≠ lastSyncAt)
  components     Json     @db.Json // Header, Body, Footer, Buttons
  lastSyncAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([wabaId, name, language])
  @@index([wabaId])
  @@index([status])
  @@map("bychat_cloud_api_templates")
}

// Log de disparos via WhatsApp Cloud API (oficial Meta) — base do painel de
// acompanhamento e do cálculo de custo. Diferente da Evolution (não-oficial,
// grátis), cada conversa/template entregue pela Cloud API pode ser cobrado pela
// Meta por categoria. Os campos category/billable/pricingModel são preenchidos
// pelo webhook de status (statuses[].pricing / .conversation), antes descartados.
model CloudApiMessageLog {
  id                   Int      @id @default(autoincrement())
  cloudApiConnectionId Int?
  cloudApiConnection   CloudApiConnection? @relation(fields: [cloudApiConnectionId], references: [id], onDelete: SetNull)
  leadId               Int?
  wamid                String   @unique @db.VarChar(191) // message id da Meta (wamid.*)
  direction            String   @default("outbound") @db.VarChar(12) // outbound | inbound
  category             String?  @db.VarChar(30) // marketing | utility | authentication | service | referral_conversion
  pricingModel         String?  @db.VarChar(24) // CBP (conversation) | PMP (per-message)
  billable             Boolean  @default(false)
  status               String   @default("sent") @db.VarChar(20) // sent | delivered | read | failed
  templateName         String?  @db.VarChar(191)
  errorCode            String?  @db.VarChar(20)
  errorTitle           String?  @db.VarChar(255)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([cloudApiConnectionId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("bychat_cloud_api_message_logs")
}

// ─── Disparo em massa (Broadcast) via WhatsApp Cloud API ──
// Campanha de envio proativo usando template HSM aprovado (envio em massa fora da
// janela de 24h exige template). Audiência vem de leads do sistema ou de planilha
// importada; métricas via webhook de status (ligado por wamid em BroadcastRecipient).
model BroadcastCampaign {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(191)
  cloudApiConnectionId Int
  cloudApiConnection   CloudApiConnection @relation(fields: [cloudApiConnectionId], references: [id], onDelete: Cascade)
  templateId           Int      // CloudApiTemplate.id
  templateName         String   @db.VarChar(191)
  templateLanguage     String   @db.VarChar(10)
  templateCategory     String   @db.VarChar(30)
  // mapeamento das variáveis do template → origem do valor por destinatário.
  // { "body:1": { type: "lead_field"|"column"|"fixed", value: "nome" }, ... }
  variableMapping      Json     @db.Json
  audienceType         String   @db.VarChar(12) // leads | import
  audienceMeta         Json?    @db.Json // snapshot do filtro/arquivo (informativo)
  status               String   @default("draft") @db.VarChar(16) // draft|scheduled|running|paused|completed|canceled|failed
  scheduledAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  // contadores desnormalizados (números exatos saem de BroadcastRecipient.groupBy)
  totalRecipients      Int      @default(0)
  sentCount            Int      @default(0)
  failedCount          Int      @default(0)
  skippedCount         Int      @default(0)
  createdByUserId      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  recipients           BroadcastRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@index([cloudApiConnectionId])
  @@map("bychat_broadcast_campaigns")
}

model BroadcastRecipient {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     Int?
  phone      String   @db.VarChar(30)
  name       String?  @db.VarChar(191)
  variables  Json     @db.Json // valores resolvidos das variáveis { "body:1": "Maria" }
  status     String   @default("pending") @db.VarChar(12) // pending|queued|sent|delivered|read|failed|skipped
  skipReason String?  @db.VarChar(30) // opt_out | invalid_phone | duplicate
  wamid      String?  @db.VarChar(191)
  error      String?  @db.VarChar(500)
  queuedAt   DateTime?
  sentAt     DateTime?
  deliveredAt DateTime?
  readAt     DateTime?
  failedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId, status])
  @@index([wamid])
  @@map("bychat_broadcast_recipients")
}

// ─── Meta (Facebook) Lead Ads Integration ────────────────

model MetaIntegration {
  id              Int       @id @default(autoincrement())
  pageId          String    @unique @db.VarChar(100) // Facebook Page ID
  pageName        String    @db.VarChar(191) // Nome da pagina
  pageAccessToken String    @db.Text // Page Access Token (long-lived)
  userAccessToken String?   @db.Text // User token (para renovacao)
  appId           String?   @db.VarChar(100) // Meta App ID
