  createdAt     DateTime  @default(now())

  @@index([leadId])
  @@index([platform, status])
  @@index([eventName])
  @@index([eventId])
  @@index([createdAt])
  @@map("bychat_conversion_events")
}

// ── MULTI-TOUCH ATTRIBUTION ─────────────────

model LeadTouchpoint {
  id           Int      @id @default(autoincrement())
  leadId       Int
  channel      String   @db.VarChar(50) // meta_ctwa, google_ads, trackable_link, organic, direct, meta_lead_ads
  source       String?  @db.VarChar(100) // utm_source ou plataforma
  medium       String?  @db.VarChar(100) // utm_medium
  campaign     String?  @db.VarChar(191) // utm_campaign
  campaignId   String?  @db.VarChar(191)
  content      String?  @db.VarChar(191) // utm_content
  term         String?  @db.VarChar(191) // utm_term
  referrer     String?  @db.VarChar(500)
  landingUrl   String?  @db.Text
  gclid        String?  @db.VarChar(191)
  fbclid       String?  @db.VarChar(191)
  ctwaClid     String?  @db.VarChar(191)
  touchType    String   @db.VarChar(20) // first, middle, last, only
  touchOrder   Int      @default(1)
  // Attribution weights (calculados)
  weightFirst  Decimal  @default(0) @db.Decimal(5, 4) // first-touch weight
  weightLast   Decimal  @default(0) @db.Decimal(5, 4) // last-touch weight
  weightLinear Decimal  @default(0) @db.Decimal(5, 4) // linear weight
