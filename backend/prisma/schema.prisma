// ── Inbound Webhooks ────────────────────────────────────
// Endpoint público POST /api/inbound/:token recebe qualquer JSON e aplica
// mapping configurado (source JSONPath → target campo Lead ou cf_*) pra
// criar/atualizar Lead. Pensado pra integrar com webhooks "burros" (Make,
// n8n, Zapier, sistemas externos) que mandam payload em formato próprio.

model InboundWebhook {
  id              Int       @id @default(autoincrement())
  token           String    @unique @db.VarChar(64)
  name            String    @db.VarChar(191)
  description     String?   @db.Text
  active          Boolean   @default(true)
  defaultFunnelId Int?
  defaultStageKey String?   @db.VarChar(50)
  defaultTeamId   Int?
  defaultSource   String?   @db.VarChar(50)
  mapping         Json      @db.Json
  totalReceived   Int       @default(0)
  totalErrors     Int       @default(0)
  lastReceivedAt  DateTime?
  lastError       String?   @db.Text
  lastPayload     Json?     @db.Json
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hits InboundWebhookHit[]

  @@index([active])
  @@map("bychat_inbound_webhooks")
}

model InboundWebhookHit {
  id          Int            @id @default(autoincrement())
  webhookId   Int
  webhook     InboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  receivedAt  DateTime       @default(now())
  ip          String?        @db.VarChar(45)
  userAgent   String?        @db.VarChar(500)
  payload     Json?          @db.Json
  mappedData  Json?          @db.Json
  success     Boolean        @default(false)
  leadId      Int?
  error       String?        @db.Text

  @@index([webhookId, receivedAt])
  @@index([receivedAt])
  @@map("bychat_inbound_webhook_hits")
}

// ── DB Connectors — importa leads de MySQL/Postgres externo ──

model DbConnector {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(255)
  dbType          String    @db.VarChar(20) // 'mysql' | 'postgres'
  host            String    @db.VarChar(255)
  port            Int
  dbName          String    @db.VarChar(120)
  dbUser          String    @db.VarChar(120)
  passwordEnc     String    @db.Text
  useTLS          Boolean   @default(false)
  caCert          String?   @db.Text
  query           String    @db.Text
  mapping         Json      @db.Json
  deltaStrategy   String    @default("id") @db.VarChar(20)
  deltaColumn     String?   @db.VarChar(120)
  lastSyncCursor  String?   @db.VarChar(255)
  intervalMinutes Int       @default(5)
  active          Boolean   @default(true)
  lastRunAt       DateTime?
  lastRunStatus   String?   @db.VarChar(20)
  lastError       String?   @db.Text
  totalImported   Int       @default(0)
  defaultTeamId   Int?
