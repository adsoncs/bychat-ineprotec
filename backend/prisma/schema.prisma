model MetaLeadLog {
  id           Int       @id @default(autoincrement())
  metaLeadId   String    @db.VarChar(100) // Meta lead ID
  metaFormId   String    @db.VarChar(100) // Meta form ID
  metaPageId   String    @db.VarChar(100) // Meta page ID
  leadId       Int? // Lead criado no sistema (null se falhou)
  status       String    @default("received") @db.VarChar(20) // received, processed, failed, duplicate
  rawData      Json?     @db.Json // Dados brutos recebidos do Meta
