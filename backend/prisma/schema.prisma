  id          Int            @id @default(autoincrement())
  webhookId   Int
  webhook     InboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  receivedAt  DateTime       @default(now())
  ip          String?        @db.VarChar(45)
  userAgent   String?        @db.VarChar(500)
  payload     Json?          @db.Json
  mappedData  Json?          @db.Json
  success     Boolean        @default(false)
  leadId      Int?
  error       String?        @db.Text

  @@index([webhookId, receivedAt])
  @@index([receivedAt])
  @@map("bychat_inbound_webhook_hits")
}

// ── DB Connectors — importa leads de MySQL/Postgres externo ──

model DbConnector {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(120)
  // Nome do CANAL exibido em funis/relatórios (editável). Se vazio, cai no `name`.
  channelLabel    String?   @db.VarChar(120)
  description     String?   @db.VarChar(255)
  dbType          String    @db.VarChar(20) // 'mysql' | 'postgres'
  host            String    @db.VarChar(255)
  port            Int
  dbName          String    @db.VarChar(120)
  dbUser          String    @db.VarChar(120)
  passwordEnc     String    @db.Text
  useTLS          Boolean   @default(false)
  caCert          String?   @db.Text
  query           String    @db.Text
  mapping         Json      @db.Json
  deltaStrategy   String    @default("id") @db.VarChar(20)
  deltaColumn     String?   @db.VarChar(120)
  lastSyncCursor  String?   @db.VarChar(255)
  intervalMinutes Int       @default(5)
  active          Boolean   @default(true)
  lastRunAt       DateTime?
  lastRunStatus   String?   @db.VarChar(20)
  lastError       String?   @db.Text
  totalImported   Int       @default(0)
  defaultTeamId   Int?
  defaultFunnelId Int?
  defaultStageKey String?   @db.VarChar(60)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  team   Team?   @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)
  funnel Funnel? @relation(fields: [defaultFunnelId], references: [id], onDelete: SetNull)
  runs   DbConnectorRun[]

  @@index([active])
  @@index([lastRunAt])
  @@map("bychat_db_connectors")
}

model DbConnectorRun {
  id                 Int       @id @default(autoincrement())
  connectorId        Int
  connector          DbConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  status             String    @default("running") @db.VarChar(20)
  rowsRead           Int       @default(0)
  leadsCreated       Int       @default(0)
  leadsSkipped       Int       @default(0)
  errorCount         Int       @default(0)
  cursorBefore       String?   @db.VarChar(255)
  cursorAfter        String?   @db.VarChar(255)
  error              String?   @db.Text
  triggeredBy        String    @default("cron") @db.VarChar(20)
  triggeredByUserId  Int?

  @@index([connectorId, startedAt(sort: Desc)])
  @@map("bychat_db_connector_runs")
}

// ── Google Integration ──────────────────────────────────

model GoogleConnection {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  accessToken    String    @db.Text
  refreshToken   String    @db.Text
  tokenExpiresAt DateTime?
  scopes         String    @db.VarChar(500)
  active         Boolean   @default(true)
  // Híbrido B: COMPANY = conta da empresa (Drive/Sheets centralizado + fallback);
  // OPERATOR = conta pessoal de um operador (Calendar/Tasks/Gmail próprios)
  kind           String    @default("OPERATOR") @db.VarChar(16)
  userId         Int?      @unique
  createdBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sheetIntegrations    GoogleSheetIntegration[]
  calendarIntegrations GoogleCalendarIntegration[]
  driveConfigs         GoogleDriveConfig[]
  tasksConfigs         GoogleTasksConfig[]
  gmailConfigs         GmailConfig[]

  @@index([active])
  @@index([kind, active])
  @@map("bychat_google_connections")
}

model GoogleSheetIntegration {
  id               Int              @id @default(autoincrement())
  name             String           @db.VarChar(191)
  connectionId     Int
  connection       GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  spreadsheetId    String           @db.VarChar(191)
  spreadsheetName  String           @db.VarChar(191)
  sheetName        String           @default("Sheet1") @db.VarChar(191)
  events           Json             @db.Json
  fieldMapping     Json             @db.Json
  includeTimestamp Boolean          @default(true)
  active           Boolean          @default(true)
  totalSent        Int              @default(0)
  totalFailed      Int              @default(0)
  lastSentAt       DateTime?
  lastError        String?          @db.Text
  createdBy        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  logs GoogleSheetLog[]

  @@index([active])
  @@index([connectionId])
  @@map("bychat_google_sheet_integrations")
}

model GoogleSheetLog {
  id            Int                    @id @default(autoincrement())
  integrationId Int
  integration   GoogleSheetIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event         String                 @db.VarChar(50)
  rowData       Json?                  @db.Json
  success       Boolean                @default(false)
  error         String?                @db.Text
  duration      Int?
  createdAt     DateTime               @default(now())

  @@index([integrationId, createdAt])
  @@index([createdAt])
  @@map("bychat_google_sheet_logs")
}

// ── Google Calendar Integration ─────────────────────────

model GoogleCalendarIntegration {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(191)
  connectionId   Int
  connection     GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendarId     String           @default("primary") @db.VarChar(191)
  syncActivities Boolean          @default(true)
  activityTypes  Json             @db.Json // ["meeting","call"] etc
  autoMeetLink   Boolean          @default(true)
  notifyLead     Boolean          @default(false)
  active         Boolean          @default(true)
  totalSynced    Int              @default(0)
  totalFailed    Int              @default(0)
  lastSyncAt     DateTime?
  lastError      String?          @db.Text
  createdBy      Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([active])
  @@index([connectionId])
  @@map("bychat_google_calendar_integrations")
}

model CalendarSyncLog {
  id              Int      @id @default(autoincrement())
  integrationId   Int
  activityId      Int?
  calendarEventId String?  @db.VarChar(191)
  action          String   @db.VarChar(30) // created, updated, deleted
  success         Boolean  @default(false)
  error           String?  @db.Text
  duration        Int?
  createdAt       DateTime @default(now())

  @@index([integrationId, createdAt])
  @@index([createdAt])
  @@map("bychat_calendar_sync_logs")
}

// ── Google Drive Integration ────────────────────────────

model GoogleDriveConfig {
  id             Int      @id @default(autoincrement())
  connectionId   Int
  connection     GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rootFolderId   String?  @db.VarChar(191) // pasta raiz "ByChat CRM" no Drive
  rootFolderLink String?  @db.Text
  autoUploadChat Boolean  @default(false) // upload automático de mídia do chat
  active         Boolean  @default(true)
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([connectionId])
  @@map("bychat_google_drive_configs")
}

// ── Google Tasks Integration ────────────────────────────

model GoogleTasksConfig {
  id            Int      @id @default(autoincrement())
  connectionId  Int
  connection    GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  taskListId    String   @db.VarChar(191)
  taskListTitle String   @db.VarChar(191)
  activityTypes Json     @db.Json // ["task","followup","meeting","call"]
  active        Boolean  @default(true)
  totalSynced   Int      @default(0)
  totalFailed   Int      @default(0)
  createdBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([connectionId])
  @@map("bychat_google_tasks_configs")
}

// ── Gmail Integration ───────────────────────────────────

model GmailConfig {
  id           Int      @id @default(autoincrement())
  connectionId Int
  connection   GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderName   String?  @db.VarChar(191) // nome que aparece no "De:"
  signature    String?  @db.Text // assinatura HTML
  active       Boolean  @default(true)
  totalSent    Int      @default(0)
  totalFailed  Int      @default(0)
  // Recebimento de respostas dos clientes (canal de e-mail do cliente):
  // quando ligado, esta caixa é a usada para ENVIAR e-mails de cliente e o
  // sistema registra (via Gmail watch + Pub/Sub) as respostas como Atividades.
  syncReplies     Boolean   @default(false)
  lastHistoryId   String?   @db.VarChar(40)  // cursor do Gmail History API
  watchExpiration DateTime?                  // expira ~7 dias; renovado por cron
  lastSyncAt      DateTime?
  totalReceived   Int       @default(0)
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([connectionId])
  @@map("bychat_gmail_configs")
}

// ── Google Analytics 4 ──────────────────────────────────

model GA4Config {
  id            Int       @id @default(autoincrement())
  measurementId String    @db.VarChar(50) // G-XXXXXXXXXX
  apiSecret     String    @db.VarChar(191) // Measurement Protocol API secret
  events        Json      @db.Json // quais eventos do CRM enviar
  active        Boolean   @default(true)
  totalSent     Int       @default(0)
  totalFailed   Int       @default(0)
  lastSentAt    DateTime?
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("bychat_ga4_configs")
}

// ── Google Ads Integration ──────────────────────────────

model GoogleAdsConfig {
  id                  Int       @id @default(autoincrement())
  connectionId        Int
  customerId          String    @db.VarChar(30) // Google Ads customer ID (xxx-xxx-xxxx)
  developerToken      String    @db.VarChar(191) // Google Ads API developer token
  conversionAction    String?   @db.VarChar(191) // [DEPRECATED] mantido p/ compat; usar conversionMap
  autoSendConversions Boolean   @default(false)
  active              Boolean   @default(true)
  totalSent           Int       @default(0)
  totalFailed         Int       @default(0)
  lastSentAt          DateTime?
  createdBy           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  conversionMap GoogleAdsConversionMap[]

  @@index([connectionId])
  @@map("bychat_google_ads_configs")
}

// Mapping trigger interno → Conversion Action no Google Ads (Fase 28 — multi-evento).
// Cada GoogleAdsConfig pode ter até 1 row por trigger (lead.won, lead_qualified, etc).
model GoogleAdsConversionMap {
  id               Int      @id @default(autoincrement())
  configId         Int
  trigger          String   @db.VarChar(60)  // 'lead.won' | 'lead_qualified' | 'enrollment.payment_confirmed' | 'diagnosis.completed' | ...
  conversionAction String   @db.VarChar(191) // ID puro da Conversion Action no Google Ads
  valueSource      String   @default("zero") @db.VarChar(20) // 'zero' | 'sale_value' | 'fixed'
  fixedValue       Float?
  isPrimary        Boolean  @default(false)  // marcação informativa — Google Ads tem seu próprio conceito de Primary
  enabled          Boolean  @default(true)
  totalSent        Int      @default(0)
  totalFailed      Int      @default(0)
  lastSentAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  config GoogleAdsConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, trigger])
  @@index([configId])
  @@map("bychat_google_ads_conversion_map")
}

// Custos / métricas por dia × nível (campaign | ad_group | ad) sincronizados via
// GAQL da API Google Ads. Espelha `CampaignCost` (Meta) — colunas equivalentes.
model GoogleAdsCampaignCost {
  id               Int      @id @default(autoincrement())
  // Chave determinística:
  //   "campaign:CID:CAMP:YYYY-MM-DD"
  //   "ad_group:CID:CAMP:AG:YYYY-MM-DD"
  //   "ad:CID:CAMP:AG:AD:YYYY-MM-DD"
  costKey          String   @unique @db.VarChar(255)
  level            String   @default("campaign") @db.VarChar(10) // campaign | ad_group | ad | keyword
  customerId       String   @db.VarChar(30)  // Google Ads customer ID (xxx-xxx-xxxx ou só dígitos)
  campaignId       String   @db.VarChar(191)
  campaignName     String   @db.VarChar(191)
  adGroupId        String?  @db.VarChar(191)
  adGroupName      String?  @db.VarChar(191)
  adId             String?  @db.VarChar(191)
  adName           String?  @db.VarChar(191)
  criterionId      String?  @db.VarChar(191) // id do critério (level=keyword)
  keyword          String?  @db.VarChar(255) // texto da palavra-chave (level=keyword) — casa com Lead.googleKeyword
  date             DateTime @db.Date
  spend            Decimal  @db.Decimal(12, 2)
  impressions      Int?
  clicks           Int?
  conversions      Decimal? @db.Decimal(12, 4)
  conversionValue  Decimal? @db.Decimal(12, 2)
  cpc              Decimal? @db.Decimal(10, 4)
  cpm              Decimal? @db.Decimal(10, 4)
  ctr              Decimal? @db.Decimal(8, 4)
  avgPosition      Decimal? @db.Decimal(8, 4)
  source           String   @default("google_ads_api") @db.VarChar(30)
  raw              Json?    @db.Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId, date])
  @@index([campaignId, date])
  @@index([adGroupId, date])
  @@index([adId, date])
  @@index([level])
  @@index([date])
  @@map("bychat_google_ads_campaign_costs")
}

// ═══════════════════════════════════════════════════════════════
// MÓDULO EDUCACIONAL — ativado via setting `educational.enabled`
// Inspirado na modelagem da Rubeus (docs.rubeus.com.br) + MEC
// ═══════════════════════════════════════════════════════════════

model EducationalLevel {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  codigo    String?  @unique @db.VarChar(50)
  descricao String?  @db.Text
  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses            Course[]
  offerings          CourseOffering[]
  selectionProcesses SelectionProcess[]

  @@map("bychat_edu_levels")
}

model Modality {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  codigo    String?  @unique @db.VarChar(50)
  descricao String?  @db.Text
  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]

  @@map("bychat_edu_modalities")
}

// Unidade = agrupamento organizacional (marca/filial/regional)
// Uma instituição pode ter várias unidades (ex: "Norte", "Sul", "EAD")
model EducationalUnit {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(191)
  codigo    String?  @unique @db.VarChar(50)
  descricao String?  @db.Text
  // ── Fase 1 (G5): a unidade passa a pendurar na IES ──
  /// IES a que esta unidade pertence. Anulável para não quebrar instalações que
  /// ainda não cadastraram a hierarquia.
  iesId     Int?
  /// campus | polo_ead | unidade_administrativa — o Censo distingue.
  tipoUnidade String? @db.VarChar(40)
  /// Código de endereço no e-MEC (o local de oferta declarado no regulatório).
  codigoEmecEndereco String? @db.VarChar(20)
  enderecoJson Json?  @db.Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses           Campus[]
  courses            Course[]
  offerings          CourseOffering[]
  selectionProcesses SelectionProcess[]
  enrollmentPortals  EnrollmentPortal[]

  @@map("bychat_edu_units")
}

// Campus = local físico/virtual de oferta (pertence a uma Unidade)
model Campus {
  id        Int             @id @default(autoincrement())
  unitId    Int
  unit      EducationalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  nome      String          @db.VarChar(191)
  codigo    String?         @db.VarChar(50)
  descricao String?         @db.Text
  telefone  String?         @db.VarChar(30)
  email     String?         @db.VarChar(191)
  endereco  String?         @db.VarChar(255)
  numero    String?         @db.VarChar(20)
  bairro    String?         @db.VarChar(100)
  cep       String?         @db.VarChar(10)
  cidade    String?         @db.VarChar(100)
  estado    String?         @db.VarChar(2)
  latitude  Float?
  longitude Float?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  offerings CourseOfferingCampus[]

  @@index([unitId])
  @@index([cidade, estado])
  @@map("bychat_edu_campuses")
}

// Curso = catálogo mestre (nome + descrição, sem modalidade/nível)
model Course {
  id           Int               @id @default(autoincrement())
  unitId       Int
  unit         EducationalUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  levelId      Int?
  level        EducationalLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  nome         String            @db.VarChar(191)
  codigo       String?           @db.VarChar(50)
  descricao    String?           @db.Text
  duracaoMeses Int?
  cargaHoraria Int?
  // ── Fase 1 (G5): identidade regulatória do curso ──
  codigoEmec   String?           @db.VarChar(20)
  /// bacharelado | licenciatura | tecnologo | pos_lato | pos_stricto | tecnico | livre
  grau         String?           @db.VarChar(30)
  /// presencial | ead | hibrido
  modalidade   String?           @db.VarChar(20)
  /// seriado_semestral | seriado_anual | credito | modular
  regimeAcademico String?        @db.VarChar(30)
  duracaoMinPeriodos Int?
  duracaoMaxPeriodos Int?
  /// Área do conhecimento (classificação Cine Brasil) — exigida no Censo.
  areaCine     String?           @db.VarChar(120)
  // ── Educação profissional técnica (SISTEC / CNCT) ──
  /// Um dos 13 eixos tecnológicos do CNCT. O SISTEC exige o eixo para cadastrar
  /// o curso, e é por ele que a lista de cursos do catálogo é filtrada.
  eixoTecnologico String?         @db.VarChar(80)
  /// Código do curso no Catálogo Nacional de Cursos Técnicos; nulo em curso
  /// experimental (que o SISTEC também aceita, por outro caminho).
  codigoCnct   String?           @db.VarChar(20)
  /// O SISTEC pergunta isto no cadastro: o curso de habilitação confere
  /// certificado de qualificação profissional em etapas intermediárias?
  certificacaoIntermediaria Boolean @default(false)
  /// Perfil profissional de conclusão — o que o egresso está apto a fazer.
  /// Res. CNE/CP 1/2021, art. 49, §4º: o histórico que acompanha certificados e
  /// diplomas DEVE explicitá-lo. Sem isso o documento sai incompleto.
  perfilConclusao String?         @db.Text
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  offerings CourseOffering[]

  @@index([unitId])
  @@index([levelId])
  @@map("bychat_edu_courses")
}

// Oferta de Curso = instância concreta: Curso × Modalidade × Nível × Unidade × Período
// Ela que recebe vagas, valores, datas, processo seletivo e conecta aos campus
model CourseOffering {
  id                 Int               @id @default(autoincrement())
  courseId           Int
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitId             Int
  unit               EducationalUnit   @relation(fields: [unitId], references: [id])
  modalityId         Int
  modality           Modality          @relation(fields: [modalityId], references: [id])
  levelId            Int?
  level              EducationalLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  selectionProcessId Int?
  selectionProcess   SelectionProcess? @relation(fields: [selectionProcessId], references: [id], onDelete: SetNull)

  nome        String  @db.VarChar(191)
  complemento String? @db.VarChar(255) // ex: "Noturno — 2026/1"
  codigo      String? @db.VarChar(50)
  turno       String? @db.VarChar(20) // Matutino, Vespertino, Noturno, Integral

  valorMensalidade Decimal? @db.Decimal(12, 2)
  valorMatricula   Decimal? @db.Decimal(12, 2)
  vagasMinimas     Int?
  vagasMaximas     Int?

  // Nota de corte específica desta oferta (ex: Medicina 700, Pedagogia 450).
  // Override opcional de SelectionProcess.notaCorte — se null, usa a do processo.
  // Lido pelo enemClassification.ts na ordem: offering.notaCorte > selectionProcess.notaCorte.
  notaCorte Float?

  // Cutoffs específicos por oferta — override de SelectionProcess.essayCutoff/presencialCutoff.
  essayCutoff      Float?
  presencialCutoff Float?

  inicioInscricao  DateTime?
  terminoInscricao DateTime?
  inicioMatricula  DateTime?
  terminoMatricula DateTime?
  inicioCurso      DateTime?
  terminoCurso     DateTime?

  status    String   @default("active") @db.VarChar(20) // active, draft, closed
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses      CourseOfferingCampus[]
  registrations ProcessRegistration[]

  @@index([courseId])
  @@index([unitId])
  @@index([modalityId])
  @@index([selectionProcessId])
  @@index([status])
  @@map("bychat_edu_offerings")
}

// N:M Oferta × Campus (uma oferta pode ser ministrada em vários campus)
model CourseOfferingCampus {
  id         Int            @id @default(autoincrement())
  offeringId Int
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  campusId   Int
  campus     Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([offeringId, campusId])
  @@index([offeringId])
  @@index([campusId])
  @@map("bychat_edu_offering_campuses")
}

// Processo Seletivo = um "vestibular" (ENEM/vestibular/agendado/análise/transferência)
// — como cada forma de ingresso é um processo distinto, NÃO há campo tipo fixo:
// o admin cria um processo "Vestibular Tradicional 2026/1", outro "ENEM 2026/1", etc.
// Modo de ingresso (Vestibular online/presencial, ENEM, Transferência, Segunda Graduação,
// Pós-Graduação, Extensão, Bolsa). Define como o candidato é avaliado, quais documentos
// são exigidos e qual workflow de aprovação é aplicado.
// Seed fixo — registros criados pelo service educational.ts (idempotente).
model EntryMode {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(40) // vestibular_online, enem, transferencia, etc.
  name        String  @db.VarChar(100)
  description String? @db.Text
  icon        String? @db.VarChar(10) // emoji para UI

  // Tipo de avaliação determina o evaluator plugável.
  // none = aprovação automática | docs = análise documental | enem = upload + parser IA
  // exam_online = prova digital (F6 futura) | exam_presencial = prova em local físico (F5 futura)
  evaluationType String @default("docs") @db.VarChar(30)

  requiresClassification Boolean @default(false) // calcula nota/posição?

  /// A qual das 10 formas de ingresso do Censo da Educação Superior este modo
  /// corresponde. É N:1 de propósito: a escola cria quantos modos comerciais
  /// quiser ("Análise curricular — Pós", "Ingresso por diploma"), e todos podem
  /// declarar SELECAO_SIMPLIFICADA no Censo. Sem este campo o modo é interno e
  /// não pode alimentar vínculo de curso superior/pós.
  /// Res. CNE/CES 1/2018, art. 6º: especialização É registrada no Censo.
  censoForma            String? @db.VarChar(30)
  /// COMO o candidato é classificado. Independe do evaluationType: um modo
  /// pode avaliar por documento (evaluationType=docs) e classificar por média
  /// do histórico ou por ordem de inscrição. Ver services/acaFormaIngresso.ts.
  criterioClassificacao String? @db.VarChar(30)

  // Campos extras que aparecem no form do portal quando esse modo é selecionado.
  // Formato: [{ name, label, type, required, ... }]
  defaultFormExtras Json?

  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionProcesses   SelectionProcess[]
  documentRequirements EntryModeDocumentRequirement[]

  @@index([code])
  @@index([active, ordem])
  @@map("bychat_edu_entry_modes")
}

// Catálogo master de tipos de documento (RG, CPF, Histórico Escolar, Boletim ENEM, Diploma,
// Comprovante de Renda, etc). Substitui o campo free-form EnrollmentDocument.type.
model DocumentType {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(40) // rg, cpf, historico, boletim_enem, diploma
  name        String  @db.VarChar(100)
  description String? @db.Text
  category    String  @default("other") @db.VarChar(30) // identity|academic|enem|financial|other

  // Template de análise IA — chave que aponta para o prompt no worker de review.
  // null = sem análise automatizada por IA (review puramente humano).
  aiAnalysisTemplate String? @db.VarChar(50)

  ordem     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements   EntryModeDocumentRequirement[]
  spRequirements SelectionProcessDocumentRequirement[]
  documents      EnrollmentDocument[]

  @@index([category, ordem])
  @@map("bychat_edu_document_types")
}

// Junção N×N: quais documentos cada modo de ingresso exige.
// Ex: EntryMode("transferencia") × DocumentType("historico") com required=true.
model EntryModeDocumentRequirement {
  id             Int          @id @default(autoincrement())
  entryModeId    Int
  entryMode      EntryMode    @relation(fields: [entryModeId], references: [id], onDelete: Cascade)
  documentTypeId Int
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  required Boolean @default(true)
  ordem    Int     @default(0)
  helpText String? @db.Text

  createdAt DateTime @default(now())

  @@unique([entryModeId, documentTypeId])
  @@index([entryModeId, ordem])
  @@map("bychat_edu_entry_mode_doc_requirements")
}

// Override por SelectionProcess. Quando o SP tem `useCustomDocuments = true`,
// o candidato vê os requirements desta tabela em vez do default do EntryMode.
// Quando false (default), herda 100% do EntryMode.
model SelectionProcessDocumentRequirement {
  id                 Int              @id @default(autoincrement())
  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)
  documentTypeId     Int
  documentType       DocumentType     @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  required Boolean @default(true)
  ordem    Int     @default(0)
  helpText String? @db.Text

  createdAt DateTime @default(now())

  @@unique([selectionProcessId, documentTypeId])
  @@index([selectionProcessId, ordem])
  @@map("bychat_edu_sp_doc_requirements")
}

model SelectionProcess {
  id          Int               @id @default(autoincrement())
  unitId      Int
  unit        EducationalUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  levelId     Int?
  level       EducationalLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  // Modo de ingresso define avaliação, documentos e workflow do processo.
  // Nullable só durante migração inicial — novos processos exigem.
  entryModeId Int?
  entryMode   EntryMode?        @relation(fields: [entryModeId], references: [id], onDelete: SetNull)

  nome          String   @db.VarChar(191)
  codigo        String?  @db.VarChar(50)
  // Código único (slug) usado como identificador público do processo — ex.: "vestibular-20262".
  // Referenciado no portal de matrículas para gerar inscrições com rastreabilidade.
  slug          String?  @unique @db.VarChar(100)
  descricao     String?  @db.Text
  editalUrl     String?  @db.Text
  taxaInscricao Decimal? @db.Decimal(12, 2)
  periodoLetivo String?  @db.VarChar(20) // 2026/1, 2026/2

  inicioInscricao  DateTime?
  terminoInscricao DateTime?
  inicioMatricula  DateTime?
  terminoMatricula DateTime?

  // Nota de corte aplicada ao modo ENEM (e exames futuros).
  // Usado pelo evaluator para classificar aprovação/reprovação automática.
  notaCorte Float?

  status    String   @default("active") @db.VarChar(20) // active, draft, closed
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quando true, painel do candidato usa documentRequirements desta SP em vez
  // do default do EntryMode. Quando false (padrão), herda do modo.
  useCustomDocuments Boolean @default(false)

  // ── Configuração da Redação Online (modo vestibular_online) ──
  // Tema, prazo, tentativas, anti-fraude, critérios IA. Aplicado por SP — cada
  // edição do vestibular pode ter um tema/critérios diferentes.
  essayPrompt          String? @db.Text
  essayDurationMinutes Int? // null = sem prazo cronometrado
  essayMaxAttempts     Int     @default(1)
  essayMinWords        Int? // mínimo de palavras (validação client+server)
  essayMaxWords        Int? // máximo de palavras
  essayPasteBlocked    Boolean @default(true)
  essayAiEnabled       Boolean @default(true)
  // Quando true, a IA aprova/reprova direto (compara aiScore com essayCutoff)
  // sem passar por revisão humana. Default false = sempre needs_human após IA.
  essayAiAutoApprove   Boolean @default(false)
  essayCutoff          Float? // nota mínima default (override por oferta)
  // [{key, label, weight, description}] — ex: coesão 20%, gramática 15%, etc.
  essayAiCriteria      Json?

  // Cutoff default da prova presencial (override por oferta).
  presencialCutoff Float?

  offerings            CourseOffering[]
  registrations        ProcessRegistration[]
  documentRequirements SelectionProcessDocumentRequirement[]
  essayTopics          EssayTopic[]

  @@index([unitId])
  @@index([levelId])
  @@index([entryModeId])
  @@index([status])
  @@index([periodoLetivo])
  @@map("bychat_edu_selection_processes")
}

// Tema da redação online — 1:N por SelectionProcess. O backend sorteia um
// tema ativo a cada nova tentativa do candidato e snapshota em
// EssaySubmission.prompt (não volta a sortear quando o draft é retomado).
// Quando a SP não tem nenhum EssayTopic, o legado SelectionProcess.essayPrompt
// é usado como fallback.
model EssayTopic {
  id                 Int              @id @default(autoincrement())
  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)

  title        String?  @db.VarChar(150) // rótulo curto opcional ("Tema 1", "Inclusão digital")
  prompt       String   @db.Text // enunciado completo da proposta
  supportTexts String?  @db.Text // textos motivadores (opcional)
  active       Boolean  @default(true)
  ordem        Int      @default(0)

  // Origem do tema — exibe badge na UI (ai | enem | manual). Default 'manual'
  // pra não quebrar registros existentes; backfill aplicado na migração.
  source       String   @default("manual") @db.VarChar(20)
  // Metadados opcionais — ENEM: ano da prova; AI: modelo/contexto usados.
  sourceMeta   Json?    @db.Json

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([selectionProcessId])
  @@index([active])
  @@map("bychat_edu_essay_topics")
}

// Registro de Processo = inscrição/matrícula do Lead numa Oferta via Processo Seletivo
// (ponte Contato × Oferta × Processo Seletivo, com ciclo de vida do candidato)
model ProcessRegistration {
  id                 Int              @id @default(autoincrement())
  leadId             Int
  lead               Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offeringId         Int
  offering           CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)

  codigo String? @db.VarChar(50)
  // Ciclo: inscrito → pago_taxa → classificado → convocado → matriculado
  //                                                        ↘ desistente / reprovado
  status String  @default("inscrito") @db.VarChar(30)

  inscritoEm     DateTime  @default(now())
  pagoTaxaEm     DateTime?
  classificadoEm DateTime?
  convocadoEm    DateTime?
  matriculadoEm  DateTime?
  desistenteEm   DateTime?

  notaClassificacao    Float?
  posicaoClassificacao Int?
  valorPago            Decimal? @db.Decimal(12, 2)
  observacao           String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusLogs             ProcessRegistrationStatusLog[]
  enrollmentRegistration EnrollmentRegistration?

  @@unique([leadId, offeringId])
  @@index([leadId])
  @@index([offeringId])
  @@index([selectionProcessId])
  @@index([status])
  @@map("bychat_edu_process_registrations")
}

// Histórico de mudanças de status de uma inscrição.
// Cada PUT que altera ProcessRegistration.status escreve uma linha aqui.
model ProcessRegistrationStatusLog {
  id             Int                 @id @default(autoincrement())
  registrationId Int
  registration   ProcessRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus     String?             @db.VarChar(30)
  toStatus       String              @db.VarChar(30)
  actorId        Int?
  actorName      String?             @db.VarChar(191)
  observacao     String?             @db.Text
  createdAt      DateTime            @default(now())

  @@index([registrationId, createdAt])
  @@map("bychat_edu_process_registration_status_logs")
}

// ═══════════════════════════════════════════════════════════════════
// PORTAL DE MATRÍCULAS (Fase A - MVP)
// ═══════════════════════════════════════════════════════════════════

// Portal de matrículas — página pública configurável vinculada a um ou mais
// processos seletivos. Reaproveita LandingPage para o design.
model EnrollmentPortal {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(100)
  nome String @db.VarChar(191)

  unitId Int
  unit   EducationalUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // IDs dos processos seletivos atendidos por este portal (JSON array of Int).
  selectionProcessIds Json @db.Json

  // Design reaproveita LandingPage; relação 1-1 opcional.
  landingPageId Int?         @unique
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  // Estrutura do formulário multi-step (persistida como JSON).
  // { steps: [{ id, name, fields: [{ type, name, label, required, options, rules }] }], ... }
  formConfig Json @db.Json

  // Modo do portal:
  //   'full'     — formulário completo de matrícula (padrão, comportamento legado)
  //   'interest' — captura leve no topo de funil (4 campos + LGPD); gera Lead
  //                em status INTERESSADO e dispara magic link para o candidato
  //                completar a inscrição em um portal 'full' depois.
  formMode String @default("full") @db.VarChar(20)

  // Quando formMode='interest', aponta para o portal 'full' onde o lead vai
  // continuar a matrícula via magic link. Self-relation opcional.
  continuationPortalId  Int?
  continuationPortal    EnrollmentPortal?  @relation("PortalContinuation", fields: [continuationPortalId], references: [id], onDelete: SetNull)
  interestSourcePortals EnrollmentPortal[] @relation("PortalContinuation")

  // TTL do magic link de continuação, em dias. 30 é razoável para nurturing.
  magicLinkTtlDays Int @default(30)

  // Comportamento
  alwaysCreateNew Boolean @default(false) // ignora dedup e sempre cria registro novo
  ctaBehavior     String  @default("message") @db.VarChar(20) // message | redirect
  ctaTarget       String? @db.VarChar(500)
  ctaMessage      String? @db.Text

  captchaType    String? @db.VarChar(20) // recaptcha | hcaptcha | none
  captchaSiteKey String? @db.VarChar(100)
  captchaSecret  String? @db.VarChar(255) // criptografado em produção

  // Permissões / filtros hierárquicos (JSON array of Int, null = todos)
  allowedLevelIds    Json? @db.Json
  allowedCourseIds   Json? @db.Json
  allowedCampusIds   Json? @db.Json
  allowedModalityIds Json? @db.Json

  // Pagamento (Fase B)
  // O VALOR da taxa NÃO mora aqui — é lido de SelectionProcess.taxaInscricao
  // (cada inscrição já carrega o selectionProcessId, então o valor segue o
  // vestibular específico, não o portal que pode hospedar vários).
  paymentProvider      String? @db.VarChar(30) // asaas | pagarme
  paymentConfig        Json?   @db.Json
  requirePayment       Boolean @default(false)
  paymentDeadlineHours Int     @default(48)
  // 'link'       = redireciona pra paymentlinks hospedado (Pagar.me) / invoiceUrl (Asaas)
  // 'transparent' = checkout PIX/boleto/cartão renderiza dentro do portal de inscrição
  paymentMode          String  @default("link") @db.VarChar(20)

  // Domínio próprio + SEO
  customDomain    String? @db.VarChar(191)
  sslStatus       String? @db.VarChar(20)
  metaTitle       String? @db.VarChar(191)
  metaDescription String? @db.VarChar(500)
  ogImageUrl      String? @db.Text

  // Branding visual (aba 🎨 Visual no admin) — compartilhado por
  // /portal/:slug (vestibular) e /candidato/:code (candidato).
  brandLogoUrl            String? @db.VarChar(500)
  brandLogoLink           String? @db.VarChar(500)
  brandFaviconUrl         String? @db.VarChar(500)
  brandPrimaryColor       String? @db.VarChar(20) // hex (#1a73e8)
  brandHeroEnabled        Boolean @default(true)
  brandHeroUrl            String? @db.VarChar(500)
  brandHeroTitle          String? @db.VarChar(191)
  brandHeroSubtitle       String? @db.VarChar(500)
  brandHeroOverlayOpacity Int? // 0-80
  brandFooterText         String? @db.Text
  brandFontFamily         String? @db.VarChar(40) // inter | roboto | poppins | system
  brandRadiusScale        String? @db.VarChar(20) // sharp | medium | rounded

  // Advanced
  customCss    String? @db.LongText
  customHeadJs String? @db.LongText
  customBodyJs String? @db.LongText

  // Analytics (pixels)
  pixelConfig Json? @db.Json

  // CRM
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Funil destino para leads criados via portal
  funnelId Int?
  funnel   Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  stageKey String? @db.VarChar(50)

  // Etapa do funil para onde o lead vai automaticamente quando TODOS os docs
  // obrigatórios da inscrição forem aprovados. Vazio = não move.
  docsCompleteStageKey String? @db.VarChar(50)

  // Etapa para auto-avanço quando docs OK + avaliação do modo de ingresso OK
  // (redação aprovada / ENEM passou / presencial aprovado). Vazio = não move.
  finalApprovalStageKey String? @db.VarChar(50)

  // Conexão de gateway de pagamento (preferir a `paymentProvider` + `paymentConfig` legados).
  // Referencia PaymentProviderConnection — 1 conexão serve N portais.
  paymentConnectionId Int?
  paymentConnection   PaymentProviderConnection? @relation(fields: [paymentConnectionId], references: [id], onDelete: SetNull)

  // Sequência de candidateCode (usado no generator)
  codePrefix   String @default("MAT") @db.VarChar(10)
  codeSequence Int    @default(0)

  // Estado
  active      Boolean   @default(true)
  publishedAt DateTime?

  // Counters (updated via app logic)
  views       Int @default(0)
  submissions Int @default(0)
  conversions Int @default(0)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EnrollmentRegistration[]
  drafts        EnrollmentDraft[]

  @@index([unitId])
  @@index([active])
  @@index([teamId])
  @@index([funnelId])
  @@index([paymentConnectionId])
  @@index([customDomain])
  @@map("bychat_enrollment_portals")
}

// Gateway de pagamento como integração reutilizável (1 conexão → N portais)
model PaymentProviderConnection {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(191)
  provider    String @db.VarChar(30) // asaas | stripe | mercadopago
  environment String @default("sandbox") @db.VarChar(20) // sandbox | production

  apiKey             String  @db.Text // criptografada via encryptToken
  // Public key (Pagar.me: pk_…) — usada pela tokenizecard.js no frontend para
  // tokenizar cartão sem PCI no servidor (SAQ A). Asaas usa fluxo /creditCard/tokenize.
  // Criptografada via encryptToken. Opcional: sem ela, aba cartão fica desabilitada.
  publicKey          String? @db.Text
  defaultBillingType String? @db.VarChar(20) // UNDEFINED | PIX | BOLETO | CREDIT_CARD

  webhookToken  String  @unique @db.VarChar(64)
  webhookSecret String? @db.VarChar(191)

  // Metadados de conta
  companyDocument String? @db.VarChar(20)
  pixKey          String? @db.VarChar(191)
  accountHolder   String? @db.VarChar(191)

  active Boolean @default(true)

  // Teste de conexão
  lastTestedAt    DateTime?
  lastTestStatus  String?   @db.VarChar(30) // ok | error
  lastTestMessage String?   @db.Text

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portals     EnrollmentPortal[]
  webhookHits PaymentWebhookHit[]

  @@index([provider])
  @@index([active])
  @@map("bychat_payment_provider_connections")
}

// Módulo VoIP — registro de chamada (CDR) da integração FaleMaisVoip.
// Duas origens: `click_to_call` (operador clica "Ligar" → v1/dial da Sigma REST)
// e `bulk_sync` (importado do histórico /ligacoes da API de Gravações).
// `leadId`/`userId`/`activityId` são scalars (sem relation Prisma) de propósito —
// `bulk_sync` pode não casar com um lead e não queremos back-relations em User/Lead.
model VoipCall {
  id Int @id @default(autoincrement())

  leadId     Int? // lead casado (por telefone) — null se não encontrado
  activityId Int? // Activity tipo "call" criada para aparecer na timeline do lead
  userId     Int? // operador que originou (click_to_call)
  userName   String? @db.VarChar(191)

  extension String? @db.VarChar(20) // ramal de origem
  phone     String  @db.VarChar(30) // número discado (destino)
  callerId  String? @db.VarChar(30) // bina usada (dialcallerid)
  direction String  @default("outbound") @db.VarChar(10) // outbound | inbound

  provider       String  @default("falemais") @db.VarChar(30)
  providerCallId String? @db.VarChar(191) // FaleMais: id do v1/dial (32 hex). WhatsApp: call_id (~80 chars) — por isso 191.
  uniqueid       String? @db.VarChar(64) // uniqueid do CDR da API de Gravações

  // dialing | answered | no_answer | busy | failed | completed
  status     String    @default("dialing") @db.VarChar(20)
  startedAt  DateTime  @default(now())
  answeredAt DateTime?
  durationSec Int?

  recordingUrl      String?   @db.Text // URL pública servida via /uploads/voip-recordings/
  recordingPath     String?   @db.VarChar(255) // caminho relativo dentro de uploads/
  recordingSyncedAt DateTime?

  source String @default("click_to_call") @db.VarChar(20) // click_to_call | bulk_sync
  raw    Json?  @db.Json // payload bruto do provedor (audio/info ou /ligacoes) p/ debug

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([providerCallId])
  @@index([uniqueid])
  @@index([startedAt])
  @@map("bychat_voip_calls")
}

// Gravação/transcrição de reunião online (módulo Reuniões — F1). O bot Vexa
// (self-hosted) entra na reunião, grava e transcreve LOCALMENTE; aqui guardamos
// o ciclo de vida do bot + a transcrição consolidada, ligados ao lead/atividade.
// Ver docs/meetings/F0_CONSENTIMENTO_LGPD.md.
model MeetingRecording {
  id Int @id @default(autoincrement())

  title      String? @db.VarChar(200) // título/nome da reunião (principalmente presencial)
  leadId     Int? // lead a que a reunião se refere
  activityId Int? // Activity type "meeting" na timeline do lead
  bookingId  Int? // Booking de origem (agendamento), se houver
  userId     Int? // operador que disparou o bot
  userName   String? @db.VarChar(191)

  platform        String @default("google_meet") @db.VarChar(20) // google_meet | teams | zoom | presencial
  nativeMeetingId String @db.VarChar(191) // código nativo (ex.: xxx-xxxx-xxx no Meet); presencial-<uuid> no presencial
  meetingUrl      String @db.Text
  language        String @default("pt") @db.VarChar(10)

  // Origem da gravação: online (bot Vexa entra na sala) | presencial (upload de áudio da sala física).
  source String @default("online") @db.VarChar(20)

  // requested | joining | active | transcribing | completed | failed | stopped
  // (presencial usa "transcribing" — invisível ao poller do Vexa — até virar "completed")
  status         String  @default("requested") @db.VarChar(20)
  botId          Int? // id do bot no Vexa
  botContainerId String? @db.VarChar(191)
  errorReason    String? @db.VarChar(500)

  recordingUrl       String? @db.Text // .txt da transcrição servido via /uploads
  recordingPath      String? @db.VarChar(255) // caminho relativo do .txt dentro de uploads/
  audioUrl           String? @db.Text // áudio da reunião (quando "guardar áudio" ativo)
  audioPath          String? @db.VarChar(255)
  videoUrl           String? @db.Text // vídeo da reunião (quando "gravar vídeo" ativo)
  videoPath          String? @db.VarChar(255)
  transcriptText     String? @db.Text // transcrição consolidada (fiel à fala)
  transcriptPolished String? @db.Text // versão revisada pela IA (modo "corrigida")
  transcriptSegments Json?   @db.Json // segmentos {start,end,speaker,text}
  segmentCount       Int     @default(0)

  notifiedAt DateTime? // quando o resumo foi enviado (email/WhatsApp)

  // Presencial (F0-presencial): consentimento registrado pelo operador antes de gravar.
  consentAt DateTime? // quando o operador confirmou que informou/obteve consentimento dos presentes
  consentBy Int? // usuário que confirmou o consentimento

  analysis   Json?     @db.Json // análise IA (F3): resumo, topicos, acaoItems, objecoes, proximosPassos, sentimento
  analyzedAt DateTime? // quando a análise IA foi gerada

  startedAt     DateTime? // bot admitido / reunião iniciada
  endedAt       DateTime? // bot saiu / reunião encerrada
  transcribedAt DateTime? // transcrição consolidada gravada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([activityId])
  @@index([bookingId])
  @@index([status])
  @@index([nativeMeetingId])
  @@index([createdAt])
  @@map("bychat_meeting_recordings")
}

// Licença do bot de reunião POR USUÁRIO (seat) — é a UNIDADE DE COBRANÇA do
// módulo. O bot só é disparado (manual ou autônomo) para reuniões cujo dono
// tenha uma licença ATIVA. Ativar/desativar é por toggle no painel; a partir da
// ativação o bot passa a operar sozinho nas reuniões do usuário (autoJoin).
model UserMeetingBot {
  id     Int     @id @default(autoincrement())
  userId Int     @unique // um seat por usuário
  enabled Boolean @default(false) // licença ativa (cobrança)
  autoJoin Boolean @default(true) // entra sozinho nas reuniões do usuário

  language String  @default("pt") @db.VarChar(10)
  botName  String? @db.VarChar(100) // nome exibido do bot (default "ByChat Transcritor")
  config   Json?   @db.Json // configs extras futuras

  activatedAt       DateTime? // quando a licença foi ativada
  activatedByUserId Int? // admin que ativou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("bychat_user_meeting_bots")
}

// Negociação/proposta de um lead (pipeline: um lead pode ter várias). Reusa
// LossReason (motivo de perda) e Lead.outcome ao fechar.
model Negotiation {
  id     Int    @id @default(autoincrement())
  leadId Int
  titulo String @db.VarChar(191)
  // rascunho | enviada | em_negociacao | aceita | recusada | expirada
  status String @default("rascunho") @db.VarChar(20)

  valorTabela   Decimal? @db.Decimal(12, 2) // soma dos itens (bruto)
  descontoTipo  String?  @db.VarChar(10) // valor | percent
  descontoValor Decimal? @db.Decimal(12, 2)
  frete         Decimal? @db.Decimal(12, 2)
  valorFinal    Decimal? @db.Decimal(12, 2) // calculado

  // Recorrência vs. pagamento único, desnormalizado da soma dos itens para os
  // KPIs não precisarem de JOIN por item. O desconto geral é rateado entre os
  // dois na proporção do subtotal de cada; acréscimos (frete/taxas) caem
  // inteiros no único, que é onde uma taxa pontual pertence.
  valorRecorrente Decimal? @db.Decimal(12, 2) // MRR: mensalidades já com desconto rateado
  valorUnico      Decimal? @db.Decimal(12, 2) // cobrado uma vez só + acréscimos
  moeda         String   @default("BRL") @db.VarChar(3)

  pagamentoForma    String?  @db.VarChar(20) // pix | cartao | boleto | dinheiro
  parcelas          Int?
  entrada           Decimal? @db.Decimal(12, 2)
  condicaoPagamento String?  @db.Text

  // Condições da MENSALIDADE, separadas das do único: desconto no valor avulso e
  // desconto na mensalidade são negociações diferentes e valem valores
  // diferentes — antes um desconto só era rateado entre os dois.
  descontoRecTipo   String?  @db.VarChar(10) // valor | percent
  descontoRecValor  Decimal? @db.Decimal(12, 2)
  pagamentoFormaRec String?  @db.VarChar(20) // pix | boleto | cartao_recorrente | debito_automatico
  vencimentoDiaRec  Int? // dia do mês do vencimento (1-31)

  probabilidade      Int? // 0-100
  validadeAte        DateTime? // proposta expira
  fechamentoPrevisto DateTime?
  responsavelUserId  Int?
  observacoes        String?   @db.Text

  // resultado ao fechar
  resultado    String?   @db.VarChar(10) // won | lost
  lostReasonId Int?
  fechadaEm    DateTime?
  fechadaPor   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       NegotiationItem[]
  attachments NegotiationAttachment[]

  // Módulo Metas e Comissões: a comissão é derivada desta venda (some junto).
  commission  CommissionEntry?
  @@index([leadId])
  @@index([status])
  @@map("bychat_negotiations")
}

model NegotiationItem {
  id            Int      @id @default(autoincrement())
  negotiationId Int
  productId     Int? // link ao Catálogo (null = item livre)
  nome          String   @db.VarChar(191)
  quantidade    Int      @default(1)
  precoUnit     Decimal  @db.Decimal(12, 2)
  descontoItem  Decimal? @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)

  // unico = cobrança de uma vez só (setup, projeto, taxa de adesão…);
  // recorrente = mensalidade (entra no MRR). Default `unico` porque inflar o
  // MRR com item mal classificado é o erro mais caro dos dois.
  cobranca String @default("unico") @db.VarChar(12)
  // Só p/ `unico`: em quantas vezes o item foi parcelado (null/1 = à vista).
  parcelas Int?
  // Só p/ `recorrente`: prazo do contrato em meses (opcional; usado para o
  // valor total do contrato, nunca para o MRR).
  recorrenciaMeses Int?

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
  @@map("bychat_negotiation_items")
}

model NegotiationAttachment {
  id            Int      @id @default(autoincrement())
  negotiationId Int
  fileName      String   @db.VarChar(255)
  storagePath   String   @db.VarChar(255) // relativo a /uploads
  mimeType      String?  @db.VarChar(100)
  fileSize      Int?
  createdAt     DateTime @default(now())

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
  @@map("bychat_negotiation_attachments")
}

// Catálogo de Produtos e Serviços — o que a empresa vende (mercadoria, serviço,
// plano, mensalidade). Fonte da verdade para o chatbot de IA e origem dos itens
// das propostas do módulo Negociações. A IA
// consulta este catálogo via ferramenta (consultar_catalogo) em vez de receber a
// lista no prompt, o que impede a invenção de itens/preços.
model Product {
  id Int @id @default(autoincrement())

  categoria  String  @db.VarChar(100) // agrupamento livre, definido pela empresa
  nome       String  @db.VarChar(191) // nome do item como o cliente o conhece
  descricao  String? @db.Text // especificações / detalhes
  preco      Decimal? @db.Decimal(10, 2)
  estoque    Int? // quantidade; null = não controla estoque
  disponivel Boolean @default(true)
  sku        String? @db.VarChar(60)
  marca      String? @db.VarChar(100)
  imageUrl   String? @db.Text
  active     Boolean @default(true)
  // Tipo de cobrança padrão do item (unico | recorrente). O item puxado para
  // uma negociação já nasce classificado — o operador só corrige a exceção.
  cobranca   String   @default("unico") @db.VarChar(12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoria])
  @@index([nome])
  @@index([active])
  @@map("bychat_products")
}

// Auditoria de cada webhook recebido (Pagar.me/Asaas). Persistido ANTES do
// processamento — se o handler falhar, ainda temos o payload pra debug.
model PaymentWebhookHit {
  id           Int                        @id @default(autoincrement())
  connectionId Int?                       // null se token inválido
  connection   PaymentProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  provider     String  @db.VarChar(20)   // pagarme | asaas
  eventType    String  @db.VarChar(100)  // charge.paid | order.payment_failed | ...
  externalId   String? @db.VarChar(191)  // ch_... / payment id — extraído do payload

  // Resultado do processamento
  // received    = chegou mas ainda não processado (fallback)
  // processed   = OK
  // ignored     = evento não reconhecido (200 OK ao provider)
  // notFound    = enrollment não encontrado (200 OK pra parar retentativas)
  // error       = falhou
  status         String  @default("received") @db.VarChar(20)
  registrationId Int?
  errorMessage   String? @db.Text
  payload        Json    @db.Json
  signatureValid Boolean @default(true)   // sempre true por ora (não validamos assinatura ainda)

  remoteIp   String? @db.VarChar(45)
  userAgent  String? @db.Text
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt(sort: Desc)])
  @@index([connectionId, receivedAt(sort: Desc)])
  @@index([externalId])
  @@index([status])
  @@map("bychat_payment_webhook_hits")
}

// Cupom de desconto — cadastro admin. Ainda NÃO é aplicado no checkout
// (integração futura). A estrutura permite percentual ou valor fixo, escopo
// por portal, validade, limite de usos.
model Coupon {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  // 'percent' = value em % (1-100); 'fixed' = value em R$
  type  String  @db.VarChar(10)
  value Decimal @db.Decimal(12, 2)

  // Limites
  minAmount     Decimal? @db.Decimal(12, 2)   // só vale acima desse valor
  maxDiscount   Decimal? @db.Decimal(12, 2)   // teto p/ tipo percent
  usageLimit    Int?                           // null = ilimitado
  usageCount    Int      @default(0)
  perUserLimit  Int      @default(1)           // limite por CPF

  // Escopo (JSON array de portalIds; null = todos os portais)
  portalIds Json? @db.Json

  // Validade
  validFrom  DateTime?
  validUntil DateTime?
  active     Boolean   @default(true)

  redemptions CouponRedemption[]

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([active])
  @@map("bychat_coupons")
}

// Cada vez que um cupom é aplicado a uma inscrição (snapshot do desconto).
model CouponRedemption {
  id             Int     @id @default(autoincrement())
  couponId       Int
  coupon         Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  registrationId Int                                       // FK lógica (sem cascade — histórico imutável)

  amountBefore   Decimal @db.Decimal(12, 2)
  discountValue  Decimal @db.Decimal(12, 2)
  amountAfter    Decimal @db.Decimal(12, 2)

  // Snapshot da config do cupom no momento do uso (proteção contra mudança posterior)
  couponSnapshot Json @db.Json

  redeemedAt DateTime @default(now())

  @@index([couponId])
  @@index([registrationId])
  @@map("bychat_coupon_redemptions")
}

// Rascunho de inscrição: salva formData intermediário por sessão.
// Permite ao candidato recuperar progresso se fechar o browser.
model EnrollmentDraft {
  id       Int              @id @default(autoincrement())
  portalId Int
  portal   EnrollmentPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  sessionId   String @unique @db.VarChar(64)
  formData    Json   @db.Json
  currentStep Int    @default(0)

  // Contatos opcionais para resume por email/whatsapp
  email     String? @db.VarChar(191)
  whatsapp  String? @db.VarChar(30)
  ipAddress String? @db.VarChar(45)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portalId])
  @@index([expiresAt])
  @@index([email])
  @@index([whatsapp])
  @@map("bychat_enrollment_drafts")
}

// Registro de uma inscrição submetida via portal. Complementa ProcessRegistration
// com dados específicos do portal (pagamento, documentos, candidateCode).
model EnrollmentRegistration {
  id       Int              @id @default(autoincrement())
  portalId Int
  portal   EnrollmentPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  processRegistrationId Int?                 @unique
  processRegistration   ProcessRegistration? @relation(fields: [processRegistrationId], references: [id], onDelete: SetNull)

  candidateCode String @unique @db.VarChar(30)

  status String @default("pending") @db.VarChar(30)
  // pending | paid | docs_uploaded | docs_reviewing | docs_approved | docs_rejected
  // approved | rejected | enrolled | cancelled | expired

  formData Json @db.Json

  // Pagamento
  paymentId        String?   @db.VarChar(191)
  paymentStatus    String?   @db.VarChar(20)
  paymentUrl       String?   @db.Text
  paymentAmount    Decimal?  @db.Decimal(12, 2)
  paymentMethod    String?   @db.VarChar(30)
  paymentPaidAt    DateTime?
  paymentExpiresAt DateTime?

  documents        EnrollmentDocument[]
  enemScoreImports EnemScoreImport[]
  presencialExams  PresencialExam[]
  essaySubmissions EssaySubmission[]
  paymentMethods   EnrollmentPaymentMethod[]

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  ipAddress   String? @db.VarChar(45)
  userAgent   String? @db.Text
  utmSource   String? @db.VarChar(100)
  utmMedium   String? @db.VarChar(100)
  utmCampaign String? @db.VarChar(191)
  fbclid      String? @db.VarChar(191)
  gclid       String? @db.VarChar(191)
  referrer    String? @db.Text

  // Login do candidato no portal (SHA256 do segredo)
  accessHash String? @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portalId])
  @@index([status])
  @@index([paymentStatus])
  @@index([leadId])
  @@index([createdAt])
  @@map("bychat_enrollment_registrations")
}

// Checkout transparente: 1 linha por método ativo na inscrição (PIX/Boleto/Cartão).
// Permite o candidato trocar de método (cada um tem dados/timestamps próprios) e
// guardar dados sensíveis-mas-públicos (QR code, linha digitável) sem inflar
// EnrollmentRegistration. Status reflete o último estado conhecido do provedor.
model EnrollmentPaymentMethod {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  method   String @db.VarChar(20) // pix | boleto | credit_card
  provider String @db.VarChar(20) // asaas | pagarme

  externalId String? @db.VarChar(191) // id no provedor (order/charge/payment)
  status     String  @default("pending") @db.VarChar(20) // pending | paid | expired | failed | refunded
  amount     Decimal @db.Decimal(12, 2)
  expiresAt  DateTime?

  // PIX
  qrCode    String? @db.Text     // string copy-paste
  qrCodeUrl String? @db.Text     // URL da imagem PNG

  // Boleto
  boletoLine    String? @db.VarChar(60)  // linha digitável
  boletoBarcode String? @db.VarChar(60)
  boletoPdfUrl  String? @db.Text
  boletoDueAt   DateTime?

  // Cartão (só metadados, NUNCA o PAN — tokenização via JS do provider)
  cardLastDigits String? @db.VarChar(4)
  cardBrand      String? @db.VarChar(20)
  cardHolderName String? @db.VarChar(191)

  // Último erro do provedor (recusa, antifraude, etc) — exibido na UI
  lastErrorMessage String? @db.Text

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([registrationId])
  @@index([externalId])
  @@index([status])
  @@map("bychat_enrollment_payment_methods")
}

// F3 — Registro de importação/extração de boletim ENEM por inscrição.
// Criado automaticamente pelo worker de análise documental quando um doc
// do tipo `boletim_enem` é processado com sucesso. Mantém histórico
// completo para recursos/fiscalização.
model EnemScoreImport {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  documentId     Int?                   @unique
  document       EnrollmentDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  // Dados extraídos do boletim
  nome      String? @db.VarChar(191)
  inscricao String? @db.VarChar(30)
  ano       Int?
  treineiro Boolean @default(false)

  // 5 notas ENEM
  cienciasHumanas  Float?
  cienciasNatureza Float?
  linguagens       Float?
  matematica       Float?
  redacao          Float?

  // Agregados calculados
  mediaSimples   Float? // (CH+CN+LG+MT+RD)/5
  mediaPonderada Float? // reservado para fórmulas customizadas por oferta

  // Validação cruzada com o que o candidato informou no form
  nomeBateComForm      Boolean?
  inscricaoBateComForm Boolean?
  anoBateComForm       Boolean?

  // Resultado da classificação automática (F3.3)
  cutoffScore Float? // snapshot da nota de corte aplicada no momento
  passed      Boolean? // null = ainda não classificado

  // Auditoria
  source       String @default("ai") @db.VarChar(20) // ai | manual
  aiConfidence Float?
  rawAnalysis  Json? // snapshot do aiAnalysis que gerou este registro

  // Revisão humana (override opcional)
  validatedBy    Int?
  validatedAt    DateTime?
  validationNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([inscricao])
  @@index([ano])
  @@index([passed])
  @@map("bychat_edu_enem_score_imports")
}

model EnrollmentDocument {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // FK opcional para DocumentType. Nullable por compatibilidade com docs pré-F2
  // que só tinham o campo `type` string-livre. Novos uploads devem ligar typeId.
  typeId Int?
  type   DocumentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  // Campo legado: string livre do tipo. Mantido para compatibilidade com documentos
  // antigos. Novos uploads usam typeId + lookup no DocumentType.
  typeCode String @db.VarChar(30)

  label     String @db.VarChar(100)
  fileUrl   String @db.Text
  fileName  String @db.VarChar(191)
  mimeType  String @db.VarChar(50)
  sizeBytes Int

  // Status final da review (decisão humana, final).
  // pending | approved | rejected
  status     String    @default("pending") @db.VarChar(20)
  reviewNote String?   @db.Text
  reviewedBy Int?
  reviewedAt DateTime?

  // ═══ F2: Análise IA (Claude Sonnet 4.6 com visão) ═══
  // Status do processamento IA: pending (enfileirado) | processing | done | failed | skipped
  // skipped = DocumentType sem aiAnalysisTemplate, ou IA desligada para essa conta
  aiStatus String @default("pending") @db.VarChar(20)

  // Sugestão da IA ao operador humano: approve | review | reject
  // Humano tem palavra final em `status`; aiSuggestion só orienta.
  aiSuggestion String? @db.VarChar(20)

  // Confiança da sugestão [0.0–1.0]. Abaixo do threshold cai automaticamente em review.
  aiConfidence Float?

  // Output estruturado do modelo: dados extraídos + flags + raciocínio resumido.
  // Schema depende do aiAnalysisTemplate do tipo (ex: rg_cpf → { nome, cpf, rgNumero... }).
  aiAnalysis Json?

  // Tokens/custo gastos (auditoria + telemetria).
  aiCostUsd Float?

  aiProcessedAt DateTime?

  uploadedAt DateTime @default(now())

  enemScoreImport EnemScoreImport?

  @@index([registrationId])
  @@index([status])
  @@index([typeId])
  @@index([aiStatus])
  @@map("bychat_enrollment_documents")
}

// ─── Vestibular Presencial (modo exam_presencial) ──────────────
// Agendamento + lançamento de nota + veredito do time comercial.
// Cada inscrição pode ter no máximo 1 exam (ou histórico se reagendar — TBD).
model PresencialExam {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Agendamento
  scheduledAt DateTime?
  location    String?   @db.VarChar(255)
  room        String?   @db.VarChar(50)
  seatNumber  String?   @db.VarChar(20)

  // Presença na prova: scheduled | present | absent
  attendanceStatus String @default("scheduled") @db.VarChar(20)

  // Correção
  score    Float?
  maxScore Float?
  examNote String? @db.Text

  // Veredito do time comercial / coordenação
  verdict       String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  verdictBy     Int? // userId
  verdictAt     DateTime?
  verdictReason String?   @db.Text

  // Classificação
  passed        Boolean?
  cutoffApplied Float? // snapshot do cutoff usado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([scheduledAt])
  @@index([verdict])
  @@map("bychat_edu_presencial_exams")
}

// ─── Redação Online (modo vestibular_online) ───────────────────
// 1 submissão por tentativa. Tentativas máximas vêm do SelectionProcess.essayMaxAttempts.
// Cronometrado: startedAt + expiresAt; submissão após expiresAt = inválida no servidor.
model EssaySubmission {
  id             Int                    @id @default(autoincrement())
  registrationId Int
  registration   EnrollmentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Snapshot do tema no momento que a tentativa iniciou (mesmo se SP for editada depois)
  prompt String? @db.Text

  attemptNumber Int @default(1)

  essayText String? @db.LongText
  wordCount Int     @default(0)

  // Estado: draft | submitted | ai_reviewing | needs_human | approved | rejected | expired
  status String @default("draft") @db.VarChar(20)

  // Tempo
  startedAt   DateTime?
  expiresAt   DateTime?
  submittedAt DateTime?

  // IA
  aiScore       Float?
  aiAnalysis    Json? // { criteria: [{key,label,score,comment}], overall, suggestions }
  aiConfidence  Float?
  aiProcessedAt DateTime?
  aiCostUsd     Float?

  // Revisão humana
  humanScore Float?
  humanNote  String?   @db.Text
  reviewedBy Int?
  reviewedAt DateTime?

  // Resolução final
  finalScore    Float?
  passed        Boolean?
  cutoffApplied Float?

  // Anti-fraude (auditoria — incrementado pelo client via beacon)
  pasteAttempts     Int @default(0)
  visibilityChanges Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([status])
  @@index([submittedAt])
  @@map("bychat_edu_essay_submissions")
}

// ─── Sales Engagement ────────────────────────────────────────
// Cadências outbound estilo Outreach/Salesloft. Motor próprio (cadenceScheduler)
// que reusa apenas dispatchAction do workflowActions para envios. Detalhes:
// docs/sales_engagement_core.md e memória project_bychatbeyond_sales_engagement.

model SalesCadence {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(191)
  description String? @db.Text

  // Owner (criador) e equipe responsável (governança/permissões/queries)
  ownerId Int?
  owner   User? @relation("CadenceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId  Int?
  team    Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  status      String @default("draft") @db.VarChar(20) // draft | active | paused | archived
  triggerMode String @default("manual") @db.VarChar(20) // manual | filter
  filterJson  Json?  @db.Json // se triggerMode=filter, query do filtro de leads

  pauseOnReply     Boolean @default(true) // resposta do lead pausa cadência
  exitOnConversion Boolean @default(true) // venda/agendamento removem da cadência
  exitOnStatuses   Json?   @db.Json       // lista de Lead.status que removem da cadência (ex: ["GANHO","PERDIDO"])

  // Fase 23.1: auto-enroll quando lead for marcado como Perdido com uma destas objeções.
  // Ex: [1, 3] = inscreve automaticamente leads perdidos por "Sem orçamento" ou "Decidiu não comprar".
  // Lista vazia ou null = sem auto-enroll (modo manual/filter padrão).
  entryOnLossReasonIds Json? @db.Json

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([teamId])
  @@index([ownerId])
  @@map("bychat_sales_cadences")
}

model CadenceStep {
  id        Int          @id @default(autoincrement())
  cadenceId Int
  cadence   SalesCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  order      Int // ordem do step na cadência (0, 1, 2…)
  dayOffset  Int @default(0) // dias após o step anterior (ou após enrollment, se primeiro)
  hourOffset Int @default(0) // horas adicionais ao dayOffset

  channel    String           @db.VarChar(20) // whatsapp | email | sms | call | manual | linkedin
  templateId Int?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  isManual      Boolean @default(false) // true → cria Activity em vez de envio automático
  isBreakUp     Boolean @default(false) // step de "break-up message" (último automático)
  conditionJson Json?   @db.Json // ex: { "tag": "hot" } — só executa se condição satisfeita

  // Builder visual (Fase 26): posição no canvas e branching opcional. Quando
  // nextStepId/altStepId são null o cadenceScheduler segue o modelo linear
  // legado (ordem por `order`).
  positionX  Int  @default(0)
  positionY  Int  @default(0)
  nextStepId Int?
  altStepId  Int?

  executions CadenceStepExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cadenceId, order])
  @@index([cadenceId])
  @@index([templateId])
  @@map("bychat_cadence_steps")
}

model CadenceEnrollment {
  id        Int          @id @default(autoincrement())
  cadenceId Int
  cadence   SalesCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  leadId    Int
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  enrolledAt   DateTime  @default(now())
  currentStep  Int       @default(0) // próximo step a executar (índice em CadenceStep.order)
  nextActionAt DateTime? // quando o cadenceScheduler deve processar este enrollment
  status       String    @default("active") @db.VarChar(20) // active | paused | completed | exited

  exitReason     String?   @db.VarChar(50) // replied | converted | opted_out | max_attempts | canceled | fora_fit
  pauseReason    String?   @db.VarChar(50) // reply_received | manual | governance_blocked
  lastReplyClass String?   @db.VarChar(30) // resultado do cadenceReplyClassifier (positiva|objecao|...)
  lastActionAt   DateTime?

  executions CadenceStepExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cadenceId, leadId])
  @@index([status, nextActionAt])
  @@index([leadId])
  @@map("bychat_cadence_enrollments")
}

// E4: cada execução de step gera uma linha aqui — permite drill-down completo
// no dashboard (por canal, por operador, por status). Cobre tanto envios
// automáticos (status='sent') quanto activities manuais (status='created_activity'
// + activityId) e bloqueios de governança (status='skipped_*').
model CadenceStepExecution {
  id           Int               @id @default(autoincrement())
  enrollmentId Int
  enrollment   CadenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       Int
  step         CadenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  leadId       Int
  cadenceId    Int

  channel String @db.VarChar(20) // whatsapp | email | sms | call | manual | linkedin
  // sent | created_activity | skipped_opt_out | skipped_blacklist | skipped_silence_window
  // | skipped_frequency_cap | skipped_template_missing | skipped_empty_body | failed
  status  String @db.VarChar(40)

  // Pra step manual: id da Activity criada + operador que completou (preenchido
  // depois quando o operador marca a Activity como completed).
  activityId     Int?
  operatorUserId Int?
  operator       User? @relation("CadenceStepExecutionOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  completedAt    DateTime?

  errorMessage String? @db.Text
  jobId        String? @db.VarChar(100) // BullMQ job id pra rastreabilidade

  executedAt DateTime @default(now())

  @@index([cadenceId, executedAt])
  @@index([enrollmentId])
  @@index([leadId])
  @@index([channel, executedAt])
  @@index([operatorUserId])
  @@index([activityId])
  @@map("bychat_cadence_step_executions")
}

// Governança de canal POR EQUIPE. Lida pelo messageGovernance.canSendNow:
// silence window, frequency cap diário e blacklist específicos do time.
// teamId NULL = config "global" (fallback quando lead não tem teamId).
// Por equipe → permite times com SLAs/políticas distintas (ex: vendas mais agressiva,
// pós-venda mais restrita).
model ChannelGovernance {
  id     Int  @id @default(autoincrement())
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // { "whatsapp": 2, "email": 1, "sms": 1 }  — chaves ausentes = sem limite.
  maxPerChannelPerDay Json @db.Json
  // { "start": "22:00", "end": "08:00", "weekends": true }
  silenceWindow       Json @db.Json
  // { "phones": ["55119...","55…"], "emails": ["x@y.com"] }
  blacklist           Json @db.Json

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId])
  @@map("bychat_channel_governance")
}

// ═════════════════════════════════════════════
// FERRAMENTAS — UTM Builder (catálogo de URLs taggeadas)
// ═════════════════════════════════════════════
//
// Biblioteca de URLs com UTMs reaproveitáveis. Operadores constroem uma URL
// taggeada, salvam com label interno, e podem reusar/exportar. Independente
// do `TrackableLink` (link encurtado /t/:slug) — mas integrável depois.
model UtmLink {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(191)   // label interno: "Black Friday WhatsApp post"
  baseUrl     String   @db.VarChar(2048)  // URL antes dos UTMs
  utmSource   String   @db.VarChar(100)
  utmMedium   String   @db.VarChar(100)
  utmCampaign String   @db.VarChar(191)
  utmTerm     String?  @db.VarChar(191)
  utmContent  String?  @db.VarChar(191)
  utmId       String?  @db.VarChar(191)   // Meta usa pra atribuição cross-device
  fullUrl     String   @db.Text           // URL final montada (cache pra busca/cópia)
  notes       String?  @db.Text
  tags        Json?    @db.Json           // ["lançamento", "Q4"]
  active      Boolean  @default(true)
  archived    Boolean  @default(false)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([utmCampaign])
  @@index([utmSource, utmMedium])
  @@index([active, archived])
  @@map("bychat_utm_links")
}

// Persona / ICP — perfil estruturado do cliente ideal. Vira contexto pro
// chatbot, Sales AI e cadências (system prompt + tom de voz consistente).
model Persona {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(191)        // "Coordenadora pedagógica de escola média"
  description  String?  @db.Text                // narrativa 2-3 parágrafos
  ageRange     String?  @db.VarChar(60)         // "30-45"
  genderHint   String?  @db.VarChar(40)         // "majoritariamente feminino"
  location     String?  @db.VarChar(191)        // "interior SP/MG"
  occupation   String?  @db.VarChar(191)
  income       String?  @db.VarChar(60)         // "R$ 5k-15k"
  painPoints   Json?    @db.Json                // string[]
  objections   Json?    @db.Json                // string[]
  triggers     Json?    @db.Json                // string[] — eventos/sinais que disparam compra
  channels     Json?    @db.Json                // string[] — WhatsApp/Email/Instagram/...
  voiceTone    String?  @db.Text                // "Profissional mas próximo, evitar gírias, usar exemplos pedagógicos"
  examplePhrases Json?  @db.Json                // string[] — frases que o cliente usaria
  goals        Json?    @db.Json                // string[] — objetivos do cliente
  active       Boolean  @default(true)          // false = arquivada
  isDefault    Boolean  @default(false)         // a persona "ativa" usada como contexto IA padrão
  createdById  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, isDefault])
  @@map("bychat_personas")
}

// Auditoria automática de conversas por IA. Roda async em background — analisa
// as mensagens trocadas no lead, devolve score 0-100, tom predominante,
// tempos de resposta e oportunidades perdidas. Usada para ranking de operadores
// e alertas de qualidade.
model ConversationAudit {
  id                Int      @id @default(autoincrement())
  leadId            Int
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Operador "principal" do lead no momento da auditoria (snapshot).
  // Fica null para leads sem operador atribuído — agregação por operador filtra null.
  operatorId        Int?
  operatorName      String?  @db.VarChar(100)
  // Período auditado (geralmente janela das últimas N mensagens).
  periodFrom        DateTime?
  periodTo          DateTime?
  messageCount      Int      @default(0)
  // Score 0-100 calculado pela IA combinando tom, atendimento, follow-up, etc.
  score             Int?     @db.SmallInt
  // Categorização do tom: cordial | neutro | frio | agressivo | inconsistente
  tone              String?  @db.VarChar(20)
  // Métricas mensuráveis sem IA — calculadas a partir das mensagens.
  responseTimeAvgSec Int?
  responseTimeP95Sec Int?
  // O que a IA observou — listas curtas de bullet points.
  strengths         Json?    @db.Json // string[]
  weaknesses        Json?    @db.Json // string[]
  missedOpportunities Json?  @db.Json // string[]
  // Aderência a script/roteiro (0-100 ou null se não aplicável).
  scriptAdherence   Int?     @db.SmallInt
  summary           String?  @db.Text
  modelUsed         String?  @db.VarChar(50)
  status            String   @default("done") @db.VarChar(20) // pending | running | done | failed
  errorMessage      String?  @db.Text
  triggeredBy       String?  @db.VarChar(20) // manual | cron | event
  triggeredById     Int?
  createdAt         DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([operatorId, createdAt])
  @@index([score])
  @@map("bychat_conversation_audits")
}

// Sugestão de movimentação de etapa gerada pela IA — Fase 9 "Jornada Automática".
// Quando o funil tem `aiStageEnabled`, um worker analisa o lead, identifica
// a próxima etapa apropriada e cria uma LeadStageSuggestion. Se a confidence
// ≥ funnel.aiStageThreshold E funnel.aiStageAutoApply=true, aplica automaticamente
// (move o lead). Senão fica como sugestão pendente pra revisão humana.
model LeadStageSuggestion {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  funnelId        Int
  funnel          Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  fromStageKey    String?  @db.VarChar(50)
  // Nulo quando `kind` = 'not_in_funnel': a IA concluiu que o lead não pertence
  // a este funil e não há etapa a sugerir. Antes esse caso virava `null` e era
  // descartado em silêncio, então o operador nunca ficava sabendo.
  suggestedStageKey String? @db.VarChar(50)
  // 'stage' = mover para a etapa sugerida | 'not_in_funnel' = tirar deste funil
  kind            String   @default("stage") @db.VarChar(20)
  confidence      Int      @db.SmallInt  // 0-100
  reasoning       String?  @db.Text
  modelUsed       String?  @db.VarChar(50)
  // pending | applied | rejected | superseded
  status          String   @default("pending") @db.VarChar(20)
  appliedAt       DateTime?
  decidedById     Int?     // operador que aprovou/rejeitou manualmente
  decidedAt       DateTime?
  decisionNote    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([leadId, status])
  @@index([funnelId, status, createdAt])
  @@index([status])
  @@map("bychat_lead_stage_suggestions")
}

// Módulo de importação de leads via planilha (CSV/Excel).
// Cada upload cria 1 row com status=preview + parsedRows JSON (até 5k linhas).
// Quando admin confirma, status vira running → done. errors JSON acumula falhas individuais.
model LeadImport {
  id                Int       @id @default(autoincrement())
  importedByUserId  Int?
  importedBy        User?     @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  fileName          String    @db.VarChar(255)
  fileSize          Int?
  status            String    @default("preview") @db.VarChar(15)
  totals            Json?     @db.Json
  mapping           Json      @db.Json
  parsedRows        String?   @db.MediumText
  errors            Json?     @db.Json
  previewExpiresAt  DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([importedByUserId])
  @@map("bychat_lead_imports")
}

// ─────────────────────────────────────────────────────────────
// Módulo de Agendamento de Reuniões (scheduling) — migration 0074
// FKs escalares (sem relação Prisma) p/ não tocar Lead/User/Funnel.
// ─────────────────────────────────────────────────────────────

model MeetingType {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(191)
  description String? @db.Text
  color       String? @db.VarChar(20)
  active      Boolean @default(true)

  // Regras de reserva
  durationMin        Int    @default(30)
  bufferBeforeMin    Int    @default(0)
  bufferAfterMin     Int    @default(0)
  slotIncrementMin   Int    @default(30)
  minNoticeMin       Int    @default(240) // antecedência mínima (min)
  bookingWindowDays  Int    @default(60) // janela de reserva (dias à frente)
  maxPerDay          Int? // teto de reservas por dia
  visibleSlotsPerDay Int? // limite de slots exibidos por dia
  timezone           String @default("America/Sao_Paulo") @db.VarChar(60)

  // Local
  locationType   String  @default("google_meet") @db.VarChar(30) // google_meet|phone|whatsapp|in_person|custom
  locationDetail String? @db.VarChar(255)

  // Atribuição
  assignmentMode String @default("fixed") @db.VarChar(20) // fixed|round_robin
  ownerUserId    Int?
  teamId         Int?

  // Integração CRM
  funnelId      Int?
  stageKey      String? @db.VarChar(60) // etapa ao agendar
  defaultTeamId Int?
  landingPageId Int?

  // Config (JSON): perguntas extras, mensagens de confirmação, pixel
  intakeFields       Json? @db.Json
  confirmationConfig Json? @db.Json
  pixelConfig        Json? @db.Json

  totalBookings Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([ownerUserId])
  @@map("bychat_meeting_types")
}

model AvailabilitySchedule {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(120)
  ownerUserId   Int? // agenda de um operador
  meetingTypeId Int? // ou específica de um tipo
  timezone      String   @default("America/Sao_Paulo") @db.VarChar(60)
  // [{ weekday: 1, start: "09:00", end: "12:00" }, ...] (0=domingo)
  rules         Json     @db.Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerUserId])
  @@index([meetingTypeId])
  @@map("bychat_availability_schedules")
}

model AvailabilityException {
  id          Int      @id @default(autoincrement())
  scheduleId  Int
  date        DateTime @db.Date
  unavailable Boolean  @default(true) // true=bloqueado; false=horário custom
  startTime   String?  @db.VarChar(5) // "09:00"
  endTime     String?  @db.VarChar(5)
  note        String?  @db.VarChar(191)
  createdAt   DateTime @default(now())

  @@index([scheduleId, date])
  @@map("bychat_availability_exceptions")
}

model Booking {
  id             Int    @id @default(autoincrement())
  token          String @unique @db.VarChar(64) // links públicos remarcar/cancelar
  meetingTypeId  Int
  leadId         Int?
  // Sem FK, apagar o lead deixava a reserva apontando p/ id inexistente.
  lead           Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  operatorUserId Int?

  startAt  DateTime
  endAt    DateTime
  timezone String   @db.VarChar(60)
  status   String   @default("scheduled") @db.VarChar(20) // scheduled|confirmed|completed|cancelled|no_show|rescheduled

  inviteeName  String? @db.VarChar(191)
  inviteeEmail String? @db.VarChar(191)
  inviteePhone String? @db.VarChar(30)
  answers      Json?   @db.Json

  locationType  String? @db.VarChar(30)
  meetLink      String? @db.Text
  googleEventId String? @db.VarChar(255)
  activityId    Int?

  cancelReason      String? @db.VarChar(255)
  rescheduledFromId Int?
  // Confirmação do lead (status scheduled→confirmed). confirmRequestedAt marca quando
  // enviamos o pedido de confirmação (HSM) — escopo do auto-cancelamento 3h antes.
  confirmRequestedAt DateTime?
  confirmedAt        DateTime?
  source            String  @default("scheduling") @db.VarChar(30)
  visitorId         String? @db.VarChar(64)
  utmSource         String? @db.VarChar(191)
  utmMedium         String? @db.VarChar(191)
  utmCampaign       String? @db.VarChar(191)
  utmContent        String? @db.VarChar(191)
  utmTerm           String? @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingTypeId, startAt])
  @@index([operatorUserId, startAt])
  @@index([leadId])
  @@index([status])
  @@map("bychat_bookings")
}

// Compromissos/bloqueios manuais na agenda de um operador. Aparecem no calendário e,
// quando ocupam tempo (busy/event), reduzem a disponibilidade pública (slots).
model CalendarBlock {
  id             Int      @id @default(autoincrement())
  operatorUserId Int?
  title          String   @default("")
  kind           String   @default("busy") // 'busy' (bloqueio) | 'event' (compromisso manual)
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean  @default(false)
  color          String?  @db.VarChar(20)
  note           String?  @db.Text
  createdByUserId Int?
  source         String   @default("manual")
  googleEventId    String? @db.VarChar(191) // evento espelhado no Google Calendar do operador
  googleCalendarId String? @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([operatorUserId, startAt])
  @@index([startAt])
  @@map("bychat_calendar_blocks")
}

// ─────────────────────────────────────────────────────────────
// Integração Kommo CRM — importador (migration 0081)
// ─────────────────────────────────────────────────────────────
// Mapeia IDs externos da Kommo → entidades locais do bychat, sem poluir os
// models core com colunas externalId. Liga lead/contact/pipeline/status/tag/
// note/task/custom_field/user da Kommo aos registros do bychat. Garante
// idempotência do importador: re-sync faz upsert (não duplica).
// `kommoId` é String (VarChar) pra evitar overflow de Int e a dor de BigInt
// no JSON. `meta` guarda dados auxiliares do vínculo (ex: pipelineId do status,
// updatedAt da Kommo p/ sync incremental, contactId principal de um lead, etc).
model KommoMapping {
  id         Int      @id @default(autoincrement())
  entityType String   @db.VarChar(30) // lead | contact | pipeline | status | tag | note | task | custom_field | user
  kommoId    String   @db.VarChar(40)
  localId    Int
  meta       Json?    @db.Json
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, kommoId])
  @@index([entityType, localId])
  @@map("bychat_kommo_mappings")
}

// ═════════════════════════════════════════════
// MÓDULO HELPDESK / CHAMADOS (Fase 0 — núcleo)
// ═════════════════════════════════════════════
//
// Entidade Ticket dedicada (NÃO estende Lead): um solicitante abre N tickets ao
// longo do tempo e suporte por email/portal não deve poluir o pipeline de vendas.
// Vínculos com Lead/User/Team são escalares indexados (sem @relation) para que a
// migração seja 100% aditiva — `prisma db push` só cria tabelas novas, sem tocar
// em Lead/User/Team. FK relations declaradas serão adicionadas em fases futuras
// conforme a necessidade (relatórios, joins). Ver docs/helpdesk/PLANO_MODULO_HELPDESK.md.

model HelpdeskTicket {
  id      Int    @id @default(autoincrement())
  number  Int    @unique // protocolo sequencial por tenant (ver HelpdeskSequence)
  subject String @db.VarChar(255)

  // new | open | pending | on_hold | solved | closed
  status   String @default("new") @db.VarChar(20)
  // low | normal | high | urgent
  priority String @default("normal") @db.VarChar(10)
  // question | incident | problem | task
  type     String @default("question") @db.VarChar(20)
  // email | web | whatsapp | chat | api | phone | manual
  channel  String @default("manual") @db.VarChar(20)

  // Atribuição (escalares indexados — sem FK em F0)
  assignedUserId Int?
  teamId         Int?

  // Solicitante: vincula opcionalmente a um Lead existente; campos desnormalizados
  // cobrem tickets sem lead (suporte anônimo / email externo).
  requesterLeadId Int?
  requesterName   String? @db.VarChar(191)
  requesterEmail  String? @db.VarChar(191)
  requesterPhone  String? @db.VarChar(30)

  organizationId Int? // F9 — vínculo B2B (auto por domínio do e-mail)
  isSpam         Boolean @default(false) // F13 — fila de spam/suspeitos

  customFields Json? @db.Json
  tags         Json? @db.Json // [tagId,...] simplificado em F0; junction dedicada em fase futura

  // Marcos de SLA / ciclo de vida (preenchidos por F1/F4)
  firstResponseAt DateTime?
  solvedAt        DateTime?
  closedAt        DateTime?
  reopenCount     Int       @default(0)
  lastActivityAt  DateTime  @default(now())

  // SLA (F4) — metas calculadas e status corrente. Status: pending|met|at_risk|breached.
  slaPolicyId             Int?
  targetFirstResponseAt   DateTime?
  targetResolutionAt      DateTime?
  slaFirstResponseStatus  String?   @db.VarChar(10)
  slaResolutionStatus     String?   @db.VarChar(10)
  slaPausedAt             DateTime? // != null quando o relógio de resolução está pausado
  slaPausedMs             Int       @default(0) // tempo total já pausado (ms)
  slaBreachNotifiedAt     DateTime? // evita notificar breach repetidamente

  // F27 — SLA de PRÓXIMA RESPOSTA: relógio que arma quando o cliente responde e
  // para quando o agente responde publicamente. Status: pending|met|at_risk|breached.
  targetNextResponseAt    DateTime?
  slaNextResponseStatus   String?   @db.VarChar(10)

  createdById   Int?
  createdByName String? @db.VarChar(100)

  // F26 — origem de migração (importador Zendesk/Freshdesk). Idempotência por
  // (externalSource, externalId): re-import não duplica.
  externalSource String? @db.VarChar(20) // zendesk | freshdesk
  externalId     String? @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    HelpdeskComment[]
  events      HelpdeskTicketEvent[]
  followers   HelpdeskFollower[]
  attachments HelpdeskAttachment[]

  @@index([status, priority])
  @@index([assignedUserId])
  @@index([teamId])
  @@index([requesterLeadId])
  @@index([requesterEmail])
  @@index([organizationId])
  @@index([createdAt])
  @@index([externalSource, externalId])
  @@map("bychat_helpdesk_tickets")
}

// Seguidores/CC de um ticket: usuários internos (userId) ou e-mails externos
// (email) que recebem cópia das respostas públicas. Notificação real chega na F5.
model HelpdeskFollower {
  id       Int            @id @default(autoincrement())
  ticketId Int
  ticket   HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId Int? // seguidor interno (operador)
  email  String? @db.VarChar(191) // seguidor externo (CC)
  name   String? @db.VarChar(100)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("bychat_helpdesk_followers")
}

// Anexos do ticket. Reusa o padrão de storage de LeadAttachment (uploads/ servido
// via /uploads/*). commentId opcional vincula o anexo a uma mensagem da thread.
model HelpdeskAttachment {
  id       Int            @id @default(autoincrement())
  ticketId Int
  ticket   HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  commentId   Int? // anexo de um comentário específico (opcional)
  fileName    String  @db.VarChar(255)
  fileSize    Int
  mimeType    String  @db.VarChar(120)
  storagePath String  @db.VarChar(255) // relativo a /uploads (ex: helpdesk-attachments/12-xxx.png)

  uploadedById   Int?
  uploadedByName String? @db.VarChar(100)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([commentId])
  @@map("bychat_helpdesk_attachments")
}

model HelpdeskComment {
  id       Int            @id @default(autoincrement())
  ticketId Int
  ticket   HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType   String  @default("agent") @db.VarChar(20) // agent | requester | system
  authorUserId Int?
  authorName   String? @db.VarChar(100)
  visibility   String  @default("public") @db.VarChar(10) // public | internal
  channel      String? @db.VarChar(20)

  body        String  @db.Text
  bodyHtml    String? @db.Text
  messageId   Int? // link p/ bychat_messages quando o canal é WhatsApp (sem FK em F0)
  attachments Json?   @db.Json

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("bychat_helpdesk_comments")
}

model HelpdeskTicketEvent {
  id       Int            @id @default(autoincrement())
  ticketId Int
  ticket   HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  type      String  @db.VarChar(40) // created | status_changed | assigned | priority_changed | comment_added | ...
  userId    Int?
  userName  String? @db.VarChar(100)
  actorType String  @default("system") @db.VarChar(20) // agent | requester | system

  title    String  @db.VarChar(191)
  oldValue String? @db.Text
  newValue String? @db.Text
  metadata Json?   @db.Json

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([type])
  @@map("bychat_helpdesk_ticket_events")
}

// Política de SLA (F4). Avaliadas por `order` ASC; a primeira cujas `conditions`
// casam define as metas. `firstResponseMins`/`resolutionMins` são mapas por
// prioridade ({low,normal,high,urgent} → minutos). `useBusinessHours` faz o
// cálculo respeitar o calendário (`calendarId`); senão é 24/7.
model HelpdeskSlaPolicy {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(120)
  order    Int     @default(0)
  active   Boolean @default(true)

  // { priorities?: string[], channels?: string[], types?: string[], teamIds?: number[] }
  conditions        Json @db.Json
  firstResponseMins Json @db.Json // { low, normal, high, urgent } em minutos
  resolutionMins    Json @db.Json // { low, normal, high, urgent } em minutos
  nextResponseMins  Json? @db.Json // F27 — meta de PRÓXIMA resposta (opcional) { low, normal, high, urgent }

  useBusinessHours Boolean @default(false)
  calendarId       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@map("bychat_helpdesk_sla_policies")
}

// Calendário de expediente p/ SLA com business hours. `weekdayHours` mapeia
// 0(domingo)..6(sábado) → faixas [{start:"09:00",end:"18:00"}]. `holidays` são
// datas "YYYY-MM-DD" ignoradas. `timezone` IANA (default America/Sao_Paulo).
model HelpdeskBusinessCalendar {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(120)
  timezone     String @default("America/Sao_Paulo") @db.VarChar(50)
  weekdayHours Json   @db.Json
  holidays     Json   @db.Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bychat_helpdesk_business_calendars")
}

// AUTOMAÇÃO (F5) — macros, triggers e automations compartilham o mesmo formato
// de `actions` Json: { setStatus?, setPriority?, setType?, assignUserId?,
// teamId?, addTagIds?: number[], reply?: { body, visibility } }.

// Macro: conjunto nomeado de ações + texto de resposta, aplicado com 1 clique.
model HelpdeskMacro {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(120)
  actions       Json    @db.Json
  replyTemplate String? @db.Text
  active        Boolean @default(true)
  usageCount    Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bychat_helpdesk_macros")
}

// Trigger: executa AÇÕES quando um EVENTO ocorre e as CONDIÇÕES casam.
// event: created | replied | status_changed
model HelpdeskTrigger {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(120)
  event      String  @db.VarChar(30)
  conditions Json    @db.Json // { priorities?, channels?, types?, statuses?, teamIds?, subjectContains? }
  actions    Json    @db.Json
  active     Boolean @default(true)
  order      Int     @default(0)
  runCount   Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, event, order])
  @@map("bychat_helpdesk_triggers")
}

// Automation: regra baseada em TEMPO (cron), ex.: "pending há 3 dias → fechar".
model HelpdeskAutomation {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(120)
  conditions Json    @db.Json // { statuses?, olderThanMins?, noFirstResponse?, channels? }
  actions    Json    @db.Json
  active     Boolean @default(true)
  runCount   Int     @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bychat_helpdesk_automations")
}

// BASE DE CONHECIMENTO / HELP CENTER (F6)
model KbCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(160)
  description String?  @db.VarChar(500)
  icon        String?  @db.VarChar(40)
  position    Int      @default(0)
  active      Boolean  @default(true)
  externalSource String? @db.VarChar(20) // F26 — migração
  externalId     String? @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles KbArticle[]

  @@index([active, position])
  @@index([externalSource, externalId])
  @@map("bychat_helpdesk_kb_categories")
}

model KbArticle {
  id         Int         @id @default(autoincrement())
  categoryId Int?
  category   KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title    String  @db.VarChar(255)
  slug     String  @unique @db.VarChar(280)
  excerpt  String? @db.VarChar(500)
  body     String  @db.LongText // HTML/markdown
  keywords String? @db.VarChar(500) // termos extras p/ busca

  status     String @default("draft") @db.VarChar(12) // draft | published
  visibility String @default("public") @db.VarChar(12) // public | internal
  locale     String @default("pt-BR") @db.VarChar(10)

  votesUp   Int @default(0)
  votesDown Int @default(0)
  viewCount Int @default(0)

  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.VarChar(500)

  authorId   Int?
  authorName String? @db.VarChar(100)

  externalSource String? @db.VarChar(20) // F26 — migração
  externalId     String? @db.VarChar(64)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, visibility])
  @@index([categoryId])
  @@index([externalSource, externalId])
  @@map("bychat_helpdesk_kb_articles")
}

// Relacionamento entre tickets (F10). Uma linha por relação, na perspectiva de
// `ticketId` → `linkedTicketId`. Tipos: related | duplicate | blocks |
// blocked_by | parent | child | problem | incident | follow_up | merged.
// O lado inverso é computado na exibição (ver inverseLinkType no código).
model HelpdeskTicketLink {
  id             Int    @id @default(autoincrement())
  ticketId       Int
  linkedTicketId Int
  type           String @db.VarChar(20)

  createdById   Int?
  createdByName String? @db.VarChar(100)
  createdAt     DateTime @default(now())

  @@unique([ticketId, linkedTicketId, type])
  @@index([ticketId])
  @@index([linkedTicketId])
  @@map("bychat_helpdesk_ticket_links")
}

// Organização (B2B, F9). `domains` (["acme.com"]) auto-vinculam o solicitante
// pelo domínio do e-mail. `slaPolicyId` força uma política de SLA para a org.
model HelpdeskOrganization {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  domains     Json     @db.Json // ["acme.com", "acme.com.br"]
  supportPlan String?  @db.VarChar(80) // ex.: Free | Standard | Premium
  slaPolicyId Int? // override de política de SLA para a org
  notes       String?  @db.Text
  active      Boolean  @default(true)
  externalSource String? @db.VarChar(20) // F26 — migração
  externalId     String? @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([externalSource, externalId])
  @@map("bychat_helpdesk_organizations")
}

// F27 — Conversa paralela ("side conversation"): thread separada com um TERCEIRO
// (fornecedor, outra área, especialista) vinculada a um ticket, invisível ao
// solicitante. Enviada por e-mail ou WhatsApp reusando os providers de canal.
model HelpdeskSideConversation {
  id       Int @id @default(autoincrement())
  ticketId Int

  channel     String  @db.VarChar(20) // email | whatsapp
  targetName  String? @db.VarChar(150)
  targetEmail String? @db.VarChar(191)
  targetPhone String? @db.VarChar(30)
  subject     String? @db.VarChar(255)
  status      String  @default("open") @db.VarChar(10) // open | closed

  createdById    Int?
  createdByName  String?  @db.VarChar(100)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages HelpdeskSideMessage[]

  @@index([ticketId])
  @@map("bychat_helpdesk_side_conversations")
}

model HelpdeskSideMessage {
  id                 Int                      @id @default(autoincrement())
  sideConversationId Int
  conversation       HelpdeskSideConversation @relation(fields: [sideConversationId], references: [id], onDelete: Cascade)

  direction  String  @db.VarChar(10) // outbound | inbound
  authorName String? @db.VarChar(100)
  body       String  @db.Text

  createdAt DateTime @default(now())

  @@index([sideConversationId, createdAt])
  @@map("bychat_helpdesk_side_messages")
}

// CSAT / Pesquisa de satisfação (F8). Uma pesquisa por ticket (idempotente),
// criada ao resolver. `token` é a credencial pública do link de avaliação.
model HelpdeskSurvey {
  id       Int @id @default(autoincrement())
  ticketId Int @unique
  token    String @unique @db.VarChar(48)

  rating  Int?    // 1..5 (👍=5 / 👎=1 quando thumbs)
  comment String? @db.Text

  agentUserId Int?
  teamId      Int?

  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([respondedAt])
  @@index([agentUserId])
  @@map("bychat_helpdesk_surveys")
}

// QA automático (F19) — auditoria de qualidade do atendimento por IA. Uma por ticket.
model HelpdeskQaReview {
  id        Int     @id @default(autoincrement())
  ticketId  Int     @unique
  score     Int? // 0-100
  tone      String? @db.VarChar(20) // cordial | neutro | frio | agressivo | inconsistente
  strengths Json?
  weaknesses Json?
  summary   String? @db.Text

  agentUserId    Int?
  autoGenerated  Boolean @default(true)
  reviewerUserId Int? // revisão/ajuste humano opcional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentUserId])
  @@map("bychat_helpdesk_qa_reviews")
}

// Contador de protocolo por tenant. `update ... increment` é atômico no InnoDB;
// o @unique em HelpdeskTicket.number é a defesa final contra colisão.
model HelpdeskSequence {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50) // 'ticket'
  current   Int      @default(1000)
  updatedAt DateTime @updatedAt

  @@map("bychat_helpdesk_sequences")
}

// =====================================================================
// MÓDULO ACADÊMICO (NATIVO) — Fase 0 (M1/M2/M4/M5)
// ids Int; sem tenantId (multi-tenant por install); centavos Int;
// tabelas bychat_aca_. Ver docs/projeto-erp-academico/04_05_06.
// FKs cross-módulo (courseId, courseOfferingId, enrollmentDraftId,
// userId) são escalares por design (sem @relation, p/ não tocar models
// existentes). Lead↔Aluno é relação 1:1 (Pessoa = Contato).
// =====================================================================

enum AcaPapel {
  ALUNO
  PROFESSOR
  RESPONSAVEL
  COORDENADOR
  SECRETARIA
}
enum AcaTipoResponsavel {
  FINANCEIRO
  PEDAGOGICO
  LEGAL
  CONTRATO
  FAMILIAR
}
enum AcaTurno {
  MATUTINO
  VESPERTINO
  NOTURNO
  INTEGRAL
  EAD
}
enum AcaMatriculaStatus {
  INSCRITO
  PRE_MATRICULA
  MATRICULADO
  TRANCADO
  TRANSFERIDO
  CONCLUIDO
  EVADIDO
  CANCELADO
}

/// Situação do vínculo aluno↔curso. As transições válidas são whitelist em
/// services/acaVinculo.ts — qualquer outra é rejeitada.
enum AcaVinculoSituacao {
  PRE_MATRICULADO
  ATIVO
  /// Cumpriu todos os componentes curriculares e falta apenas estágio, TCC ou
  /// atividades complementares. No SISTEC é "Integralizar em Fase Escolar" — sem
  /// esta situação o aluno fica indevidamente como "em curso" ou é evadido por
  /// engano, e ele é justamente o caso mais comum da escola técnica.
  INTEGRALIZANDO
  TRANCADO
  EVADIDO
  /// Saiu para outra instituição/unidade.
  TRANSFERIDO
  /// Mudou de curso DENTRO da mesma unidade. O SISTEC distingue as duas
  /// transferências e a estatística da unidade muda conforme o caso.
  TRANSFERIDO_INTERNO
  CANCELADO
  FORMADO
  DIPLOMADO
  FALECIDO
}

/// Matriz é imutável depois de ter aluno vinculado: alteração vira nova versão.
enum AcaMatrizStatus {
  RASCUNHO
  ATIVA
  SUSPENSA // não recebe ingressantes, mas segue válida para quem já está nela
  EXTINTA
}

/// Tipo do componente na matriz — define contra qual "balde" de carga horária
/// ele conta na integralização.
enum AcaComponenteTipo {
  OBRIGATORIA
  ELETIVA
  OPTATIVA
  ESTAGIO
  TCC
  ATIVIDADE_COMPLEMENTAR
  EXTENSAO
}

enum AcaAtoEscopo {
  IES
  CURSO
}

/// Onde o esquema de avaliação se aplica. A resolução é em cascata, do mais
/// específico para o mais geral: DISCIPLINA → MATRIZ → CURSO → INSTITUCIONAL.
enum AcaEquivalenciaLado {
  ORIGEM
  DESTINO
}

enum AcaEsquemaEscopo {
  INSTITUCIONAL
  CURSO
  MATRIZ
  DISCIPLINA
}

enum AcaEscalaNota {
  NUMERICA_0_10
  NUMERICA_0_100
  CONCEITO
}

enum AcaArredondamento {
  MATEMATICO // 7,45 → 7,5 (padrão)
  CIMA
  BAIXO
}
enum AcaParcelaTipo {
  MATRICULA
  MENSALIDADE
  MATERIAL
  TAXA
  OUTRO
  ACORDO
}
enum AcaParcelaSituacao {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA
  RENEGOCIADA
}
enum AcaContratoStatus {
  ATIVO
  QUITADO
  CANCELADO
  RENEGOCIADO
}
enum AcaBolsaTipo {
  PERCENTUAL
  VALOR
  INTEGRAL
}
enum AcaIntegracaoStatus {
  PENDENTE
  SUCESSO
  ERRO
}
enum AcaMovimentacaoTipo {
  TRANCAMENTO
  REINGRESSO
  AFASTAMENTO
  TRANSFERENCIA_INTERNA
  TRANSFERENCIA_EXTERNA
  REMANEJAMENTO
  RECLASSIFICACAO
  CANCELAMENTO
  EVASAO
}

model Aluno {
  id             Int      @id @default(autoincrement())
  leadId         Int      @unique
  ra             String?  @unique @db.VarChar(30)
  cpf            String?  @db.VarChar(20)
  /// Acesso ao portal por CPF/RA + senha (G6 / RF-701). Nulo = o aluno ainda
  /// só entra pelo link enviado no WhatsApp, que continua valendo.
  portalSenhaHash      String?   @db.VarChar(255)
  portalSenhaDefinidaEm DateTime?
  portalUltimoLoginEm  DateTime?
  /// Tentativas seguidas de senha errada; trava temporária ao estourar.
  portalTentativas     Int       @default(0)
  portalBloqueadoAte   DateTime?
  dataNascimento DateTime?
  sexo           String?  @db.VarChar(12)
  nomeSocial     String?  @db.VarChar(191)
  fotoUrl        String?  @db.Text
  ativo          Boolean  @default(true)
  documentosJson     Json? @db.Json
  socioEconomicoJson Json? @db.Json
  roadmapJson        Json? @db.Json
  // F23 — Ficha completa da pessoa física (campos consultáveis em colunas;
  // o restante [CNH/PIS/título/certidão/militar, sócio-econômico] vive nos JSON).
  rg             String?  @db.VarChar(30)
  rgOrgaoEmissor String?  @db.VarChar(40)
  racaCor        String?  @db.VarChar(40)  // Censo/INEP
  nacionalidade  String?  @db.VarChar(60)
  naturalidade   String?  @db.VarChar(120) // município/UF
  estadoCivil    String?  @db.VarChar(40)
  religiao       String?  @db.VarChar(60)
  nomePai        String?  @db.VarChar(191)
  nomeMae        String?  @db.VarChar(191)
  codigoInep     String?  @db.VarChar(30)
  emancipado     Boolean  @default(false)
  enderecoJson   Json?    @db.Json
  // F23+ — ENEM/GDAE + dados escolares (saída/autorizados)
  codigoGdae     String?  @db.VarChar(30)
  enemAno        Int?
  enemInscricao  String?  @db.VarChar(30)
  enemNota       Float?
  podeSairSozinho Boolean @default(true)
  pessoasAutorizadasJson Json? @db.Json // [{nome, parentesco, documento}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  responsaveis   AcaResponsavel[]
  matriculas     AcaMatricula[]
  ocorrencias    AcaOcorrencia[]
  vinculos       AcaVinculo[]
  regimesEspeciais AcaRegimeEspecial[]
  enadeRegularidade AcaEnadeRegularidade[]

  @@index([cpf])
  @@index([ra])
  @@map("bychat_aca_alunos")
}

// ═════════════════════════════════════════════
// FASE 1 — FUNDAÇÃO ACADÊMICA
//
// Três lacunas estruturais do Documento Mestre, tratadas juntas porque se
// sustentam: hierarquia institucional (G5), ciclo de vida da matriz (G4) e
// vínculo acadêmico (G3). São mudanças de modelagem — quanto mais tarde, mais
// caro, porque histórico e integralização penduram aqui.
//
// Tudo aditivo: nada existente muda de forma, os vínculos novos entram como
// colunas anuláveis e o backfill preenche.
// ═════════════════════════════════════════════

/// Pessoa jurídica que mantém uma ou mais IES.
model AcaMantenedora {
  id             Int      @id @default(autoincrement())
  razaoSocial    String   @db.VarChar(191)
  nomeFantasia   String?  @db.VarChar(191)
  cnpj           String?  @db.VarChar(20)
  // Representante legal — exigido nos atos e contratos.
  repNome        String?  @db.VarChar(191)
  repCpf         String?  @db.VarChar(20)
  repCargo       String?  @db.VarChar(80)
  enderecoJson   Json?    @db.Json
  telefone       String?  @db.VarChar(30)
  email          String?  @db.VarChar(191)
  logoUrl        String?  @db.Text
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ies            AcaIes[]

  @@index([cnpj])
  @@map("bychat_aca_mantenedoras")
}

/// IES (mantida) — é ela que tem código e-MEC e responde pelo regulatório.
model AcaIes {
  id                 Int      @id @default(autoincrement())
  mantenedoraId      Int
  nome               String   @db.VarChar(191)
  sigla              String?  @db.VarChar(30)
  codigoEmec         String?  @db.VarChar(20)
  // privada_com_fins | privada_sem_fins | publica_federal | publica_estadual | publica_municipal
  categoriaAdmin     String?  @db.VarChar(40)
  // faculdade | centro_universitario | universidade | if_cefet
  organizacaoAcad    String?  @db.VarChar(40)
  enderecoJson       Json?    @db.Json
  // Dirigente e Procurador/Recenseador Institucional (PI/RI) — o Censo exige.
  dirigenteNome      String?  @db.VarChar(191)
  dirigenteCpf       String?  @db.VarChar(20)
  dirigenteEmail     String?  @db.VarChar(191)
  piNome             String?  @db.VarChar(191)
  piCpf              String?  @db.VarChar(20)
  piEmail            String?  @db.VarChar(191)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mantenedora        AcaMantenedora @relation(fields: [mantenedoraId], references: [id])

  @@index([mantenedoraId])
  @@index([codigoEmec])
  @@map("bychat_aca_ies")
}

/// Ato autorizativo de IES (credenciamento) ou de curso (autorização,
/// reconhecimento, renovação). Vence — e o vencimento precisa alertar antes.
model AcaAtoAutorizativo {
  id           Int      @id @default(autoincrement())
  escopo       AcaAtoEscopo
  /// id da IES quando escopo=IES; id do Course quando escopo=CURSO
  entidadeId   Int
  tipo         String   @db.VarChar(40) // credenciamento | recredenciamento | autorizacao | reconhecimento | renovacao
  numero       String?  @db.VarChar(40)
  dataPublicacao DateTime?
  dataDou      DateTime?
  validadeAte  DateTime?
  observacao   String?  @db.Text
  arquivoUrl   String?  @db.Text
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([escopo, entidadeId])
  @@index([validadeAte])
  @@map("bychat_aca_atos_autorizativos")
}

/// Vínculo do aluno com um CURSO/MATRIZ — o registro acadêmico (RA) de fato.
///
/// É diferente de AcaMatricula, que liga aluno↔turma (matrícula em disciplina/
/// oferta). O histórico, a integralização e os requisitos de formatura são
/// calculados contra a MATRIZ deste vínculo, não contra o curso genérico.
model AcaVinculo {
  id             Int      @id @default(autoincrement())
  alunoId        Int
  courseId       Int
  matrizId       Int?
  unidadeId      Int?     // campus ou polo — o regulatório exige o local de oferta
  ra             String?  @db.VarChar(30)
  situacao       AcaVinculoSituacao @default(PRE_MATRICULADO)
  /// Código canônico de uma das 10 formas do Censo — NÃO é texto livre.
  /// Lista fechada e validação em services/acaFormaIngresso.ts.
  /// Atenção: "transferência interna" NÃO é forma de ingresso; é situação do
  /// vínculo de origem + cursoOrigemId aqui no vínculo de destino.
  formaIngresso  String?  @db.VarChar(40)
  /// Modo de ingresso (comercial) que originou o vínculo, quando veio de um
  /// processo seletivo. Guarda a rastreabilidade que formaIngresso perde ao
  /// agregar vários modos numa única forma do Censo.
  entryModeId    Int?
  /// Curso de origem na transferência interna — o Censo exige informá-lo no
  /// curso de DESTINO. Também usado em reingresso e mudança de curso.
  cursoOrigemId  Int?
  /// Critério efetivamente aplicado na classificação deste ingresso.
  criterioClassificacao String? @db.VarChar(30)
  /// Documento que ampara o ingresso quando a forma não decorre de disputa por
  /// vaga: ofício de remoção (ex-officio) ou decisão judicial.
  amparoUrl      String?  @db.Text
  turno          AcaTurno?
  periodoAtual   Int?
  dataIngresso   DateTime?
  dataConclusao  DateTime?
  /// Situação sensível (falecimento) suspende cobrança e comunicação automática.
  sensivel       Boolean  @default(false)
  observacao     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  aluno          Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  movimentacoes  AcaVinculoMovimentacao[]
  matriculas     AcaMatricula[]

  @@unique([alunoId, courseId, matrizId])
  @@index([situacao])
  @@index([courseId])
  @@index([ra])
  @@map("bychat_aca_vinculos")
}

/// Toda mudança de situação do vínculo passa por aqui — nunca por edição de
/// campo. Reversão só por contra-movimentação (RN-403), por isso há `estornoDeId`.
model AcaVinculoMovimentacao {
  id           Int      @id @default(autoincrement())
  vinculoId    Int
  de           AcaVinculoSituacao?
  para         AcaVinculoSituacao
  motivo       String?  @db.VarChar(191)
  observacao   String?  @db.Text
  dataEfeito   DateTime @default(now())
  documentoUrl String?  @db.Text
  userId       Int?
  userName     String?  @db.VarChar(100)
  /// Preenchido quando esta movimentação estorna outra.
  estornoDeId  Int?
  metadata     Json?    @db.Json
  createdAt    DateTime @default(now())

  vinculo      AcaVinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, dataEfeito])
  @@index([para])
  @@map("bychat_aca_vinculo_movimentacoes")
}

/// Esquema de avaliação — o regimento da IES traduzido em regras executáveis.
///
/// Antes da Fase 2 a apuração usava 5 parâmetros GLOBAIS em Setting
/// (aca.media_aprovacao etc.), o que obrigava a customizar código a cada
/// cliente novo. Agora cada curso/matriz/disciplina pode ter seu esquema, com
/// herança em cascata (M08/RF-801).
model AcaEsquemaAvaliacao {
  id          Int      @id @default(autoincrement())
  escopo      AcaEsquemaEscopo @default(INSTITUCIONAL)
  /// id do Course, AcaMatriz ou AcaDisciplina conforme o escopo; null no institucional.
  escopoId    Int?
  nome        String   @db.VarChar(191)
  descricao   String?  @db.Text

  escala      AcaEscalaNota @default(NUMERICA_0_10)
  notaMinima  Float    @default(0)
  notaMaxima  Float    @default(10)
  casasDecimais Int    @default(1)
  arredondamento AcaArredondamento @default(MATEMATICO)
  /// Mapa conceito→número quando escala=CONCEITO. Ex: {"A":10,"B":8,"C":6,"D":4,"E":0}
  mapaConceitos Json?  @db.Json

  /// Expressão da média parcial usando as siglas dos componentes.
  /// Ex.: "(N1*4 + N2*6)/10". Vazio = média ponderada pelos pesos.
  formulaMedia String? @db.VarChar(500)

  mediaAprovacao Float @default(6)
  /// Nota mínima em QUALQUER componente para não reprovar direto (eliminatória).
  notaEliminatoria Float?

  exameHabilitado Boolean @default(false)
  /// Faixa que manda para exame: [exameMinimo, mediaAprovacao).
  exameMinimo     Float?
  /// Ex.: "(MP + EX)/2" — MP = média parcial, EX = nota do exame.
  formulaFinal    String? @db.VarChar(500)
  mediaFinalAprovacao Float?

  segundaChamadaHabilitada Boolean @default(false)
  /// Educação profissional: a aptidão é decidida pelo atendimento aos critérios
  /// CRÍTICOS das capacidades, não pela média das notas. Ligado, o fechamento
  /// consulta a lista de verificação; a nota (se houver) passa a ser expressão do
  /// desempenho, não o critério de decisão.
  avaliacaoPorCompetencia Boolean @default(false)

  /// Se a frequência reprova. A LDB (Lei 9.394/96, art. 47, §3º) obriga a
  /// frequência "salvo nos programas de educação a distância" — em EAD o
  /// controle é por atividades no ambiente virtual e pela presença nas
  /// avaliações presenciais, não por chamada. Desligado, o cálculo ignora a
  /// frequência e o piso de 75% deixa de ser imposto.
  frequenciaObrigatoria Boolean @default(true)
  /// Piso de 75% do ensino superior PRESENCIAL: com frequência obrigatória, o
  /// sistema não aceita menos que isso.
  frequenciaMinima Int @default(75)
  /// Regime seriado: máximo de dependências para progredir de período.
  limiteDependencias Int?

  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  componentes AcaEsquemaComponente[]

  @@unique([escopo, escopoId])
  @@index([ativo])
  @@map("bychat_aca_esquemas_avaliacao")
}

/// Componente de nota do esquema (N1, N2, Trabalho…). A sigla é o que a
/// fórmula referencia.
model AcaEsquemaComponente {
  id         Int      @id @default(autoincrement())
  esquemaId  Int
  sigla      String   @db.VarChar(12) // N1, N2, TRAB — usado na fórmula
  nome       String   @db.VarChar(100)
  peso       Float    @default(1)
  ordem      Int      @default(0)
  /// Componente obrigatório: sem nota lançada, a média não fecha.
  obrigatorio Boolean @default(true)

  esquema    AcaEsquemaAvaliacao @relation(fields: [esquemaId], references: [id], onDelete: Cascade)

  @@unique([esquemaId, sigla])
  @@index([esquemaId])
  @@map("bychat_aca_esquema_componentes")
}

/// Regime de exercícios domiciliares / tratamento excepcional.
///
/// No ensino superior NÃO existe abono de faltas — salvo os casos legais:
/// Decreto-Lei 1.044/69 (afecções, traumatismos) e Lei 6.202/75 (gestante).
/// A lei não manda apagar a falta: manda dar tratamento especial ao período,
/// com exercícios domiciliares. Por isso o registro de frequência permanece
/// intacto e é o CÁLCULO que desconsidera as aulas do intervalo deferido —
/// assim o diário continua contando a história real (RN-602 do Documento
/// Mestre).
/// Assinatura de notificação push do portal (G6 / RF-701).
///
/// Uma por navegador/aparelho: o mesmo aluno tem o celular e o computador do
/// laboratório. O endpoint é a identidade da assinatura para o navegador — por
/// isso ele é a chave única, não o aluno.
model AcaPushInscricao {
  id         Int      @id @default(autoincrement())
  alunoId    Int
  endpoint   String   @db.VarChar(500)
  p256dh     String   @db.VarChar(255)
  auth       String   @db.VarChar(255)
  userAgent  String?  @db.VarChar(255)
  ativa      Boolean  @default(true)
  /// Última falha do serviço de push; assinatura morta é desativada, não apagada.
  ultimoErro String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([endpoint])
  @@index([alunoId, ativa])
  @@map("bychat_aca_push_inscricoes")
}

model AcaRegimeEspecial {
  id           Int      @id @default(autoincrement())
  alunoId      Int
  vinculoId    Int?
  /// GESTANTE (Lei 6.202/75) | SAUDE (Dec-Lei 1.044/69) | MILITAR | OUTRO
  tipo         String   @db.VarChar(20)
  dataInicio   DateTime
  dataFim      DateTime
  /// SOLICITADO | DEFERIDO | INDEFERIDO | ENCERRADO — só DEFERIDO afeta o cálculo.
  status       String   @default("SOLICITADO") @db.VarChar(20)
  amparoLegal  String?  @db.VarChar(120)
  atestadoUrl  String?  @db.Text
  observacao   String?  @db.Text
  /// Atividades domiciliares combinadas — a contrapartida que a lei prevê.
  planoAtividades String? @db.Text
  deferidoPor  Int?
  deferidoEm   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aluno        Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId, status])
  @@index([dataInicio, dataFim])
  @@map("bychat_aca_regimes_especiais")
}

/// Termo de eliminação de documentos (Port. 315/2018 + Dec. 9.235/2017).
/// A eliminação de acervo não é um delete: exige listagem, comissão e termo
/// guardado — é o documento que prova que o descarte foi regular.
model AcaEliminacaoTermo {
  id           Int      @id @default(autoincrement())
  numero       String   @db.VarChar(40)
  dataTermo    DateTime @default(now())
  comissao     String   @db.Text
  responsavel  String?  @db.VarChar(191)
  observacao   String?  @db.Text
  /// Snapshot do que foi eliminado — os arquivos somem, a lista permanece.
  itensJson    Json?    @db.Json
  qtdItens     Int      @default(0)
  criadoPor    Int?
  createdAt    DateTime @default(now())

  @@unique([numero])
  @@map("bychat_aca_eliminacao_termos")
}

/// Regularidade do aluno no ENADE. Irregular não cola grau (RN-1104); a
/// dispensa existe, mas precisa estar documentada — por isso o motivo e o
/// documento são exigidos para liberar.
model AcaEnadeRegularidade {
  id           Int      @id @default(autoincrement())
  alunoId      Int
  vinculoId    Int?
  ano          Int
  /// INGRESSANTE | CONCLUINTE — conforme o edital do ciclo.
  condicao     String   @db.VarChar(14)
  /// PENDENTE | INSCRITO | PARTICIPOU | DISPENSADO | IRREGULAR
  situacao     String   @default("PENDENTE") @db.VarChar(14)
  dispensaMotivo String? @db.Text
  documentoUrl String?  @db.Text
  observacao   String?  @db.Text
  registradoPor Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aluno        Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, ano, condicao])
  @@index([situacao])
  @@map("bychat_aca_enade_regularidade")
}

/// Banco de questões do processo seletivo (M02/T-203).
model AcaQuestao {
  id          Int      @id @default(autoincrement())
  area        String   @db.VarChar(60) // Português, Matemática, Conhecimentos gerais…
  enunciado   String   @db.Text
  /// OBJETIVA (múltipla escolha) | DISSERTATIVA (correção manual/redação)
  tipo        String   @default("OBJETIVA") @db.VarChar(14)
  /// [{ id: "a", texto: "…" }] — só para objetivas.
  alternativas Json?   @db.Json
  /// Letra da alternativa correta.
  gabarito    String?  @db.VarChar(4)
  peso        Float    @default(1)
  /// Rubrica da dissertativa (RF-203): [{ id, criterio, descricao, pontosMax }].
  /// Nota única esconde o julgamento; com critérios pontuados em separado, o
  /// candidato que pede revisão vê ONDE perdeu, e dois corretores diferentes
  /// tendem à mesma nota.
  rubricaJson Json?    @db.Json
  dificuldade String?  @db.VarChar(10) // FACIL | MEDIA | DIFICIL
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       AcaProvaItem[]

  @@index([area, ativa])
  @@map("bychat_aca_questoes")
}

/// Prova montada para um processo seletivo.
model AcaProva {
  id            Int      @id @default(autoincrement())
  processoId    Int?
  titulo        String   @db.VarChar(191)
  instrucoes    String?  @db.Text
  /// Janela de aplicação; fora dela a prova não abre.
  inicioEm      DateTime?
  fimEm         DateTime?
  /// Tempo de prova em minutos, contado a partir do início do candidato.
  duracaoMinutos Int     @default(120)
  notaMaxima    Float    @default(100)
  publicada     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens         AcaProvaItem[]
  aplicacoes    AcaProvaAplicacao[]

  @@index([processoId])
  @@map("bychat_aca_provas")
}

model AcaProvaItem {
  id        Int      @id @default(autoincrement())
  provaId   Int
  questaoId Int
  ordem     Int      @default(0)
  peso      Float    @default(1)

  prova     AcaProva   @relation(fields: [provaId], references: [id], onDelete: Cascade)
  questao   AcaQuestao @relation(fields: [questaoId], references: [id])

  @@unique([provaId, questaoId])
  @@map("bychat_aca_prova_itens")
}

/// Uma tentativa de um candidato. `iniciadaEm` é o relógio: a duração é
/// contada dela, não do horário da janela, para quem entra atrasado não ganhar
/// tempo extra nem perder tudo.
model AcaProvaAplicacao {
  id           Int      @id @default(autoincrement())
  provaId      Int
  inscricaoId  Int?
  candidatoNome String  @db.VarChar(191)
  candidatoCpf String?  @db.VarChar(20)
  /// Token de acesso do candidato (link único).
  token        String   @unique @db.VarChar(64)
  iniciadaEm   DateTime?
  entregueEm   DateTime?
  /// EM_ABERTO | EM_ANDAMENTO | ENTREGUE | CORRIGIDA | EXPIRADA
  status       String   @default("EM_ABERTO") @db.VarChar(14)
  notaObjetiva Float?
  notaDissertativa Float?
  notaFinal    Float?
  observacao   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prova        AcaProva @relation(fields: [provaId], references: [id], onDelete: Cascade)
  respostas    AcaProvaResposta[]

  @@index([provaId, status])
  @@map("bychat_aca_prova_aplicacoes")
}

model AcaProvaResposta {
  id           Int      @id @default(autoincrement())
  aplicacaoId  Int
  questaoId    Int
  /// Letra escolhida (objetiva) ou texto (dissertativa).
  resposta     String?  @db.Text
  correta      Boolean?
  /// Nota da correção manual (dissertativa) e o parecer do corretor.
  notaManual   Float?
  /// Pontos por critério da rubrica: { "<idCriterio>": pontos }. A nota manual
  /// passa a ser a SOMA disto quando a questão tem rubrica.
  rubricaNotasJson Json? @db.Json
  parecer      String?  @db.Text
  corrigidaPor Int?
  corrigidaEm  DateTime?

  aplicacao    AcaProvaAplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)

  @@unique([aplicacaoId, questaoId])
  @@map("bychat_aca_prova_respostas")
}

model AcaResponsavel {
  id         Int      @id @default(autoincrement())
  alunoId    Int
  leadId     Int?
  nome       String   @db.VarChar(191)
  cpf        String?  @db.VarChar(20)
  parentesco String?  @db.VarChar(40)
  tipo       AcaTipoResponsavel @default(FINANCEIRO)
  telefone   String?  @db.VarChar(30)
  email      String?  @db.VarChar(191)
  ativo      Boolean  @default(true)

  aluno      Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  @@index([alunoId])
  @@map("bychat_aca_responsaveis")
}

model AcaPeriodoLetivo {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique @db.VarChar(20)
  descricao  String   @db.VarChar(191)
  anoLetivo  Int?
  dataInicio DateTime?
  dataFim    DateTime?
  ativo      Boolean  @default(true)

  turmas     AcaTurma[]
  @@map("bychat_aca_periodos_letivos")
}

model AcaDisciplina {
  id           Int      @id @default(autoincrement())
  courseId     Int
  nome         String   @db.VarChar(191)
  codigo       String?  @db.VarChar(50)
  cargaHoraria Int      @default(0)
  ementa       String?  @db.Text
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  componentes  AcaComponente[]
  @@index([courseId])
  @@map("bychat_aca_disciplinas")
}

model AcaMatriz {
  id        Int      @id @default(autoincrement())
  courseId  Int
  versao    String   @db.VarChar(40)
  vigenteDe DateTime?
  ativo     Boolean  @default(true)
  // ── Fase 1 (G4): ciclo de vida ──
  nome      String?  @db.VarChar(191)
  /// RASCUNHO permite editar componentes; a partir de ATIVA a matriz é imutável
  /// (alteração vira nova versão — RN-003). Validação em services/acaMatriz.ts.
  status    AcaMatrizStatus @default(RASCUNHO)
  /// Totais de CH exigidos pelo PPC, por balde — a ativação confere os
  /// componentes contra estes números.
  chObrigatoria Int?
  chEletiva     Int?
  chOptativa    Int?
  chEstagio     Int?
  chTcc         Int?
  chComplementar Int?
  chExtensao    Int?
  modulos       AcaMatrizModulo[]
  publicadaEm   DateTime?
  publicadaPor  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  componentes AcaComponente[]
  @@index([courseId])
  @@index([status])
  @@map("bychat_aca_matrizes")
}

/// Módulo (etapa) da matriz, com ou sem terminalidade.
///
/// Res. CNE/CP 1/2021, art. 15, II: a qualificação profissional técnica é
/// "etapa com terminalidade de curso técnico". E o art. 49, §2º é imperativo:
/// ao concluir a etapa com terminalidade que caracterize efetiva qualificação,
/// "SERÁ conferido certificado de qualificação profissional" com o título e a
/// carga horária. Não é faculdade da escola — é direito do aluno, mesmo que ele
/// abandone o curso depois.
enum AcaPpcpStatus {
  RASCUNHO
  AUTORIZADO
  SUSPENSO
  ENCERRADO
}

/// Projeto Pedagógico de Certificação Profissional (PPCP).
///
/// Res. CNE/CP 1/2021, art. 47, §2º: o processo formal de reconhecimento de
/// saberes "deve ser precedido de autorização pelo respectivo sistema de
/// ensino", tendo como referência o perfil profissional de conclusão e o PPC.
///
/// É a trava que costuma ser ignorada: a escola NÃO pode aplicar uma prova e
/// dispensar o aluno. Sem PPCP autorizado e vigente, o processo não roda — e é o
/// registro do PPCP que sustenta o ato numa fiscalização.
model AcaPpcp {
  id            Int      @id @default(autoincrement())
  courseId      Int
  nome          String   @db.VarChar(191)
  /// Metodologia adotada (o §3º permite a própria da instituição, se autorizada).
  metodologia   String?  @db.Text
  status        AcaPpcpStatus @default(RASCUNHO)
  /// Ato do sistema de ensino que autorizou o projeto.
  atoAutorizacao String? @db.VarChar(191)
  orgaoAutorizador String? @db.VarChar(191)
  autorizadoEm  DateTime?
  /// Fim da vigência da autorização; nulo = sem prazo declarado.
  vigenciaAte   DateTime?
  observacao    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  processos     AcaCertificacaoProcesso[]

  @@index([courseId, status])
  @@map("bychat_aca_ppcp")
}

enum AcaCertificacaoStatus {
  ABERTO
  EM_AVALIACAO
  DEFERIDO
  INDEFERIDO
  CANCELADO
}

/// Processo de reconhecimento de saberes de um candidato.
///
/// O §1º do art. 47 manda avaliar "o itinerário profissional e social do
/// estudante, que inclui estudos não formais e experiência no trabalho (saber
/// informal)" — por isso o itinerário declarado é campo do processo, não anexo
/// solto: é o que a banca lê antes de decidir o que avaliar.
model AcaCertificacaoProcesso {
  id            Int      @id @default(autoincrement())
  ppcpId        Int
  alunoId       Int
  /// Matrícula usada para lançar os aproveitamentos deferidos.
  matriculaId   Int?
  protocolo     String   @db.VarChar(40)
  status        AcaCertificacaoStatus @default(ABERTO)
  /// Experiência profissional e formação não formal declaradas pelo candidato.
  itinerario    String?  @db.Text
  /// Composição da banca avaliadora.
  banca         String?  @db.Text
  parecerFinal  String?  @db.Text
  decididoPor   Int?
  decididoEm    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ppcp          AcaPpcp  @relation(fields: [ppcpId], references: [id])
  avaliacoes    AcaCertificacaoAvaliacao[]

  @@unique([protocolo])
  @@index([alunoId, status])
  @@map("bychat_aca_certificacao_processos")
}

enum AcaCertificacaoResultado {
  RECONHECIDO
  NAO_RECONHECIDO
}

/// Avaliação de um componente dentro do processo de reconhecimento.
model AcaCertificacaoAvaliacao {
  id            Int      @id @default(autoincrement())
  processoId    Int
  componenteId  Int
  /// Instrumento aplicado (prova prática, entrevista técnica, análise de
  /// portfólio…). Reconhecer sem dizer COMO se avaliou não sustenta auditoria.
  instrumento   String   @db.VarChar(191)
  resultado     AcaCertificacaoResultado
  parecer       String?  @db.Text
  avaliadoEm    DateTime @default(now())
  avaliadorNome String?  @db.VarChar(191)
  /// Aproveitamento gerado quando reconhecido — evita lançar duas vezes.
  aproveitamentoId Int?

  processo      AcaCertificacaoProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@unique([processoId, componenteId])
  @@index([processoId])
  @@map("bychat_aca_certificacao_avaliacoes")
}

model AcaMatrizModulo {
  id         Int      @id @default(autoincrement())
  matrizId   Int
  /// Ordem do módulo no itinerário (1, 2, 3…).
  numero     Int
  nome       String   @db.VarChar(191)
  /// Título da qualificação conferida ao concluir. NULO = módulo sem
  /// terminalidade: organiza a grade mas não gera certificado.
  tituloQualificacao String? @db.VarChar(191)
  /// Ocupação correspondente na CBO, quando o CNCT indicar.
  codigoCbo  String?  @db.VarChar(20)
  /// CH declarada da etapa; quando nula, soma-se a dos componentes.
  cargaHoraria Int?
  descricao  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  matriz     AcaMatriz @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  componentes AcaComponente[]

  @@unique([matrizId, numero])
  @@index([matrizId])
  @@map("bychat_aca_matriz_modulos")
}

/// Tipo de capacidade na Metodologia SENAI de Educação Profissional.
enum AcaCapacidadeTipo {
  TECNICA
  SOCIAL
  ORGANIZATIVA
  METODOLOGICA
}

/// Peso do critério na decisão de aptidão.
enum AcaCriterioPeso {
  /// Sem atender, o aluno NÃO está apto — independentemente do resto.
  CRITICO
  /// Contribui para a qualidade do desempenho, mas não reprova sozinho.
  DESEJAVEL
}

/// Capacidade/competência que o componente desenvolve.
///
/// Na educação profissional a unidade curricular não "vale nota": ela
/// desenvolve capacidades, e o aluno demonstra domínio delas. O que decide a
/// aptidão é o atendimento aos critérios CRÍTICOS — não a média. Um aluno pode
/// somar pontos suficientes e não estar apto, porque falhou num crítico.
model AcaCapacidade {
  id           Int      @id @default(autoincrement())
  componenteId Int
  tipo         AcaCapacidadeTipo @default(TECNICA)
  descricao    String   @db.Text
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  componente   AcaComponente @relation(fields: [componenteId], references: [id], onDelete: Cascade)
  criterios    AcaCriterio[]

  @@index([componenteId])
  @@map("bychat_aca_capacidades")
}

/// Critério de avaliação de uma capacidade, com a evidência a observar.
model AcaCriterio {
  id            Int      @id @default(autoincrement())
  capacidadeId  Int
  descricao     String   @db.Text
  /// O que o docente deve observar para dizer que foi atendido.
  evidencia     String?  @db.Text
  peso          AcaCriterioPeso @default(DESEJAVEL)
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())

  capacidade    AcaCapacidade @relation(fields: [capacidadeId], references: [id], onDelete: Cascade)
  afericoes     AcaAfericao[]

  @@index([capacidadeId])
  @@map("bychat_aca_criterios")
}

/// Como o critério foi atendido — a lista de verificação do docente.
enum AcaAfericaoResultado {
  ATENDE
  EM_DESENVOLVIMENTO
  NAO_ATENDE
}

/// Registro do desempenho do aluno num critério.
///
/// Reapresentação é da natureza do modelo: quando o aluno não atende um critério
/// crítico, o docente retoma a capacidade — por isso guardamos a tentativa e
/// mantemos o histórico em vez de sobrescrever silenciosamente.
model AcaAfericao {
  id           Int      @id @default(autoincrement())
  criterioId   Int
  matriculaId  Int
  resultado    AcaAfericaoResultado
  /// Evidência observada em concreto (o que o aluno fez).
  observacao   String?  @db.Text
  tentativa    Int      @default(1)
  afericaoEm   DateTime @default(now())
  docenteUserId Int?

  criterio     AcaCriterio @relation(fields: [criterioId], references: [id], onDelete: Cascade)

  @@unique([criterioId, matriculaId, tentativa])
  @@index([matriculaId])
  @@map("bychat_aca_afericoes")
}

model AcaComponente {
  id           Int      @id @default(autoincrement())
  matrizId     Int
  disciplinaId Int
  fase         Int      @default(1)
  obrigatoria  Boolean  @default(true)
  // ── Fase 1 (G4) ──
  /// Contra qual balde de CH este componente conta na integralização.
  /// `obrigatoria` continua existindo para compatibilidade; `tipo` é a fonte nova.
  tipo         AcaComponenteTipo @default(OBRIGATORIA)
  /// CH do componente NESTA matriz — pode divergir do catálogo da disciplina.
  chTotal      Int?
  chTeorica    Int?
  chPratica    Int?
  chExtensao   Int?     // curricularização da extensão (Res. CNE/CES 7/2018)
  /// Agrupador de eletivas: "cumprir 240h do grupo Gestão".
  grupoEletiva String?  @db.VarChar(60)
  /// Ordem sugerida dentro da fase (para o editor visual).
  ordem        Int?
  /// Módulo/etapa a que o componente pertence (educação profissional). Nulo em
  /// curso que não é organizado por módulos.
  moduloId     Int?

  matriz       AcaMatriz     @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  disciplina   AcaDisciplina @relation(fields: [disciplinaId], references: [id])
  modulo       AcaMatrizModulo? @relation(fields: [moduloId], references: [id], onDelete: SetNull)
  capacidades  AcaCapacidade[]
  preRequisitos AcaPreRequisito[] @relation("AcaComponenteAlvo")

  @@unique([matrizId, disciplinaId])
  @@index([matrizId, fase])
  @@map("bychat_aca_componentes")
}

model AcaPreRequisito {
  id                    Int @id @default(autoincrement())
  componenteId          Int
  componenteRequeridoId Int

  componente            AcaComponente @relation("AcaComponenteAlvo", fields: [componenteId], references: [id], onDelete: Cascade)
  @@unique([componenteId, componenteRequeridoId])
  @@map("bychat_aca_prerequisitos")
}

model AcaTurma {
  id               Int      @id @default(autoincrement())
  courseOfferingId Int?
  periodoLetivoId  Int
  matrizId         Int?
  nome             String   @db.VarChar(191)
  faseAtual        Int?
  turno            AcaTurno?
  capacidade       Int?
  ativo            Boolean  @default(true)
  matriculaAberta  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  periodoLetivo    AcaPeriodoLetivo @relation(fields: [periodoLetivoId], references: [id])
  matriculas       AcaMatricula[]

  @@index([periodoLetivoId])
  @@index([courseOfferingId])
  @@map("bychat_aca_turmas")
}

model AcaMatricula {
  id                Int      @id @default(autoincrement())
  alunoId           Int
  turmaId           Int
  /// Vínculo aluno↔curso a que esta matrícula pertence (Fase 1/G3). Anulável
  /// enquanto o backfill não roda; passa a ser obrigatório na criação.
  vinculoId         Int?
  courseOfferingId  Int?
  status            AcaMatriculaStatus @default(INSCRITO)
  origem            String?  @db.VarChar(40)
  enrollmentDraftId Int?
  listaEspera       Boolean  @default(false)
  dataMatricula     DateTime @default(now())
  dataConclusao     DateTime?
  motivoSaida       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  aluno             Aluno    @relation(fields: [alunoId], references: [id])
  turma             AcaTurma @relation(fields: [turmaId], references: [id])
  vinculo           AcaVinculo? @relation(fields: [vinculoId], references: [id], onDelete: SetNull)
  contrato          AcaContrato?
  eventos           AcaMatriculaEvento[]

  @@unique([alunoId, turmaId])
  @@index([status])
  @@index([vinculoId])
  @@map("bychat_aca_matriculas")
}

model AcaMatriculaEvento {
  id          Int      @id @default(autoincrement())
  matriculaId Int
  de          String?  @db.VarChar(20)
  para        String   @db.VarChar(20)
  obs         String?  @db.Text
  userId      Int?
  createdAt   DateTime @default(now())

  matricula   AcaMatricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  @@index([matriculaId])
  @@map("bychat_aca_matricula_eventos")
}

// F5 — Movimentações Acadêmicas. Registro formal (auditável) de cada movimentação
// da vida do aluno (trancamento, transferência, remanejamento, cancelamento…),
// distinto do simples AcaMatriculaEvento (que só anota a troca de status).
// FKs cross-módulo são SCALAR Int sem @relation (convenção do ERP nativo) — o
// enriquecimento (aluno/turma) é feito na rota por busca explícita.
model AcaMovimentacao {
  id                  Int      @id @default(autoincrement())
  matriculaId         Int
  alunoId             Int
  tipo                AcaMovimentacaoTipo
  statusDe            String?  @db.VarChar(20)
  statusPara          String?  @db.VarChar(20)
  turmaDestinoId      Int?     // transferência interna / remanejamento
  matriculaDestinoId  Int?     // matrícula criada no destino (transf. interna)
  instituicaoDestino  String?  @db.VarChar(191) // transferência externa
  motivo              String?  @db.Text
  dataEfeito          DateTime @default(now())
  dataRetornoPrevista DateTime? // trancamento / afastamento
  protocolo           String?  @db.VarChar(30)
  anexoUrl            String?  @db.Text
  userId              Int?
  createdAt           DateTime @default(now())

  @@index([matriculaId])
  @@index([alunoId])
  @@index([tipo])
  @@map("bychat_aca_movimentacoes")
}

// ── F6 — Currículo Avançado (estende aca_estrutura) ──
enum AcaAproveitamentoOrigem {
  INTERNO
  EXTERNO
  SUFICIENCIA
}
enum AcaAproveitamentoStatus {
  SOLICITADO
  DEFERIDO
  INDEFERIDO
}
enum AcaDependenciaTipo {
  DEPENDENCIA
  ADAPTACAO
}

// Equivalência entre componentes (disciplinas) — usada na validação de grade e
// como base para aproveitamento. FKs scalar (componentes de matriz).
/// Equivalência N:1 e 1:N (RF-502). A tabela AcaEquivalencia continua para os
/// pares simples 1:1 já cadastrados; casos compostos ("Cálculo A + Cálculo B
/// equivalem a Cálculo Único") precisam de grupo, porque a dispensa só vale se
/// TODOS os componentes de origem estiverem cumpridos.
model AcaEquivalenciaGrupo {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(191)
  observacao  String?  @db.Text
  /// Vale nos dois sentidos (origem⇄destino).
  bidirecional Boolean @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       AcaEquivalenciaItem[]

  @@index([ativo])
  @@map("bychat_aca_equivalencia_grupos")
}

model AcaEquivalenciaItem {
  id           Int      @id @default(autoincrement())
  grupoId      Int
  componenteId Int
  /// ORIGEM = o que o aluno cursou; DESTINO = o que fica dispensado.
  lado         AcaEquivalenciaLado

  grupo        AcaEquivalenciaGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, componenteId, lado])
  @@index([componenteId])
  @@map("bychat_aca_equivalencia_itens")
}

model AcaEquivalencia {
  id                      Int      @id @default(autoincrement())
  componenteId            Int      // componente da matriz (alvo)
  componenteEquivalenteId Int      // componente considerado equivalente
  bidirecional            Boolean  @default(true)
  observacao              String?  @db.Text
  createdAt               DateTime @default(now())
  @@index([componenteId])
  @@map("bychat_aca_equivalencias")
}

// Aproveitamento de estudos / dispensa de componente. Quando DEFERIDO, o componente
// conta como cumprido no histórico (montarHistorico soma a carga aproveitada).
model AcaAproveitamento {
  id                      Int      @id @default(autoincrement())
  matriculaId             Int
  alunoId                 Int
  componenteId            Int
  origem                  AcaAproveitamentoOrigem @default(EXTERNO)
  instituicaoOrigem       String?  @db.VarChar(191)
  disciplinaOrigem        String?  @db.VarChar(191)
  cargaHorariaAproveitada Int      @default(0)
  nota                    Float?
  status                  AcaAproveitamentoStatus @default(SOLICITADO)
  parecer                 String?  @db.Text
  documentoId             Int?
  decididoPorUserId       Int?
  decididoEm              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  @@index([matriculaId])
  @@index([alunoId])
  @@index([status])
  @@map("bychat_aca_aproveitamentos")
}

// F7 — Coordenador de curso (Central do Coordenador). Vincula uma pessoa a um
// Course; o portal mostra as turmas/ofertas desse curso e o conteúdo ministrado.
model AcaCoordenador {
  id        Int      @id @default(autoincrement())
  courseId  Int
  nome      String   @db.VarChar(191)
  email     String?  @db.VarChar(191)
  leadId    Int?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([courseId])
  @@map("bychat_aca_coordenadores")
}

// Dependência / Adaptação (DP) — componente que o aluno cursa fora da fase regular.
model AcaDependencia {
  id           Int      @id @default(autoincrement())
  matriculaId  Int
  alunoId      Int
  componenteId Int
  tipo         AcaDependenciaTipo @default(DEPENDENCIA)
  turmaId      Int?
  situacao     String   @db.VarChar(20) @default("EM_CURSO") // EM_CURSO|CUMPRIDA|PENDENTE
  observacao   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([matriculaId])
  @@map("bychat_aca_dependencias")
}

// ── F9 — Financeiro Bancário (back-office; estende aca_financeiro) ──
enum AcaContaFinanceiraTipo {
  RECEITA
  DESPESA
}
enum AcaRecorrenciaPeriodo {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// Plano de contas financeiras (classificação de receitas/despesas).
model AcaContaFinanceira {
  id        Int      @id @default(autoincrement())
  codigo    String   @db.VarChar(30)
  nome      String   @db.VarChar(191)
  tipo      AcaContaFinanceiraTipo @default(RECEITA)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@map("bychat_aca_contas_financeiras")
}

// Conta bancária / convênio de cobrança (boleto registrado, CNAB).
model AcaContaBancaria {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(120)
  bancoCodigo String   @db.VarChar(5)
  agencia     String?  @db.VarChar(12)
  conta       String?  @db.VarChar(20)
  carteira    String?  @db.VarChar(6)
  convenio    String?  @db.VarChar(30)
  cnab        String   @db.VarChar(3) @default("400") // 240 | 400
  cedente     String?  @db.VarChar(191)
  documentoCedente String? @db.VarChar(20) // CNPJ do cedente
  sequencialRemessa Int   @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@map("bychat_aca_contas_bancarias")
}

// Indexador (IGPM, IPCA…) e seus valores por competência.
model AcaIndexador {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(60)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  valores   AcaIndexadorValor[]
  @@map("bychat_aca_indexadores")
}
model AcaIndexadorValor {
  id           Int      @id @default(autoincrement())
  indexadorId  Int
  competencia  String   @db.VarChar(7) // "AAAA-MM"
  valorPct     Float
  indexador    AcaIndexador @relation(fields: [indexadorId], references: [id], onDelete: Cascade)
  @@unique([indexadorId, competencia])
  @@map("bychat_aca_indexador_valores")
}

// Feriado financeiro (ajuste de vencimento p/ próximo dia útil).
model AcaFeriado {
  id    Int      @id @default(autoincrement())
  data  DateTime
  nome  String   @db.VarChar(120)
  @@unique([data])
  @@map("bychat_aca_feriados")
}

// Cobrança recorrente: gera parcelas periodicamente para um contrato/aluno.
model AcaCobrancaRecorrente {
  id                Int      @id @default(autoincrement())
  contratoId        Int
  alunoId           Int
  descricao         String   @db.VarChar(191)
  valorCentavos     Int
  periodo           AcaRecorrenciaPeriodo @default(MENSAL)
  diaVencimento     Int      @default(10)
  contaFinanceiraId Int?
  proximaGeracao    DateTime
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([ativo, proximaGeracao])
  @@map("bychat_aca_cobrancas_recorrentes")
}

// Remessa CNAB gerada (lote de títulos enviados ao banco).
model AcaRemessa {
  id                Int      @id @default(autoincrement())
  contaBancariaId   Int
  sequencial        Int
  layout            String   @db.VarChar(3) // 240 | 400
  qtdTitulos        Int      @default(0)
  valorTotalCentavos Int     @default(0)
  arquivo           String   @db.LongText
  nomeArquivo       String   @db.VarChar(60)
  status            String   @db.VarChar(16) @default("GERADA") // GERADA | ENVIADA | PROCESSADA
  createdAt         DateTime @default(now())
  @@index([contaBancariaId])
  @@map("bychat_aca_remessas")
}

// ── F10 — Cobrança Judicial / Dívida Ativa + Contábil + NFS-e (estende aca_financeiro_bancario) ──
enum AcaCDAStatus {
  INSCRITA
  AJUIZADA
  QUITADA
  CANCELADA
}

// Certidão de Dívida Ativa: consolida parcelas vencidas de um aluno para cobrança judicial.
model AcaCDA {
  id               Int      @id @default(autoincrement())
  numero           String   @unique @db.VarChar(30) // CDA-AAAA-NNNN
  alunoId          Int
  valorCentavos    Int
  qtdParcelas      Int      @default(0)
  status           AcaCDAStatus @default(INSCRITA)
  bloqueioJudicial Boolean  @default(false)
  acordoId         Int?
  inscritaEm       DateTime @default(now())
  ajuizadaEm       DateTime?
  quitadaEm        DateTime?
  observacao       String?  @db.Text
  createdAt        DateTime @default(now())
  @@index([alunoId])
  @@index([status])
  @@map("bychat_aca_cda")
}

// Regra contábil: mapeia um evento financeiro a um par de contas + expressão de histórico.
model AcaRegraContabil {
  id             Int      @id @default(autoincrement())
  evento         String   @db.VarChar(40) // PARCELA_PAGA | PARCELA_GERADA | INSCRICAO_CDA
  contaDebitoId  Int?
  contaCreditoId Int?
  historico      String   @db.VarChar(191) // expressão: {aluno} {parcela} {valor} {data}
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  @@map("bychat_aca_regras_contabeis")
}

// Lançamento contábil gerado (partida dobrada simplificada).
model AcaLancamentoContabil {
  id             Int      @id @default(autoincrement())
  data           DateTime @default(now())
  historico      String   @db.VarChar(255)
  contaDebitoId  Int?
  contaCreditoId Int?
  valorCentavos  Int
  origem         String   @db.VarChar(40) // PARCELA_PAGA
  parcelaId      Int?
  regraId        Int?
  desfeito       Boolean  @default(false)
  createdAt      DateTime @default(now())
  @@index([parcelaId])
  @@index([origem])
  @@map("bychat_aca_lancamentos_contabeis")
}

// Configuração de NFS-e (provedor da prefeitura). A transmissão real depende do
// webservice municipal — aqui guardamos config + ponto de integração.
model AcaNfseConfig {
  id                 Int      @id @default(autoincrement())
  provedor           String?  @db.VarChar(60) // abrasf | ginfes | betha | ...
  ambiente           String   @db.VarChar(12) @default("homologacao")
  cnpjPrestador      String?  @db.VarChar(20)
  inscricaoMunicipal String?  @db.VarChar(30)
  codigoServico      String?  @db.VarChar(20)
  aliquotaPct        Float    @default(0)
  ativo              Boolean  @default(false)
  updatedAt          DateTime @updatedAt @default(now())
  @@map("bychat_aca_nfse_config")
}

// ── F11 — Processo Seletivo (camada admin sobre SelectionProcess/ProcessRegistration) ──
// Reusa ProcessRegistration (status/notaClassificacao/posicaoClassificacao/convocadoEm)
// do módulo educacional. Adiciona componentes de nota, salas e ensalamento.
model AcaProcessoComponente {
  id                 Int      @id @default(autoincrement())
  selectionProcessId Int
  nome               String   @db.VarChar(120)
  peso               Float    @default(1)
  ordem              Int      @default(0)
  createdAt          DateTime @default(now())
  @@index([selectionProcessId])
  @@map("bychat_aca_proc_componentes")
}
model AcaProcessoNota {
  id                    Int   @id @default(autoincrement())
  processRegistrationId Int
  componenteId          Int
  nota                  Float
  @@unique([processRegistrationId, componenteId])
  @@index([processRegistrationId])
  @@map("bychat_aca_proc_notas")
}
model AcaProcessoSala {
  id                 Int      @id @default(autoincrement())
  selectionProcessId Int
  nome               String   @db.VarChar(120)
  local              String?  @db.VarChar(191)
  capacidade         Int      @default(30)
  createdAt          DateTime @default(now())
  @@index([selectionProcessId])
  @@map("bychat_aca_proc_salas")
}
model AcaProcessoEnsalamento {
  id                    Int @id @default(autoincrement())
  selectionProcessId    Int
  processRegistrationId Int @unique
  salaId                Int
  ordem                 Int
  @@index([selectionProcessId])
  @@index([salaId])
  @@map("bychat_aca_proc_ensalamento")
}

// ── F13 — Avaliação Institucional / CPA (depende: educacional) ──
enum AcaAvalPublico {
  ALUNO
  PROFESSOR
  TODOS
}
enum AcaAvalStatus {
  RASCUNHO
  ABERTA
  ENCERRADA
}
enum AcaPerguntaTipo {
  ESCALA
  NPS
  TEXTO
  SIMNAO
}

model AcaAvaliacaoInst {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(191)
  descricao String?  @db.Text
  publico   AcaAvalPublico @default(TODOS)
  status    AcaAvalStatus  @default(RASCUNHO)
  anonima   Boolean  @default(true)
  inicio    DateTime?
  fim       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dimensoes AcaAvalDimensao[]
  @@map("bychat_aca_avaliacoes_inst")
}
model AcaAvalDimensao {
  id          Int      @id @default(autoincrement())
  avaliacaoId Int
  nome        String   @db.VarChar(191)
  ordem       Int      @default(0)
  avaliacao   AcaAvaliacaoInst @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  perguntas   AcaAvalPergunta[]
  @@index([avaliacaoId])
  @@map("bychat_aca_aval_dimensoes")
}
model AcaAvalPergunta {
  id         Int      @id @default(autoincrement())
  dimensaoId Int
  tipo       AcaPerguntaTipo @default(ESCALA)
  enunciado  String   @db.Text
  ordem      Int      @default(0)
  dimensao   AcaAvalDimensao @relation(fields: [dimensaoId], references: [id], onDelete: Cascade)
  @@index([dimensaoId])
  @@map("bychat_aca_aval_perguntas")
}
model AcaAvalResposta {
  id          Int      @id @default(autoincrement())
  avaliacaoId Int
  perguntaId  Int
  sessaoId    String   @db.VarChar(40) // agrupa as respostas de um respondente
  valor       Int?     // ESCALA(1-5) / NPS(0-10) / SIMNAO(0|1)
  texto       String?  @db.Text
  origem      String?  @db.VarChar(20) // aluno | professor
  createdAt   DateTime @default(now())
  @@index([avaliacaoId])
  @@index([perguntaId])
  @@map("bychat_aca_aval_respostas")
}

// ── F14 — Docente / RH Acadêmico (depende: aca_pedagogico) ──
enum AcaDocenteRegime {
  HORISTA
  PARCIAL
  INTEGRAL
}
enum AcaAtividadeDocenteStatus {
  LANCADA
  APROVADA
  PAGA
}
enum AcaDocenteAceiteStatus {
  PENDENTE
  ACEITO
  RECUSADO
}

// Docente: dados acadêmicos/RH sobre um User-professor (userId scalar).
model AcaDocente {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  titulacao       String?  @db.VarChar(40) // Especialista | Mestre | Doutor
  regime          AcaDocenteRegime @default(HORISTA)
  valorHoraCentavos Int    @default(0)
  ativo           Boolean  @default(true)
  orientador      Boolean  @default(false) // F23+ — papel Orientador
  observacao      String?  @db.Text
  dadosJson       Json?    @db.Json // conta bancária, registro estadual, departamento, tipo, CTPS, qualificação
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  atividades      AcaAtividadeDocente[]
  aceites         AcaDocenteAceite[]
  @@map("bychat_aca_docentes")
}

// Tipo de atividade docente com fator (aula=1, preparação=0.5, etc.).
model AcaTipoAtividadeDocente {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  fatorHora Float    @default(1)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@map("bychat_aca_tipos_atividade_docente")
}

// Atividade docente lançada numa competência (mês), com valor calculado.
model AcaAtividadeDocente {
  id              Int      @id @default(autoincrement())
  docenteId       Int
  tipoId          Int
  competencia     String   @db.VarChar(7) // AAAA-MM
  descricao       String?  @db.VarChar(191)
  horas           Float    @default(0)
  valorHoraCentavos Int    @default(0)
  fatorHora       Float    @default(1)
  valorCentavos   Int      @default(0) // horas * valorHora * fator
  status          AcaAtividadeDocenteStatus @default(LANCADA)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  docente         AcaDocente @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  @@index([docenteId])
  @@index([competencia])
  @@map("bychat_aca_atividades_docente")
}

// Aceite/disponibilidade do docente para um diário (turma×disciplina).
model AcaDocenteAceite {
