  @@index([metaFormId])
  @@index([status])
  @@index([createdAt])
  @@map("bychat_meta_lead_logs")
}

// ─── Beyond Tracking (Analytics interno) ─────────────────

model TrackingVisitor {
  id              Int      @id @default(autoincrement())
  visitorId       String   @unique @db.VarChar(64) // ID gerado no browser (cookie bt_vid)
  fingerprint     String?  @db.VarChar(64) // Canvas+WebGL+Audio fingerprint hash
  leadId          Int? // Vinculado quando identificado
  identifiedEmail String?  @db.VarChar(191)
  identifiedPhone String?  @db.VarChar(30)
  identifiedName  String?  @db.VarChar(191)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  totalSessions   Int      @default(0)
  totalPageviews  Int      @default(0)
  totalEvents     Int      @default(0)
  metadata        Json?    @db.Json // Device info, browser, OS, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions TrackingSession[]
  events   TrackingEvent[]

  @@index([fingerprint])
  @@index([leadId])
  @@index([identifiedEmail])
  @@index([identifiedPhone])
  @@index([lastSeenAt])
  @@map("bychat_tracking_visitors")
}

model TrackingSession {
  id           Int             @id @default(autoincrement())
  sessionId    String          @unique @db.VarChar(64) // ID gerado no browser (sessionStorage)
  visitorId    Int
  visitor      TrackingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  duration     Int             @default(0) // Segundos
  pageviews    Int             @default(0)
  events       Int             @default(0)
  entryUrl     String?         @db.Text
  exitUrl      String?         @db.Text
  referrer     String?         @db.VarChar(500)
  utmSource    String?         @db.VarChar(100)
  utmMedium    String?         @db.VarChar(100)
  utmCampaign  String?         @db.VarChar(191)
  utmContent   String?         @db.VarChar(191)
  utmTerm      String?         @db.VarChar(191)
  ip           String?         @db.VarChar(45)
  userAgent    String?         @db.Text
  language     String?         @db.VarChar(20)
  screenWidth  Int?
  screenHeight Int?
  deviceType   String?         @db.VarChar(20) // desktop, mobile, tablet
  browser      String?         @db.VarChar(50)
  os           String?         @db.VarChar(50)
  country      String?         @db.VarChar(5)
  createdAt    DateTime        @default(now())

  trackingEvents TrackingEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([ip])
  @@index([startedAt, deviceType])
  @@map("bychat_tracking_sessions")
}

model TrackingEvent {
  id        Int              @id @default(autoincrement())
  visitorId Int
  visitor   TrackingVisitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId Int?
  session   TrackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type      String           @db.VarChar(30) // pageview, click, scroll, form_start, form_submit, custom, identify
  url       String?          @db.Text
  title     String?          @db.VarChar(500)
  referrer  String?          @db.Text
  data      Json?            @db.Json // Dados extras: scroll_depth, click coords, element selector, custom props
  timestamp DateTime         @default(now())

  @@index([visitorId, timestamp])
  @@index([sessionId])
  @@index([type])
  @@index([timestamp])
  @@index([type, timestamp])
  @@map("bychat_tracking_events")
}

// ─── Landing Pages & Forms ───────────────────────────────

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPage {
  id    Int    @id @default(autoincrement())
  slug  String @unique @db.VarChar(191)
  title String @db.VarChar(191)

  metaTitle       String? @db.VarChar(191)
  metaDescription String? @db.Text
  ogImage         String? @db.Text
  favicon         String? @db.Text

  sections     Json    @db.Json // Array de section configs
  globalStyles Json?   @db.Json // Cores, fontes, spacing overrides
