  details   String?   @db.Text
  auto      Boolean   @default(true)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdBy String?   @db.VarChar(191) // email do admin que bloqueou manualmente
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ip, active])
  @@index([active])
  @@index([expiresAt])
  @@map("bychat_ip_blocks")
}

