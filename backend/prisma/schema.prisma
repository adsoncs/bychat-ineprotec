  updatedAt          DateTime @updatedAt

  contrato           AcaContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  @@index([contratoId])
  @@index([situacao, dataVencimento])
  @@index([asaasChargeId])
  @@map("bychat_aca_parcelas")
}

model AcaIntegracaoEvento {
  id              Int      @id @default(autoincrement())
  origem          String   @db.VarChar(40)
  eventoExternoId String   @db.VarChar(191)
  status          AcaIntegracaoStatus @default(PENDENTE)
  requestJson     Json?    @db.Json
  responseJson    Json?    @db.Json
  erroMotivo      String?  @db.Text
  tentativas      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([origem, eventoExternoId])
  @@index([status])
  @@map("bychat_aca_integracao_eventos")
}

model AcaOcorrencia {
  id         Int      @id @default(autoincrement())
  alunoId    Int?
  turmaId    Int?
  tipo       String   @db.VarChar(60)
  descricao  String   @db.Text
  anexosJson Json?    @db.Json
  userId     Int?
  createdAt  DateTime @default(now())

  aluno      Aluno?   @relation(fields: [alunoId], references: [id])
  @@index([alunoId])
  @@map("bychat_aca_ocorrencias")
}

// ───────────────── M6 · NÚCLEO ACADÊMICO — P6.1 Diário + Frequência ─────────────────
// Diário por turma×disciplina. Aulas registradas. Frequência por aula×matrícula.
// turmaId/disciplinaId/matriculaId/professorUserId são escalares (sem @relation).

model AcaDiario {
  id              Int      @id @default(autoincrement())
  turmaId         Int
  disciplinaId    Int
  professorUserId Int?
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aulas           AcaAula[]
  avaliacoes      AcaAvaliacao[]
  @@unique([turmaId, disciplinaId])
  @@index([turmaId])
  @@map("bychat_aca_diarios")
}

model AcaAula {
  id               Int      @id @default(autoincrement())
  diarioId         Int
  data             DateTime
  conteudo         String   @db.Text
  quantidadeAulas  Int      @default(1)
  createdAt        DateTime @default(now())

  diario           AcaDiario @relation(fields: [diarioId], references: [id], onDelete: Cascade)
  frequencias      AcaFrequencia[]
  @@index([diarioId, data])
  @@map("bychat_aca_aulas")
}

model AcaFrequencia {
  id          Int     @id @default(autoincrement())
  aulaId      Int
  matriculaId Int
  presente    Boolean @default(true)
  justificada Boolean @default(false)

  aula        AcaAula @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  @@unique([aulaId, matriculaId])
  @@index([matriculaId])
  @@map("bychat_aca_frequencias")
}

// ───────────────── P6.2 · Avaliações + Notas ─────────────────
// Notas em Float (grades, não dinheiro). matriculaId escalar.

model AcaAvaliacao {
  id          Int      @id @default(autoincrement())
  diarioId    Int
  nome        String   @db.VarChar(120)
  /// Sigla do componente no esquema de avaliação (N1, N2, TRAB…). Preenchida
  /// quando o diário é montado a partir do esquema — é o que permite a fórmula
  /// do regimento ser aplicada no fechamento. Nula = avaliação avulsa (legado).
  siglaEsquema String? @db.VarChar(12)
  peso        Int      @default(1)
  valorMaximo Float    @default(10)
  data        DateTime?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())

  diario      AcaDiario @relation(fields: [diarioId], references: [id], onDelete: Cascade)
  notas       AcaNota[]
  @@index([diarioId])
  @@map("bychat_aca_avaliacoes")
}

model AcaNota {
  id           Int      @id @default(autoincrement())
  avaliacaoId  Int
  matriculaId  Int
  valor        Float?
  /// NORMAL | SEGUNDA_CHAMADA. A nota de segunda chamada substitui a avaliação
  /// perdida, mas o histórico precisa saber que ela veio por esse caminho — é o
  /// que sustenta a decisão se o aluno questionar a média depois.
  origem       String   @default("NORMAL") @db.VarChar(20)
  /// Protocolo do requerimento ou justificativa que autorizou a segunda chamada.
  origemObs    String?  @db.Text
  origemEm     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  avaliacao    AcaAvaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  @@unique([avaliacaoId, matriculaId])
  @@index([matriculaId])
  @@map("bychat_aca_notas")
}

// ───────────────── P6.3 · Fechamento + Conselho de Classe ─────────────────
// Resultado por diário×matrícula (média + frequência → situação). Ata por turma.

model AcaResultado {
  id            Int      @id @default(autoincrement())
  diarioId      Int
  matriculaId   Int
  mediaFinal    Float?
  frequenciaPct Int      @default(100)
  situacao      String   @db.VarChar(30) // APROVADO|RECUPERACAO|REPROVADO_NOTA|REPROVADO_FREQUENCIA
  observacao    String?  @db.Text
  fechadoEm     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([diarioId, matriculaId])
  @@index([matriculaId])
  @@map("bychat_aca_resultados")
}

model AcaConselho {
  id        Int      @id @default(autoincrement())
  turmaId   Int      @unique
  ata       String?  @db.Text
  fechadoEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("bychat_aca_conselhos")
}

// ───────────────── P7 · Secretaria / Documentos ─────────────────
// Documentos oficiais NUMERADOS (histórico, declarações, atas). Guarda o
// snapshot dos dados (dadosJson) para reemissão idêntica.

model AcaDocumento {
  id               Int      @id @default(autoincrement())
  numero           String   @unique @db.VarChar(30) // ex.: 2026/0001
  tipo             String   @db.VarChar(40) // HISTORICO|DECLARACAO_MATRICULA|DECLARACAO_FREQUENCIA|ATA_RESULTADOS
  alunoId          Int?
  turmaId          Int?
  titulo           String   @db.VarChar(191)
  dadosJson        Json?    @db.Json
  emitidoPorUserId Int?
  emitidoEm        DateTime @default(now())

  @@index([alunoId])
  @@index([turmaId])
  @@index([tipo])
  @@map("bychat_aca_documentos")
}

// ───────────────── P9 · Comunicação ─────────────────
// Log de avisos enviados ao aluno (idempotência via chaveDedup).

model AcaComunicacao {
  id         Int      @id @default(autoincrement())
  alunoId    Int
  tipo       String   @db.VarChar(20) // VENCIMENTO|FALTAS|NOTAS|MANUAL
  canal      String   @db.VarChar(20) // whatsapp|email
  destino    String   @db.VarChar(191)
  assunto    String?  @db.VarChar(191)
  conteudo   String   @db.Text
  status     String   @db.VarChar(12) @default("ENVIADO") // ENVIADO|FALHA
  erro       String?  @db.Text
  refId      Int?
  chaveDedup String   @unique @db.VarChar(120)
  createdAt  DateTime @default(now())

  @@index([alunoId])
  @@index([tipo])
  @@map("bychat_aca_comunicacoes")
}

// ───────────────── Fin-3 · Renegociação / Acordos ─────────────────
model AcaAcordo {
  id                    Int      @id @default(autoincrement())
  alunoId               Int
  contratoId            Int
  valorOriginalCentavos Int
  valorEncargosCentavos Int      @default(0)
  valorTotalCentavos    Int
  entradaCentavos       Int      @default(0)
  numParcelas           Int
  valorParcelaCentavos  Int
  status                String   @db.VarChar(12) @default("ATIVO") // ATIVO|QUITADO|CANCELADO
  observacao            String?  @db.Text
  // ── Fase 3: acordo fechado pelo próprio devedor no portal ──
  /// SECRETARIA | PORTAL_ALUNO | PORTAL_RESPONSAVEL — quem fechou.
  origem                String   @default("SECRETARIA") @db.VarChar(24)
  /// Desconto concedido sobre multa/juros dentro da política (nunca sobre o principal).
  descontoEncargosCentavos Int   @default(0)
  /// Evidências do aceite eletrônico do termo — é o que sustenta o acordo
  /// depois, já que ninguém assina papel no autoatendimento.
  aceiteEm              DateTime?
  aceiteNome            String?  @db.VarChar(191)
  aceiteDocumento       String?  @db.VarChar(30)
  aceiteIp              String?  @db.VarChar(45)
  aceiteUserAgent       String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([alunoId])
  @@map("bychat_aca_acordos")
}

// ───────────────── Fin-5 · Fiscal (controle de NFS-e) ─────────────────
// Recibo de pagamento usa AcaDocumento (tipo RECIBO). Aqui o controle fiscal:
// rastreia a NFS-e de cada pagamento (registro manual ou via provedor futuro).

model AcaNotaFiscal {
  id            Int      @id @default(autoincrement())
  alunoId       Int
  parcelaId     Int?
  valorCentavos Int
  status        String   @db.VarChar(12) @default("PENDENTE") // PENDENTE|EMITIDA|CANCELADA
  numero        String?  @db.VarChar(40)
  serie         String?  @db.VarChar(20)
  link          String?  @db.Text
  observacao    String?  @db.Text
  emitidaEm     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([alunoId])
  @@index([parcelaId])
  @@map("bychat_aca_notas_fiscais")
}

// ───────────────── O2.2 · Secretaria Virtual / Requerimentos ─────────────────
model AcaRequerimentoTipo {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(120)
  descricao   String?  @db.Text
  slaDias     Int      @default(5)
  geraDocumento String? @db.VarChar(40) // se preenchido, emite doc desse tipo ao deferir
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  // F8 — secretaria avançada
  categoriaId           Int?     // AcaRequerimentoCategoria (scalar)
  custoCentavos         Int      @default(0)     // gera parcela TAXA ao deferir
  deferimentoAutomatico Boolean  @default(false) // resolve já na criação
  restricaoJson         String?  @db.Text        // {roles:[],status:[]} — quem pode solicitar
  camposJson            String?  @db.Text        // campos personalizados do formulário
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("bychat_aca_requerimento_tipos")
}

// F8 — categoria que agrupa tipos de requerimento na secretaria virtual.
model AcaRequerimentoCategoria {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@map("bychat_aca_requerimento_categorias")
}

// F8 — trâmite (encaminhamento) de um requerimento entre setores/usuários.
model AcaRequerimentoTramite {
  id              Int      @id @default(autoincrement())
  requerimentoId  Int
  deUserId        Int?
  paraUserId      Int?
  paraTeamId      Int?
  estado          String?  @db.VarChar(16) // status no momento do trâmite
  comentario      String?  @db.Text
  createdAt       DateTime @default(now())
  @@index([requerimentoId])
  @@map("bychat_aca_requerimento_tramites")
}

model AcaRequerimento {
  id                 Int      @id @default(autoincrement())
  protocolo          String   @unique @db.VarChar(30) // REQ-2026-0001
  alunoId            Int
  tipoId             Int?
  tipoNome           String   @db.VarChar(120)
  assunto            String   @db.VarChar(191)
  descricao          String?  @db.Text
  status             String   @db.VarChar(16) @default("ABERTO") // ABERTO|EM_ANALISE|DEFERIDO|INDEFERIDO|CONCLUIDO|CANCELADO
  resposta           String?  @db.Text
  documentoId        Int?     // doc gerado ao deferir (se houver)
  camposJson         String?  @db.Text // F8 — respostas dos campos personalizados
  custoParcelaId     Int?     // F8 — parcela TAXA gerada ao deferir (se custoCentavos>0)
  prazoEm            DateTime?
  respondidoPorUserId Int?
  respondidoEm       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([alunoId])
  @@index([status])
  @@map("bychat_aca_requerimentos")
}

// ───────────────── O2.5 · Calendário acadêmico ─────────────────
model AcaEvento {
  id              Int      @id @default(autoincrement())
  periodoLetivoId Int?     // null = evento global (toda a instituição)
  turmaId         Int?     // null = vale para o período/instituição
  tipo            String   @db.VarChar(20) @default("EVENTO") // PROVA|FERIADO|MATRICULA|RECESSO|EVENTO|REUNIAO
  titulo          String   @db.VarChar(191)
  descricao       String?  @db.Text
  dataInicio      DateTime
  dataFim         DateTime?
  diaInteiro      Boolean  @default(true)
  cor             String?  @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([periodoLetivoId])
  @@index([dataInicio])
  @@map("bychat_aca_eventos")
}

// ───────────────── O2.6 · Quadro de horários ─────────────────
model AcaHorario {
  id              Int      @id @default(autoincrement())
  turmaId         Int
  disciplinaId    Int
  professorUserId Int?
  sala            String?  @db.VarChar(60)
  diaSemana       Int      // 1=segunda … 7=domingo
  horaInicio      String   @db.VarChar(5) // "HH:MM"
  horaFim         String   @db.VarChar(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([turmaId])
  @@index([professorUserId])
  @@index([diaSemana])
  @@map("bychat_aca_horarios")
}

// ───────────────── O2.7 · Plano de ensino + Materiais ─────────────────
model AcaPlanoEnsino {
  id           Int      @id @default(autoincrement())
  diarioId     Int      @unique
  ementa       String?  @db.Text
  objetivos    String?  @db.Text
  conteudo     String?  @db.Text
  metodologia  String?  @db.Text
  bibliografia String?  @db.Text
  criterios    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("bychat_aca_planos_ensino")
}

model AcaMaterial {
  id        Int      @id @default(autoincrement())
  diarioId  Int
  aulaId    Int?
  titulo    String   @db.VarChar(191)
  tipo      String   @db.VarChar(12) @default("LINK") // LINK|ARQUIVO|VIDEO
  url       String   @db.Text
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  @@index([diarioId])
  @@map("bychat_aca_materiais")
}

// ───────────────── O2.9 · Estágio + Atividades complementares ─────────────────
model AcaEstagio {
  id            Int      @id @default(autoincrement())
  alunoId       Int
  empresa       String   @db.VarChar(191)
  supervisor    String?  @db.VarChar(191)
  cargaHorariaH Int      @default(0)
  dataInicio    DateTime?
  dataFim       DateTime?
  status        String   @db.VarChar(14) @default("EM_ANDAMENTO") // EM_ANDAMENTO|CONCLUIDO|CANCELADO
  descricao     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([alunoId])
  @@map("bychat_aca_estagios")
}

model AcaAtividadeComplementar {
  id             Int      @id @default(autoincrement())
  alunoId        Int
  titulo         String   @db.VarChar(191)
  categoria      String?  @db.VarChar(40)
  horas          Int      @default(0)
  data           DateTime?
  comprovanteUrl String?  @db.Text
  status         String   @db.VarChar(12) @default("PENDENTE") // PENDENTE|APROVADA|REJEITADA
  observacao     String?  @db.Text
  createdAt      DateTime @default(now())
  @@index([alunoId])
  @@map("bychat_aca_atividades")
}

// ───────────────────────── Assinatura de Contratos (aca_assinatura) ─────────────────────────
// Assinatura eletrônica de contratos do aluno via Autentique (provider-agnostic).
enum AcaAssinaturaStatus {
  RASCUNHO
  ENVIADO
  PARCIAL
  ASSINADO
  REJEITADO
  CANCELADO
}

enum AcaSignatarioStatus {
  PENDENTE
  VISUALIZADO
  ASSINADO
  REJEITADO
}

enum AcaSignatarioPapel {
  ALUNO
  RESPONSAVEL
  FIADOR
  INSTITUICAO
  TESTEMUNHA
}

model AcaAssinatura {
  id                Int      @id @default(autoincrement())
  alunoId           Int?
  matriculaId       Int?
  contratoId        Int?
  titulo            String   @db.VarChar(191)
  provider          String   @default("AUTENTIQUE") @db.VarChar(30)
  documentoExternoId String? @db.VarChar(120) // id do documento no provedor
  status            AcaAssinaturaStatus @default(RASCUNHO)
  termoTexto        String?  @db.Text
  arquivoAssinadoUrl String? @db.Text // link do PDF assinado no provedor
  enviadoEm         DateTime?
  finalizadoEm      DateTime?
  metaJson          Json?    @db.Json // resposta crua do provedor
  templateId        Int?
  tipoNegocio       String?  @db.VarChar(40)
  origem            AcaContratoOrigem @default(ESCRITO)
  corpoTexto        String?  @db.Text       // contrato escrito/interpolado (ESCRITO/TEMPLATE)
  arquivoBase64     String?  @db.LongText   // PDF enviado por upload (UPLOAD)
  arquivoNome       String?  @db.VarChar(191)
  deadlineEm        DateTime?               // prazo de assinatura
  reminder          String?  @db.VarChar(10) // DAILY | WEEKLY | null
  sortable          Boolean  @default(false) // assinatura em ordem sequencial
  refusable         Boolean  @default(true)  // signatário pode recusar
  mensagem          String?  @db.Text        // mensagem no convite
  pastaExternaId    String?  @db.VarChar(120)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  signatarios       AcaSignatario[]

  @@index([alunoId])
  @@index([status])
}

model AcaSignatario {
  id             Int      @id @default(autoincrement())
  assinaturaId   Int
  nome           String   @db.VarChar(191)
  email          String?  @db.VarChar(191)
  papel          AcaSignatarioPapel @default(ALUNO)
  acao           AcaSignatarioAcao @default(SIGN)        // SIGN/APPROVE/RECOGNIZE/WITNESS
  deliveryMethod AcaDelivery @default(EMAIL)             // canal de entrega do convite
  telefone       String?  @db.VarChar(30)               // p/ SMS/WHATSAPP
  cpf            String?  @db.VarChar(20)
  exigeCpf       Boolean  @default(false)
  exigeSelfie    Boolean  @default(false)
  publicId       String?  @db.VarChar(120) // signature.public_id no provedor
  linkAssinatura String?  @db.Text         // short_link p/ assinar
  status         AcaSignatarioStatus @default(PENDENTE)
  viewedEm       DateTime?
  assinadoEm     DateTime?
  rejeitadoEm    DateTime?
  ordem          Int      @default(0)
  assinatura     AcaAssinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([assinaturaId])
}

enum AcaContratoOrigem {
  ESCRITO
  UPLOAD
  TEMPLATE
}

enum AcaSignatarioAcao {
  SIGN
  APPROVE
  RECOGNIZE
  WITNESS
}

enum AcaDelivery {
  EMAIL
  SMS
  WHATSAPP
}

enum AcaTipoNegocio {
  GRADUACAO
  POS_GRADUACAO
  ESPECIALIZACAO
  MBA
  TECNICO_TRADICIONAL
  CERTIFICACAO_COMPETENCIA
  EXTENSAO
  CURSO_LIVRE
  IDIOMAS
  OUTRO
}

enum AcaContratoEvento {
  MANUAL
  MATRICULA_CRIADA
  INSCRICAO_APROVADA
  CONTRATO_FINANCEIRO_CRIADO
}

model AcaContratoTemplate {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(191)
  tipoNegocio AcaTipoNegocio @default(OUTRO)
  descricao   String?  @db.VarChar(255)
  corpoTexto  String   @db.Text   // corpo do contrato com {{variáveis}}
  config      Json?    @db.Json   // {deadlineDias, reminder, sortable, refusable, mensagem}
  signatariosPadrao Json? @db.Json // [{papel, acao, deliveryMethod, exigeCpf, exigeSelfie}]
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcaContratoGatilho {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(191)
  evento      AcaContratoEvento @default(MANUAL)
  templateId  Int?                            // null quando autoPorTipo
  autoPorTipo Boolean  @default(false)         // escolhe o template pelo tipo de negócio do curso
  filtroTipoNegocio String? @db.VarChar(40)    // dispara só p/ este tipo (opcional)
  autoEnviar  Boolean  @default(false)         // true = cria E envia; false = cria rascunho
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([evento])
}

// ── Sincronizado do beyond (modelos de módulos opcionais) ──
model CompetitorAgency {
  id      Int    @id @default(autoincrement())
  placeId String @unique @db.VarChar(191) // placeId/cid do Google Maps

  name       String  @db.VarChar(191)
  categories String? @db.VarChar(255) // categorias do Google, separadas por vírgula
  address    String? @db.Text
  city       String? @db.VarChar(120)
  uf         String? @db.VarChar(60)
  website    String? @db.VarChar(255)
  domain     String? @db.VarChar(191) // normalizado a partir do website — liga ao WebStackScan
  phone      String? @db.VarChar(40)

  rating           Float? // nota média no Google
  reviewsCount     Int? // total de avaliações
  // Quantas negativas COM texto foram capturadas. Sem texto não serve: não dá
  // para inferir qual cliente reclamou nem do quê.
  negativeWithText Int    @default(0)

  searchTerm String?   @db.VarChar(191) // termo que descobriu esta agência
  status     String    @default("new") @db.VarChar(20) // new | mapped | ignored
  notes      String?   @db.Text
  lastScanAt DateTime?

  reviews CompetitorReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([rating])
  @@index([status])
  @@index([domain])
  @@map("bychat_competitor_agencies")
}

model CompetitorReview {
  id       Int              @id @default(autoincrement())
  agencyId Int
  agency   CompetitorAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  externalId   String    @unique @db.VarChar(191) // reviewId do Google — dedupe entre coletas
  stars        Int
  text         String    @db.Text
  publishedAt  DateTime?
  ownerReplied Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([stars])
  @@map("bychat_competitor_reviews")
}

model CrmEduMapping {
  id         Int      @id @default(autoincrement())
  entityType String   @db.VarChar(30) // lead
  crmId      String   @db.VarChar(40)
  localId    Int
  meta       Json?    @db.Json
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, crmId])
  @@index([entityType, localId])
  @@map("bychat_crmedu_mappings")
}

model EducationImport {
  id   Int @id @default(autoincrement())
  year Int @unique

  fileName   String? @db.VarChar(191)
  fileBytes  Int?
  status     String  @default("running") @db.VarChar(20) // running | done | failed
  schools    Int     @default(0) // privadas ativas persistidas
  rowsRead   Int     @default(0) // linhas lidas da Tabela_Escola
  durationMs Int?
  error      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bychat_education_imports")
}

model EducationInstitution {
  id       Int    @id @default(autoincrement())
  inepCode String @unique @db.VarChar(20) // CO_ENTIDADE

  name     String  @db.VarChar(191) // NO_ENTIDADE
  uf       String? @db.VarChar(2)
  city     String? @db.VarChar(120)
  cityCode String? @db.VarChar(10)
  district String? @db.VarChar(120) // NO_BAIRRO
  address  String? @db.Text
  zip      String? @db.VarChar(12)
  phone    String? @db.VarChar(40) // NU_TELEFONE

  // TP_CATEGORIA_ESCOLA_PRIVADA: 1 particular, 2 comunitária, 3 confessional, 4 filantrópica
  privateCategory Int?
  urban           Boolean @default(true) // TP_LOCALIZACAO = 1

  // Último ano ingerido e o retrato desse ano
  lastYear    Int?
  classes     Int  @default(0) // QT_TUR_BAS — turmas da educação básica (proxy de porte)
  classesInf  Int  @default(0)
  classesFund Int  @default(0)
  classesMed  Int  @default(0)
  classesProf Int  @default(0)
  classesEja  Int  @default(0)

  // Variação de turmas vs. ano anterior. Negativo = perdendo alunos = dor.
  classesDelta Float?

  // Maturidade digital declarada no censo — quanto pior, maior a lacuna.
  hasInternet      Boolean @default(false)
  hasInternetAdmin Boolean @default(false)
  hasInternetLearn Boolean @default(false)

  // 0..100 — ver computeEducationScore em services/inepIngest.ts
  opportunityScore Int @default(0)

  // Liga ao detector de stack quando descobrirmos o site (F4).
  domain String? @db.VarChar(191)

  status String  @default("new") @db.VarChar(20) // new | prospecting | converted | ignored
  leadId Int?
  notes  String? @db.Text

  snapshots EducationSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityScore])
  @@index([uf, city])
  @@index([classes])
  @@index([status])
  @@index([lastYear])
  @@map("bychat_education_institutions")
}

model EducationSnapshot {
  id            Int                  @id @default(autoincrement())
  institutionId Int
  institution   EducationInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  year        Int
  classes     Int @default(0)
  classesInf  Int @default(0)
  classesFund Int @default(0)
  classesMed  Int @default(0)

  createdAt DateTime @default(now())

  @@unique([institutionId, year])
  @@index([year])
  @@map("bychat_education_snapshots")
}

model HeCourse {
  id   Int @id @default(autoincrement())
  year Int

  coIes   Int
  coCurso Int
  name    String @db.VarChar(255) // NO_CURSO

  cineArea     String? @db.VarChar(120) // NO_CINE_AREA_GERAL
  cineDetailed String? @db.VarChar(191) // NO_CINE_AREA_DETALHADA
  degree       Int? // TP_GRAU_ACADEMICO: 1 bacharelado, 2 licenciatura, 3 tecnológico
  modality     Int? // TP_MODALIDADE_ENSINO: 1 presencial, 2 EAD
  category     Int? // TP_CATEGORIA_ADMINISTRATIVA
  organization Int?

  uf        String? @db.VarChar(2)
  city      String? @db.VarChar(120)
  cityCode  Int?
  isCapital Boolean @default(false)

  // Oferta e demanda
  seats          Int @default(0) // QT_VG_TOTAL
  seatsNight     Int @default(0) // QT_VG_TOTAL_NOTURNO
  applicants     Int @default(0) // QT_INSCRITO_TOTAL
  entrants       Int @default(0) // QT_ING
  entrantsNight  Int @default(0)
  entrantsEnem   Int @default(0) // QT_ING_ENEM
  entrantsVest   Int @default(0) // QT_ING_VESTIBULAR
  entrantsFies   Int @default(0)
  entrantsProuni Int @default(0)

  // Base instalada e resultado
  enrolled       Int @default(0) // QT_MAT
  enrolledFem    Int @default(0)
  enrolled1824   Int @default(0)
  enrolled2529   Int @default(0)
  enrolled30p    Int @default(0)
  graduates      Int @default(0) // QT_CONC
  locked         Int @default(0) // QT_SIT_TRANCADA
  dropped        Int @default(0) // QT_SIT_DESVINCULADO
  transferred    Int @default(0) // QT_SIT_TRANSFERIDO
  enrolledFies   Int @default(0)
  enrolledProuni Int @default(0)

  createdAt DateTime @default(now())

  @@index([year, coIes])
  @@index([year, uf, cityCode])
  @@index([year, cineArea])
  @@index([year, coCurso])
  @@map("bychat_he_courses")
}

model HeImport {
  id   Int @id @default(autoincrement())
  year Int @unique

  fileName     String? @db.VarChar(191)
  fileBytes    Int?
  status       String  @default("running") @db.VarChar(20) // running | done | failed
  courses      Int     @default(0)
  institutions Int     @default(0)
  marketRows   Int     @default(0)
  durationMs   Int?
  error        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bychat_he_imports")
}

model HeInstitution {
  id    Int @id @default(autoincrement())
  coIes Int @unique // CO_IES

  name         String  @db.VarChar(255) // NO_IES
  acronym      String? @db.VarChar(60) // SG_IES
  uf           String? @db.VarChar(2)
  city         String? @db.VarChar(120)
  isCapital    Boolean @default(false)
  organization Int? // TP_ORGANIZACAO_ACADEMICA: 1 univ, 2 centro univ, 3 faculdade…
  category     Int? // TP_CATEGORIA_ADMINISTRATIVA: 1-3 pública, 4-5,7 privada
  isPrivate    Boolean @default(false)

