}

// ── CONVERSIONS API (Fase 8 — Feedback para Ads) ──

model ConversionEvent {
  id            Int       @id @default(autoincrement())
  leadId        Int
  platform      String    @db.VarChar(30) // meta_capi, google_ads
  eventName     String    @db.VarChar(50) // Lead, Purchase, CompleteRegistration, etc
  eventTime     DateTime
  value         Decimal?  @db.Decimal(12, 2)
  currency      String    @default("BRL") @db.VarChar(3)
  funnelStage   String?   @db.VarChar(100) // Etapa do funil que disparou
  // Identificadores de plataforma
  pixelId       String?   @db.VarChar(50)
  accessToken   String?   @db.Text
  fbclid        String?   @db.VarChar(191)
  fbc           String?   @db.VarChar(191)
  fbp           String?   @db.VarChar(191)
  gclid         String?   @db.VarChar(191)
  eventId       String    @db.VarChar(100) // Deduplicação
  // Dados do usuário (hashed para CAPI)
  userEmail     String?   @db.VarChar(191)
  userPhone     String?   @db.VarChar(30)
  userFirstName String?   @db.VarChar(100)
  userLastName  String?   @db.VarChar(100)
