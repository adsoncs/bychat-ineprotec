}

model DetectedSale {
  id                  Int       @id @default(autoincrement())
  leadId              Int
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value               Decimal?  @db.Decimal(12, 2)
  currency            String    @default("BRL") @db.VarChar(5)
