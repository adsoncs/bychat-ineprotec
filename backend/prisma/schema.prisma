  @@index([tipo])
  @@map("bychat_aca_cadastros_aux")
}

// ── F21 — GED: arquivos do aluno (módulo aca_ged) ──
model AcaGedArquivo {
  id         Int      @id @default(autoincrement())
  alunoId    Int
  tipo       String   @db.VarChar(60)
  nome       String   @db.VarChar(191)
  url        String   @db.Text
  status     String   @db.VarChar(12) @default("RECEBIDO") // RECEBIDO | CONFERIDO | PENDENTE
  observacao String?  @db.Text
  // ── Fase 4 (G10): acervo acadêmico digital (Port. MEC 315/2018) ──
  /// Código do plano de classificação documental (ex.: "125.1 — Histórico").
  classificacao   String?  @db.VarChar(60)
  /// PERMANENTE (guarda eterna) | TEMPORARIO (elimina após o prazo).
  temporalidade   String   @default("PERMANENTE") @db.VarChar(12)
  prazoGuardaAnos Int?
  /// Data a partir da qual o documento temporário pode ser eliminado.
  guardaAte       DateTime?
  /// Integridade: sem hash não há como provar que o arquivo não mudou.
  hashSha256      String?  @db.VarChar(64)
  tamanhoBytes    Int?
  mimeType        String?  @db.VarChar(100)
  /// Eliminação é controlada: só ocorre por termo, com comissão registrada.
  eliminadoEm     DateTime?
  eliminacaoTermoId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([alunoId])
  @@map("bychat_aca_ged_arquivos")
}

// ── F19 — EAD / Ponte com LMS próprio (módulo aca_ead) ──
// O LMS (próprio, a construir) é o ponto de integração. modo SIMULADO valida o
// fluxo sem o LMS; AO_VIVO chamaria a API do LMS.
model AcaEadConfig {
  id        Int      @id @default(autoincrement())
  lmsNome   String?  @db.VarChar(120)
  lmsBaseUrl String? @db.VarChar(255)
  modo      String   @db.VarChar(12) @default("SIMULADO") // SIMULADO | AO_VIVO
  ativo     Boolean  @default(false)
  updatedAt DateTime @updatedAt @default(now())
  @@map("bychat_aca_ead_config")
}
model AcaEadTurma {
  id        Int      @id @default(autoincrement())
  turmaId   Int      @unique
  chEad     Int      @default(0)
  lmsRef    String?  @db.VarChar(80) // id/curso no LMS
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  @@map("bychat_aca_ead_turmas")
}
model AcaEadMatricula {
  id          Int      @id @default(autoincrement())
  matriculaId Int      @unique
  eadTurmaId  Int
  lmsEnrollRef String? @db.VarChar(80)
  status      String   @db.VarChar(14) @default("PENDENTE") // PENDENTE | SINCRONIZADA
  syncedAt    DateTime?
  @@index([eadTurmaId])
  @@map("bychat_aca_ead_matriculas")
}
model AcaEadNota {
  id          Int      @id @default(autoincrement())
  matriculaId Int
  disciplina  String   @db.VarChar(191)
  nota        Float
  origem      String   @db.VarChar(10) @default("LMS") // LMS | MANUAL
