}

// ── F20 — Cadastros Auxiliares (módulo aca_cadastros) ──
// Tabela flexível de listas de apoio. tipo distingue a lista:
// AREA_CONHECIMENTO | FORMACAO | ATENDIMENTO_ESPECIAL | TIPO_DOCUMENTO.
model AcaCadastroAux {
  id        Int      @id @default(autoincrement())
  tipo      String   @db.VarChar(40)
  nome      String   @db.VarChar(191)
  descricao String?  @db.VarChar(255)
