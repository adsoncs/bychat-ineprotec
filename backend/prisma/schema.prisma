  referralHeadline String?  @db.VarChar(255)
  referralMediaUrl String?  @db.Text
  gclid            String?  @db.VarChar(191)
  utmSource        String?  @db.VarChar(100)
  utmMedium        String?  @db.VarChar(100)
  utmCampaign      String?  @db.VarChar(191)
  utmContent       String?  @db.VarChar(191)
  utmTerm          String?  @db.VarChar(191)
  rawReferral      Json?    @db.Json
  confidence       String   @default("high") @db.VarChar(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([originType])
  @@index([ctwaClid])
  @@index([gclid])
  @@index([trackableLinkId])
  @@index([createdAt])
