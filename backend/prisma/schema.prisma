  @@index([isPrivate])
  @@map("bychat_he_institutions")
}

model HeMarket {
  id   Int @id @default(autoincrement())
  year Int

  uf        String? @db.VarChar(2)
  cityCode  Int?
  city      String? @db.VarChar(120)
  cineArea  String? @db.VarChar(120)
  modality  Int? // 1 presencial, 2 EAD
  isPrivate Boolean @default(false)

  courses      Int @default(0) // nº de registros curso×local
  institutions Int @default(0) // IES distintas
  seats        Int @default(0)
  applicants   Int @default(0)
  entrants     Int @default(0)
  enrolled     Int @default(0)
  graduates    Int @default(0)
  dropped      Int @default(0)
  locked       Int @default(0)
  fies         Int @default(0)
  prouni       Int @default(0)

  createdAt DateTime @default(now())

  @@unique([year, uf, cityCode, cineArea, modality, isPrivate], name: "he_market_slice")
  @@index([year, uf])
  @@index([year, cineArea])
  @@map("bychat_he_market")
}

model MeetingExtensionToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique @db.VarChar(64) // sha256 hex do token
  label      String?   @db.VarChar(120) // ex.: "Chrome do Benedito"
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("bychat_meeting_extension_tokens")
}

model ReputationCompany {
  id      Int     @id @default(autoincrement())
  slug    String  @unique @db.VarChar(191) // nome fantasia normalizado — chave estável entre períodos
  name    String  @db.VarChar(191) // "Nome Fantasia" como publicado
  segment String? @db.VarChar(191) // "Segmento de Mercado"
  area    String? @db.VarChar(191) // "Área"

  // Agregados do período mais recente ingerido (denormalizados p/ listagem rápida)
  lastPeriod      String? @db.VarChar(7) // YYYY-MM
  complaints      Int     @default(0) // reclamações finalizadas no período
  unansweredRate  Float? // 0..1 — Respondida = 'N'
  unresolvedRate  Float? // 0..1 — sobre as AVALIADAS (só ~6% recebem avaliação)
  ratedShare      Float? // 0..1 — fatia que foi avaliada (denominador do acima)
  avgScore        Float? // 1..5 — "Nota do Consumidor"
  avgResponseDays Float? // "Tempo Resposta" (em dias)
  topProblem      String? @db.VarChar(255)
  topUf           String? @db.VarChar(2)

  // Tendência vs. período anterior (variação % do volume). null = sem histórico.
  complaintsDelta Float?

  // 0..100 — quanto essa empresa "dói" hoje. Calculado na ingestão (ver
  // computeOpportunityScore em services/reputationIngest.ts).
  opportunityScore Int @default(0)

  // Pipeline de prospecção. F0 só popula 'new'; F2 fará a conversão em Lead.
  status String  @default("new") @db.VarChar(20) // new | prospecting | converted | ignored
  // Lead gerado a partir desta empresa. Escalar sem FK de propósito: evita
  // acoplar o model Lead (gigante) a um módulo opcional e desligado por padrão.
  leadId Int?
  notes  String? @db.Text

  snapshots ReputationSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityScore])
  @@index([segment])
  @@index([status])
  @@index([lastPeriod])
  @@index([leadId])
  @@map("bychat_reputation_companies")
}

model ReputationImport {
  id     Int    @id @default(autoincrement())
  period String @unique @db.VarChar(7) // YYYY-MM — 1 import por período

  sourceCode String? @db.VarChar(30) // "codigo" da publicação no Senacon
  fileName   String? @db.VarChar(191) // finalizadas_YYYY-MM.zip
  fileBytes  Int?

  status     String  @default("running") @db.VarChar(20) // running | done | failed
  rows       Int     @default(0)
  companies  Int     @default(0)
  durationMs Int?
  error      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("bychat_reputation_imports")
}

model ReputationSnapshot {
  id        Int               @id @default(autoincrement())
  companyId Int
  company   ReputationCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  period String @db.VarChar(7) // YYYY-MM

  complaints      Int    @default(0)
  unanswered      Int    @default(0)
  rated           Int    @default(0) // reclamações que receberam avaliação
  unresolved      Int    @default(0) // dentre as avaliadas
  avgScore        Float?
  avgResponseDays Float?
  // Distribuições do período: { problems: {...}, ufs: {...}, channels: {...} }
  breakdown       Json?  @db.Json

  createdAt DateTime @default(now())

  @@unique([companyId, period])
  @@index([period])
  @@map("bychat_reputation_snapshots")
}

model WebStackScan {
  id     Int    @id @default(autoincrement())
  domain String @unique @db.VarChar(191) // normalizado, sem www/protocolo

  finalUrl   String? @db.Text // após redirects
  httpStatus Int?
  title      String? @db.VarChar(255)
  tlsValid   Boolean @default(true) // false = certificado inválido/expirado (sinal por si só)
  error      String? @db.VarChar(255) // dns/timeout/refused — site morto também é sinal

  // Flags derivadas — booleanas para filtrar rápido sem abrir o Json.
  hasMetaPixel  Boolean @default(false)
  hasGoogleAds  Boolean @default(false)
  hasGa4        Boolean @default(false)
  hasGtm        Boolean @default(false)
  hasOtherPixel Boolean @default(false) // TikTok, LinkedIn, Pinterest
  hasChat       Boolean @default(false) // WhatsApp, Crisp, Tawk, JivoChat…
  hasCrm        Boolean @default(false) // RD Station, HubSpot
  cms           String? @db.VarChar(40) // wordpress | wix | shopify | vtex | …

  // Tudo que foi detectado, com o nome de cada tecnologia.
  detected Json? @db.Json

  // 0..100 — tamanho da LACUNA (quanto maior, mais órfã de marketing a empresa
  // parece). Ver computeGapScore em services/webStackDetect.ts.
  gapScore Int @default(0)

  // Vínculos opcionais — o mesmo scan serve a qualquer origem de prospect.
  leadId    Int?
  companyId Int?

  scannedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gapScore])
  @@index([leadId])
  @@index([companyId])
  @@index([cms])
  @@map("bychat_web_stack_scans")
}

// ─── Disparos Inteligentes (smart_broadcast) ──────────────
//
// Campanhas enviadas pelos NÚMEROS PRÓPRIOS conectados na Evolution (Baileys),
// não pela Cloud API oficial. Como não há template HSM nem SLA da Meta, todo o
// esforço do módulo está em (a) parecer uso humano — ritmo irregular, digitação,
// janela de horário, variações de texto — e (b) proteger o número: aquecimento
// progressivo, teto diário, pré-checagem de existência no WhatsApp e disjuntor
// automático ao primeiro sinal de bloqueio. Ver services/waCampaign/*.
//
// Separado de BroadcastCampaign de propósito: lá o risco é custo por template,
// aqui é a vida do chip. Misturar os dois modelos confundiria as duas coisas.

model SmartCampaign {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(191)
  status String @default("draft") @db.VarChar(16) // draft|scheduled|running|paused|completed|canceled|failed

  // Pool de números Evolution que revezam o envio: [{id, instanceName}]
  senderInstances Json @db.Json

  // Conteúdo: blocos de mensagem com variações/spintax.
  // [{ variants: ["Oi {{nome}}!", "Olá {{nome}}"], mediaUrl?, mediaType?, delayAfterMs? }]
  messageBlocks Json @db.Json

  audienceType String @db.VarChar(12) // leads | import
  audienceMeta Json?  @db.Json

  // Ritmo/janela (snapshot do perfil no momento da criação — perfil pode mudar depois)
  pacingProfileId Int?
  pacingConfig    Json @db.Json // { minDelayMs, maxDelayMs, sessionSize, sessionBreakMs, typingEnabled, ... }
  windowConfig    Json @db.Json // { days:[1..5], from:"09:00", to:"18:00", timezone:"America/Sao_Paulo" }

  // Teto de envios por número por dia. Quando o operador informa um valor, ele
  // MANDA — inclusive acima da escada de aquecimento. A escada continua sendo o
  // padrão de quem não mexe, mas deixou de ser um teto intransponível: número
  // antigo, com histórico de conversa, não precisa recomeçar em 20/dia.
  dailyCapPerNumber Int     @default(20)
  requireOptIn      Boolean @default(false)

  // Pula a consulta "esse número existe no WhatsApp?" antes de planejar. A
  // consulta protege o remetente, mas em lista já conhecida ela só custa tempo
  // (e trava a campanha inteira quando a Evolution está instável).
  skipNumberCheck Boolean @default(false)

  // Sensibilidade do disjuntor: quando a campanha se interrompe sozinha.
  // { level: 'strict'|'normal'|'off', noReplyAfter, notFoundRate, failStreak }
  // Ausente = 'normal'. Ver services/smartBroadcast/guard.ts.
  guardConfig Json?

  // Rodapé de saída, anexado à última bolha. Custa uma linha de texto e evita
  // a denúncia — que é o sinal mais caro para o número.
  optOutFooter String? @db.VarChar(191)

  // Espalha os envios pelo horário em que CADA contato costuma responder, em vez
  // de seguir a fila. Quem responde de noite recebe de noite.
  usePreferredTime Boolean @default(false)

  // Destino do `{{link}}`: cada destinatário recebe a URL com UTMs da campanha
  // e um identificador próprio, em vez do mesmo link literal em toda a lista.
  linkUrl String? @db.VarChar(500)

  // O que fazer quando o contato RESPONDE — mover de etapa, atribuir dono,
  // registrar atividade. Responder é o evento que interessa: a campanha existe
  // para gerar conversa, não para gerar entrega.
  // { moveToFunnelId, moveToStageKey, assignToUserId, createActivity }
  replyActions Json?
  // Base legal declarada (LGPD) — quem dispara assume a responsabilidade.
  legalBasis        String? @db.VarChar(30) // consent | contract | legitimate_interest

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Estado de risco calculado pelo disjuntor (guard.ts)
  riskState  String  @default("ok") @db.VarChar(16) // ok | watch | throttled | halted
  riskReason String? @db.VarChar(191)

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)
  skippedCount    Int @default(0)
  repliedCount    Int @default(0)

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipients SmartCampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@map("bychat_smart_campaigns")
}

model SmartCampaignRecipient {
  id         Int           @id @default(autoincrement())
  campaignId Int
  campaign   SmartCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId   Int?
  phone    String  @db.VarChar(30)
  // Chave canônica (lib/phone.ts) — dedup entre formatos diferentes do mesmo número.
  phoneKey String  @db.VarChar(30)
  name     String? @db.VarChar(191)

  variables Json @db.Json // valores resolvidos p/ interpolação

  // Número que vai falar com este destinatário (afinidade + rodízio)
  assignedInstanceId Int?
  assignedInstance   String? @db.VarChar(100)
  // Qual variação de texto ele recebe (distribuição determinística por phoneKey)
  variantIndex       Int     @default(0)

  // Horário PLANEJADO do envio — a agenda é calculada antes e persistida, para
  // sobreviver a restart e ser auditável ("por que essa mensagem sai 14:37?").
  plannedAt DateTime?

  status     String  @default("pending") @db.VarChar(12) // pending|scheduled|sending|sent|delivered|read|replied|failed|skipped
  skipReason String? @db.VarChar(30) // opt_out|invalid_phone|not_on_whatsapp|duplicate|governance|cap|canceled|blacklist
  externalId String? @db.VarChar(191) // key.id da Evolution
  error      String? @db.VarChar(500)
  sentText   String? @db.Text // texto exatamente como saiu (auditoria de variação)

  scheduledAt DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId, status])
  @@index([plannedAt])
  @@index([externalId])
  @@index([phoneKey])
  @@map("bychat_smart_campaign_recipients")
}

// Saúde diária por número. Uma linha por instância/dia: é o que sustenta o
// aquecimento (warmupDay), o teto diário e o disjuntor.
model SmartSenderHealth {
  id           Int      @id @default(autoincrement())
  instanceId   Int
  instanceName String   @db.VarChar(100)
  day          DateTime @db.Date

  sent      Int @default(0)
  delivered Int @default(0)
  failed    Int @default(0)
  replies   Int @default(0)
  notFound  Int @default(0) // números que não existem no WhatsApp

  // Dia da escada de aquecimento (1 = recém-conectado). Não avança sozinho se a
  // taxa de resposta despencar.
  warmupDay Int    @default(1)
  dailyCap  Int    @default(20)
  state     String @default("warming") @db.VarChar(12) // warming|healthy|throttled|paused|blocked

  pausedUntil DateTime?
  pauseReason String?   @db.VarChar(191)
  score       Int       @default(100) // 0-100, alimenta o rodízio ponderado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, day])
  @@index([instanceName])
  @@map("bychat_smart_sender_health")
}

// Perfis de ritmo. "Conservador" é o padrão do sistema e o único recomendado
// para número novo.
model SmartPacingProfile {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(60)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false)

  minDelayMs     Int     @default(40000)
  maxDelayMs     Int     @default(180000)
  sessionSize    Int     @default(20) // envios antes da pausa longa
  sessionBreakMs Int     @default(600000)
  typingEnabled  Boolean @default(true)
  readReceipts   Boolean @default(true)
  dailyCapStart  Int     @default(20)
  dailyCapMax    Int     @default(250)
  warmupCurve    Json    @db.Json // [20,35,50,80,120,180,250]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bychat_smart_pacing_profiles")
}

// Cache de "esse número existe no WhatsApp?". Disparar para número inexistente é
// um dos sinais que mais derruba chip — e a consulta custa uma chamada, então
// vale guardar.
model SmartNumberCheck {
  id       Int     @id @default(autoincrement())
  phoneKey String  @unique @db.VarChar(30)
  exists   Boolean
  jid      String? @db.VarChar(100)

  checkedAt DateTime @default(now())

  @@index([checkedAt])
  @@map("bychat_smart_number_checks")
}

// Lista de supressão GLOBAL: telefones que não recebem disparo nenhum, de
// campanha nenhuma, para sempre. Diferente do opt-out por lead (que vive em
// Lead.optOutChannels e depende de existir um lead), aqui entra o telefone cru —
// serve para pedido de terceiro, número errado, contato de concorrente,
// solicitação por outro canal, decisão jurídica.
//
// Esta lista é consultada na montagem da audiência E no momento do envio: quem
// pediu para sair ontem não recebe hoje porque "já estava agendado".
model SmartSuppression {
  id       Int    @id @default(autoincrement())
  phoneKey String @unique @db.VarChar(30)
  phone    String @db.VarChar(30)

  reason String  @default("manual") @db.VarChar(30) // manual | opt_out | bounce | legal | import
  note   String? @db.VarChar(255)

  createdByUserId Int?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("bychat_smart_suppressions")
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO METAS E COMISSÕES
//
// Fica em cima do módulo Negociações: a venda é a proposta ganha, e é dela que
// saem a base de cálculo (pagamento único e mensalidade separados), o funil (do
// lead) e o agente (o responsável no fechamento). Nada aqui é digitado de novo —
// se fosse, o número da comissão divergiria do número da venda no dia seguinte.
// ─────────────────────────────────────────────────────────────────────────────

// Regra de comissão. O escopo é o par (funil, agente): `funnelId` null vale para
// qualquer funil e nenhum agente vinculado vale para qualquer agente. Quando mais
// de uma regra serve, ganha a mais específica (agente+funil > agente > funil >
// geral) — e `prioridade` desempata entre regras de mesma especificidade.
//
// A taxa é declarada em DOIS blocos porque a proposta separa mensalidade de
// pagamento único: comissionar 5% de um setup e 20% da primeira mensalidade é a
// prática comum de quem vende contrato recorrente, e um percentual só sobre o
// total esconderia essa diferença.
model CommissionRule {
  id     Int     @id @default(autoincrement())
  nome   String  @db.VarChar(120)
  active Boolean @default(true)

  funnelId   Int? // null = qualquer funil
  prioridade Int  @default(0) // desempate manual entre regras igualmente específicas

  // liquido = valor negociado (com desconto) · bruto = valor de tabela dos itens.
  // Rateado na mesma proporção do bloco quando `bruto` (ver services/commissions).
  base String @default("liquido") @db.VarChar(10)

  // Bloco "pagamento único": percent | valor | none
  tipoUnico String   @default("percent") @db.VarChar(10)
  taxaUnico Decimal? @db.Decimal(12, 2)

  // Bloco "mensalidade": mesma gramática. `mesesRecorrente` = quantas
  // mensalidades entram na comissão (1 = só a primeira).
  tipoRecorrente  String   @default("percent") @db.VarChar(10)
  taxaRecorrente  Decimal? @db.Decimal(12, 2)
  mesesRecorrente Int      @default(1)

  // Acelerador: a taxa muda conforme o atingimento da meta do período. A métrica
  // diz CONTRA QUAL meta o atingimento é medido (a meta do agente naquele funil).
  // Sem faixa aplicável, valem as taxas acima.
  aceleradorAtivo   Boolean @default(false)
  aceleradorMetrica String? @db.VarChar(20) // revenue | mrr | count | conversion

  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers   CommissionTier[]
  agents  CommissionRuleUser[]
  entries CommissionEntry[]

  @@index([active, funnelId])
  @@map("bychat_commission_rules")
}

// Faixa do acelerador. `atingimentoMin` é o piso em % da meta (0, 80, 100…) — a
// faixa escolhida é a de maior piso ≤ atingimento do agente no período. A taxa da
// faixa SUBSTITUI a da regra e vale para tudo o que o agente fechou no período
// (foi a decisão: bater a meta melhora a comissão do mês inteiro, não só da venda
// que passou do alvo).
model CommissionTier {
  id     Int @id @default(autoincrement())
  ruleId Int

  atingimentoMin Int @default(0) // % da meta

  tipoUnico String   @default("percent") @db.VarChar(10)
  taxaUnico Decimal? @db.Decimal(12, 2)

  tipoRecorrente String   @default("percent") @db.VarChar(10)
  taxaRecorrente Decimal? @db.Decimal(12, 2)

  rule CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, atingimentoMin])
  @@map("bychat_commission_tiers")
}

// Vínculo regra × agente. Sem nenhuma linha, a regra vale para todo agente.
model CommissionRuleUser {
  id     Int @id @default(autoincrement())
  ruleId Int
  userId Int

  rule CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId])
  @@index([userId])
  @@map("bychat_commission_rule_users")
}

// Meta do período. Uma linha por (agente, funil, indicador, período):
// `userId` null = meta do funil inteiro (a soma da operação), `funnelId` null =
// meta do agente somando todos os funis. O par é intencionalmente livre para o
// gestor montar a grade que a operação usa, sem o sistema impor um formato.
model Goal {
  id       Int  @id @default(autoincrement())
  userId   Int? // null = meta da operação (não de um agente)
  funnelId Int? // null = todos os funis

  // revenue = receita ganha (R$) · mrr = nova mensalidade (R$/mês)
  // count = nº de negociações ganhas · conversion = % ganhas sobre fechadas
  metric String @db.VarChar(20)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  target      Decimal  @db.Decimal(14, 2)

  active      Boolean @default(true)
  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnel Funnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([periodStart, periodEnd])
  @@index([userId, metric])
  @@index([funnelId, metric])
  @@map("bychat_goals")
}

// Lançamento de comissão — uma linha por negociação ganha. É DERIVADO: some com a
// negociação (cascade), é recalculado quando o valor da venda muda e some quando
// a proposta é reaberta. Os campos de taxa são fotografia do que valia no
// fechamento: mudar a regra amanhã não reescreve sozinha a comissão de ontem
// (só o recálculo explícito do período faz isso).
model CommissionEntry {
  id            Int @id @default(autoincrement())
  negotiationId Int @unique
  leadId        Int
  userId        Int? // beneficiário = responsável da negociação no fechamento
  funnelId      Int?
  ruleId        Int?
  tierId        Int?

  // 1º dia do mês do fechamento — é por ela que o painel agrupa.
  competencia DateTime @db.Date
  fechadaEm   DateTime

  baseUnico      Decimal @default(0) @db.Decimal(12, 2)
  baseRecorrente Decimal @default(0) @db.Decimal(12, 2)

  tipoUnico       String?  @db.VarChar(10)
  taxaUnico       Decimal? @db.Decimal(12, 2)
  tipoRecorrente  String?  @db.VarChar(10)
  taxaRecorrente  Decimal? @db.Decimal(12, 2)
  mesesRecorrente Int      @default(1)

  valorUnico      Decimal @default(0) @db.Decimal(12, 2)
  valorRecorrente Decimal @default(0) @db.Decimal(12, 2)
  valorTotal      Decimal @default(0) @db.Decimal(12, 2)

  // Atingimento (%) que escolheu a faixa, guardado para a tela explicar o número.
  atingimento Decimal? @db.Decimal(7, 2)

  // prevista = calculada · paga = quitada com o agente · cancelada = venda
  // desfeita depois de já ter sido paga (mantida como rastro).
  status  String    @db.VarChar(12) @default("prevista")
  pagaEm  DateTime?
  pagaPor Int?

  observacoes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negotiation Negotiation     @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  rule        CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, competencia])
  @@index([competencia])
  @@index([status])
  @@map("bychat_commission_entries")
}

// ─── Tela Inicial (o que cada papel vê ao entrar) ────────────
//
// A Visão Geral deixa de ser a única porta de entrada: o admin monta telas
// como uma PILHA DE BLOCOS (aviso, KPIs, atalhos, meu dia, placar) e atribui
// cada uma a um papel — com exceção por usuário quando alguém precisa de algo
// diferente do resto do cargo. Sem atribuição, cai na Visão Geral de fábrica.
model HomeScreen {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)

  // [{ id, type: 'notice'|'kpis'|'shortcuts'|'my_day'|'leaderboard', config: {...} }]
  // Ordem do array = ordem na tela.
  blocks Json @db.Json

  active   Boolean @default(true)
  // Telas de fábrica não podem ser apagadas (só editadas/desatribuídas).
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments HomeScreenAssignment[]

  @@map("bychat_home_screens")
}

// Uma linha por destino. `role` preenchido = regra do cargo; `userId`
// preenchido = exceção que vence a regra do cargo daquele usuário.
model HomeScreenAssignment {
  id       Int       @id @default(autoincrement())
  screenId Int
  role     UserRole?
  userId   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screen HomeScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([role])
  @@unique([userId])
  @@index([screenId])
  @@map("bychat_home_screen_assignments")
}

// ── Mensagem agendada (Conversas) ──────────────────────────────────────────
// Uma mensagem que o operador deixa marcada para sair depois, numa conversa
// específica. Diferente do BroadcastCampaign (massa, template HSM) e do
// CadenceStepExecution (preso a uma cadência): aqui é 1 contato, 1 mensagem.
//
// A LINHA é a fonte da verdade — não o job do BullMQ. Um job com dias de atraso
// vive só no Redis: um flush apagaria o agendamento sem deixar rastro, e
// cancelar viraria caça ao jobId. Um tick de 60s varre `scheduledAt <= now`,
// no mesmo padrão do cadenceScheduler.
model ScheduledMessage {
  id     Int  @id @default(autoincrement())
  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Quando sair. Sempre em UTC; a UI converte para o fuso do operador.
  scheduledAt DateTime
  // pending | sent | canceled | failed | skipped
  status      String   @default("pending") @db.VarChar(16)

  // text = texto livre (Evolution, ou Cloud API com janela aberta)
  // template_hsm = modelo aprovado pela Meta (único que sai fora da janela)
  kind String @default("text") @db.VarChar(16)

  // Template interno (bychat_message_templates) que originou o texto. As
  // variáveis são resolvidas NO ENVIO, não aqui: se o nome ou a etapa do lead
  // mudarem no intervalo, a mensagem sai com o valor do dia do disparo.
  templateId Int?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Corpo já resolvido (fallback quando não há template, ou texto digitado).
  body       String?          @db.Text
  // Template HSM: { name, language, components } — formato de sendTemplate().
  hsmPayload Json?            @db.Json

  // Número de saída escolhido no seletor. Só uma dica: o canal é RESOLVIDO de
  // novo no disparo, porque o lock da conversa pode ter mudado no intervalo.
  channelId String? @db.VarChar(60)

  // Cancela sozinha se o contato responder antes da hora — evita o follow-up
  // constrangedor que chega depois de a pessoa já ter falado.
  cancelIfReplied Boolean @default(true)

  createdByUserId Int?
  createdBy       User? @relation("ScheduledMessageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  canceledByUserId Int?
  canceledBy       User? @relation("ScheduledMessageCanceler", fields: [canceledByUserId], references: [id], onDelete: SetNull)

  // Resultado do disparo.
  sentAt       DateTime?
  sentMessageId Int?     // Message.id gerado
  errorMessage String?   @db.Text
  attempts     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([leadId, status])
  @@index([createdByUserId])
  @@index([templateId])
  @@map("bychat_scheduled_messages")
}

// ── Importação de conversa do aparelho (Evolution/QR) ──────────────────────
// Uma linha por chat que o operador mandou sincronizar. O progresso mora aqui e
// não só na fila: importar 7 mil mensagens leva minutos, e o operador precisa
// saber onde parou mesmo que feche a tela ou o worker reinicie.
model ChatImportJob {
  id           Int    @id @default(autoincrement())
  instanceName String @db.VarChar(120)
  /// JID do chat na Evolution — pode ser @s.whatsapp.net ou @lid.
  remoteJid    String @db.VarChar(120)
  /// Telefone resolvido (em @lid vem de key.remoteJidAlt).
  telefone     String @db.VarChar(20)
  nome         String? @db.VarChar(191)

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // pending | running | done | failed | canceled
  status String @default("pending") @db.VarChar(16)

  totalNaOrigem   Int @default(0) // quantas a Evolution diz que existem
  importadas      Int @default(0) // criadas agora
  jaExistiam      Int @default(0) // puladas por já estarem no painel
  midiasPendentes Int @default(0) // mensagens de mídia sem arquivo baixado (fase 4)

  erro String? @db.Text

  createdByUserId Int?
  createdBy       User? @relation("ChatImportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([leadId])
  @@index([createdByUserId])
  /// Cruzar a lista do aparelho com o que já foi sincronizado, e achar job em aberto do chat.
  @@index([instanceName, remoteJid])
  @@map("bychat_chat_import_jobs")
}
