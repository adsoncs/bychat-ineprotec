}

// ── LIXEIRA (Trash / Recycle Bin) ─────────────

model TrashItem {
  id            Int       @id @default(autoincrement())
  entityType    String    @db.VarChar(50) // lead, funnel, chatbot, tag, template, form, page, workflow, user
  entityId      Int // ID original da entidade
  entityLabel   String    @db.VarChar(191) // Nome/título legível (empresa, nome, etc)
  snapshot      Json      @db.Json // Snapshot completo da entidade + relações
  deletedBy     Int? // userId de quem deletou
  deletedByName String?   @db.VarChar(191) // nome/email de quem deletou
  reason        String?   @db.VarChar(255) // motivo opcional da deleção
  expiresAt     DateTime // auto-purge após 90 dias
  restoredAt    DateTime? // preenchido se restaurado
  restoredBy    Int? // userId de quem restaurou
  createdAt     DateTime  @default(now())

  @@index([entityType])
  @@index([entityType, entityId])
  @@index([deletedBy])
  @@index([expiresAt])
  @@index([restoredAt])
  @@index([createdAt])
  @@map("bychat_trash")
}

// ── SECURITY ──────────────────────────────────

model SecurityEvent {
  id        Int      @id @default(autoincrement())
  ip        String   @db.VarChar(45)
  type      String   @db.VarChar(50) // login_fail, login_success, rate_limit, brute_force, suspicious_ua, path_traversal, sql_injection, xss_attempt, blocked_request
  severity  String   @db.VarChar(10) // low, medium, high, critical
  email     String?  @db.VarChar(191)
  userAgent String?  @db.VarChar(500)
  path      String?  @db.VarChar(500)
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@index([email])
  @@map("bychat_security_events")
}

model IpBlock {
  id        Int       @id @default(autoincrement())
  ip        String    @db.VarChar(45)
  reason    String    @db.VarChar(50) // brute_force, rate_limit, suspicious, manual, login_abuse
  details   String?   @db.Text
  auto      Boolean   @default(true)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdBy String?   @db.VarChar(191) // email do admin que bloqueou manualmente
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ip, active])
  @@index([active])
  @@index([expiresAt])
  @@map("bychat_ip_blocks")
}

// ── WORKFLOW ENGINE ──────────────────────────────

model Workflow {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(191)
  description   String?  @db.Text
  triggerEvent  String   @db.VarChar(100)
  triggerConfig Json?    @db.Json
  active        Boolean  @default(false)
  reentryPolicy String   @default("never") @db.VarChar(20)
  pauseOnReply  Boolean  @default(true)
  goalEvent     String?  @db.VarChar(100)
  goalConfig    Json?    @db.Json
  funnelId      Int?
  chatbotId     Int?
  priority      Int      @default(0)
  version       Int      @default(1)
  createdBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps      WorkflowStep[]
  executions WorkflowExecution[]

  @@index([active])
  @@index([triggerEvent])
  @@index([funnelId])
  @@map("bychat_workflows")
}

model WorkflowStep {
  id         Int      @id @default(autoincrement())
  workflowId Int
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type       String   @db.VarChar(30)
  name       String   @db.VarChar(191)
  config     Json     @db.Json
  position   Int      @default(0)
  positionX  Int      @default(0)
  positionY  Int      @default(0)
  nextStepId Int?
  altStepId  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stepExecutions WorkflowStepExecution[]

  @@index([workflowId, position])
  @@map("bychat_workflow_steps")
}

model WorkflowExecution {
  id            Int       @id @default(autoincrement())
  workflowId    Int
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  leadId        Int
  status        String    @default("running") @db.VarChar(20)
  currentStepId Int?
  triggerData   Json?     @db.Json
  pausedAt      DateTime?
  pauseReason   String?   @db.VarChar(50)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stepExecutions WorkflowStepExecution[]

  @@index([workflowId, status])
  @@index([leadId, status])
  @@index([status])
  @@index([currentStepId])
  @@map("bychat_workflow_executions")
}

model WorkflowStepExecution {
  id          Int               @id @default(autoincrement())
  executionId Int
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepId      Int
  step        WorkflowStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status      String            @default("pending") @db.VarChar(20)
  result      Json?             @db.Json
  error       String?           @db.Text
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  jobId       String?           @db.VarChar(191)
  createdAt   DateTime          @default(now())

  @@index([executionId, status])
  @@index([stepId])
  @@index([status, scheduledAt])
  @@index([jobId])
  @@map("bychat_workflow_step_executions")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(191)
  key         String    @unique @db.VarChar(191)
  prefix      String    @db.VarChar(10)
  permissions Json      @db.Json
  rateLimit   Int       @default(60)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  totalCalls  Int       @default(0)
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs ApiKeyLog[]

  @@index([key])
  @@index([active])
  @@map("bychat_api_keys")
}

model ApiKeyLog {
  id         Int      @id @default(autoincrement())
  apiKeyId   Int
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(500)
  statusCode Int
  duration   Int
  ip         String   @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@map("bychat_api_key_logs")
}

model OutboundWebhook {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(191)
  url         String    @db.VarChar(500)
  secret      String?   @db.VarChar(191)
  events      Json      @db.Json
  headers     Json?     @db.Json
  active      Boolean   @default(true)
  maxRetries  Int       @default(5)
  timeoutMs   Int       @default(30000)
  totalSent   Int       @default(0)
  totalFailed Int       @default(0)
