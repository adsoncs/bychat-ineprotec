  matriculaId        Int      @unique
  planoPagamentoId   Int?
  valorTotalCentavos Int
  descontoCentavos   Int      @default(0)
  bolsaId            Int?
  asaasCustomerId    String?  @db.VarChar(191)
  status             AcaContratoStatus @default(ATIVO)
  aceiteEm           DateTime?
  aceiteIp           String?  @db.VarChar(60)
  aceiteNome         String?  @db.VarChar(191)
  aceiteTermo        String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  matricula          AcaMatricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  parcelas           AcaParcela[]
  @@map("bychat_aca_contratos")
}

model AcaParcela {
  id                 Int      @id @default(autoincrement())
  contratoId         Int
  nroParcela         Int
  tipo               AcaParcelaTipo @default(MENSALIDADE)
  valorBrutoCentavos Int
  valorPagoCentavos  Int      @default(0)
  dataVencimento     DateTime
  situacao           AcaParcelaSituacao @default(ABERTA)
  pagoEm             DateTime?
  asaasChargeId      String?  @db.VarChar(191)
  linhaDigitavel     String?  @db.Text
  pixCopiaCola       String?  @db.Text
  acordoId           Int?
  remessaId          Int?     // F9 — remessa CNAB em que o título foi incluído
  nossoNumero        String?  @db.VarChar(30) // F9 — nosso número do boleto registrado
  contaFinanceiraId  Int?     // F9 — classificação no plano de contas
  cdaId              Int?     // F10 — Certidão de Dívida Ativa em que foi inscrita
