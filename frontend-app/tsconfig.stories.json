{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.stories.tsbuildinfo"
  },
  "include": ["src/**/*.stories.tsx", "tests/**/*.ts", ".ladle/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
